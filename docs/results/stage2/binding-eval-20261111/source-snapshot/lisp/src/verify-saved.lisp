;;;; Independent saved-result verification. Deliberately does not load any evaluator,
;;;; model, training, qa-analysis, wording, or binding code. JSON/SHA primitives only.
(defpackage :asem-verify-saved
  (:use :cl)
  (:export #:verify-phase2 #:paired-records #:paired-binary #:read-json #:g #:obj
           #:verify-binding #:verify-fixtures #:write-new-json #:run-self-checks))
(in-package :asem-verify-saved)
(defun g (x key) (asem-json:json-get x key))
(defun obj (&rest kvs) (cons :obj (loop for (k v) on kvs by #'cddr collect (cons k v))))
(defun read-json (path)
  (with-open-file (s path :external-format :utf-8)
    (let ((buf (make-string (file-length s))))
      (asem-json:parse-json (subseq buf 0 (read-sequence buf s))))))
(defun write-new-json (path value)
  (with-open-file (s path :direction :output :if-exists :error :if-does-not-exist :create :external-format :utf-8)
    (asem-json:write-json value s) (terpri s)))
(defun exact-p (gained lost)
  ;; Integer recurrence, independent of the evaluator's combinatorial routines.
  (let* ((n (+ gained lost)) (m (min gained lost)) (term 1) (total 1))
    (loop for k from 1 to m do (setf term (/ (* term (- n k -1)) k)) (incf total term))
    (coerce (min 1 (/ (* 2 total) (expt 2 n))) 'double-float)))
(defun paired-binary (a b)
  (unless (and a (= (length a) (length b))) (error "Nonempty equal-length paired outcomes required"))
  (unless (every (lambda (x) (or (eq x t) (null x))) (append a b)) (error "Binary outcomes required"))
  (let* ((n (length a)) (gained 0) (lost 0) (k0 (count t a)) (k1 (count t b)))
    (loop for x in a for y in b do (cond ((and (not x) y) (incf gained)) ((and x (not y)) (incf lost))))
    (let* ((delta (/ (- gained lost) n 1d0))
           (se (if (> n 1) (sqrt (max 0d0 (/ (- (+ gained lost) (* n delta delta)) (* n (1- n))))) :null)))
      (obj "n" n "first_correct" k0 "second_correct" k1 "gained" gained "lost" lost "diff" delta
           "mcnemar_exact_two_sided_p" (exact-p gained lost) "unbiased_se" se))))
(defun row-hit (r field)
  (if (search "_exact" field)
      (let ((v (g r field)))
        (unless (member v '(:true :false)) (error "JSON boolean required for ~a" field))
        (eq v :true))
      (let ((p (g r field)) (key (g r "key")))
        (unless (and (integerp p) (<= 0 p 3) (integerp key) (<= 0 key 3)) (error "Invalid option index"))
        (= p key))))
(defun paired-records (a b field)
  (unless (= (length a) (length b)) (error "Pair length mismatch"))
  (loop for x in a for y in b do
    (dolist (k '("id" "category" "subtype" "key" "gold_text" "question"))
      (unless (equal (g x k) (g y k)) (error "Paired identity mismatch: ~a/~a" (g x "id") k))))
  (paired-binary (mapcar (lambda (r) (row-hit r field)) a) (mapcar (lambda (r) (row-hit r field)) b)))
(defparameter *metrics*
  '(("summed_option_likelihood" . "summed_option_prediction")
    ("mean_token_option_likelihood" . "mean_token_option_prediction")
    ("letter_A_to_D" . "letter_prediction")
    ("gold_length_greedy_prefix_exact" . "gold_length_greedy_prefix_exact")
    ("bounded_free_generation_exact" . "bounded_free_generation_exact")
    ("bounded_free_generation_terminated_exact" . "bounded_free_generation_terminated_exact")))
(defun check-reference (got expected)
  (dolist (k '("n" "first_correct" "second_correct" "gained" "lost"))
    (unless (eql (g got k) (g expected k)) (error "Saved comparison disagrees: ~a" k)))
  (dolist (k '("diff" "mcnemar_exact_two_sided_p"))
    (unless (< (abs (- (g got k) (g expected k))) 1d-10) (error "Saved comparison disagrees: ~a" k))))
(defparameter *phase2-hashes*
  '(("lisp/src/retrieval.lisp" . "8e47f3b1f2280f10f6e9416349f85f0e255f6d3a063571022521f3d6b717c0b6")
    ("lisp/src/bpe.lisp" . "25523805c53ef53d36ed71625a41140c3a5ee3246bbc96555a48997b0cfbb65f")
    ("data/runs/retrieval/r7-L123-aug-opts-rev-rsn/last.ckpt" . "33a5c24521dfb1b28b456b8344bfd0869b84fe56aa622191b8f6bfa71cc42aa1")
    ("data/runs/retrieval/p2-paraphrase-pilot/control-data.sexp" . "5a16eba9aacca54062490f5c9d81afc14124b8828b92af3d27f671a4a2f658d2")
    ("data/runs/retrieval/p2-paraphrase-pilot/treatment-data.sexp" . "addd345a8a2d32195794c5d8adf27a7c28b4dad78c70d15ebd9708108bf6138a")
    ("data/runs/retrieval/p2-paraphrase-pilot/selection-data.sexp" . "c2bd5691c3b52c2d1ccbb31b7d09abfc1f385064633b612d2b513044a8fefb8b")
    ("data/runs/retrieval/p2-paraphrase-pilot/control/last.ckpt" . "435b5d7c2eb1d8afecd67e0c9eb86709aecb966b60fbe76bbc40aee5ae959a84")
    ("data/runs/retrieval/p2-paraphrase-pilot/treatment/last.ckpt" . "bce9f94765e4503bedf2674a40e066c13780709425441e9c7a7de2d7e9d8833c")))
(defun verify-phase2 ()
  (let ((base "docs/results/stage2/phase2-paraphrase-pilot/") (datasets nil) (count 0))
    (dolist (dataset '("qa-dev" "l3-new" "selection"))
      (let* ((a (read-json (format nil "~awording-2x2-~a-control-step300.json" base dataset)))
             (b (read-json (format nil "~awording-2x2-~a-treatment-step300.json" base dataset)))
             (ref (read-json (format nil "~acompare-~a-control-vs-treatment-step300.json" base dataset))) (cells nil))
        (dolist (kind '("cells" "counterfactual_cells"))
          (dolist (cell '("p-fam/q-fam" "p-fam/q-unf" "p-unf/q-fam" "p-unf/q-unf"))
            (let* ((ra (coerce (g (g (g (g a "policies") "seeded") kind) cell) 'list))
                   (aa (coerce (g ra "items") 'list))
                   (bb (coerce (g (g (g (g (g b "policies") "seeded") kind) cell) "items") 'list))
                   (reference (g (g (g ref kind) cell) "paired_second_minus_first")) (metrics nil))
              (dolist (metric *metrics*)
                (let ((groups nil) (r (g reference (car metric))))
                  (dolist (category '("all" "compare" "extract" "relation" "reverse" "temporal"))
                    (let* ((all (equal category "all"))
                           (x (if all aa (remove-if-not (lambda (z) (equal (g z "category") category)) aa)))
                           (y (if all bb (remove-if-not (lambda (z) (equal (g z "category") category)) bb)))
                           (result (paired-records x y (cdr metric))))
                      (check-reference result (if all r (g (g r "by_category") category)))
                      (incf count) (push (cons category result) groups)))
                  (push (cons (car metric) (cons :obj (nreverse groups))) metrics)))
              (push (cons (format nil "~a:~a" kind cell) (cons :obj (nreverse metrics))) cells))))
        (push (cons dataset (cons :obj (nreverse cells))) datasets)))
    (let ((locations nil))
      (dolist (entry *phase2-hashes*)
        (let ((actual (if (and (equal (car entry) "lisp/src/retrieval.lisp")
                               (probe-file "lisp/experimental/phase2/historical/retrieval.lisp"))
                         "lisp/experimental/phase2/historical/retrieval.lisp" (car entry))))
          (unless (equal (asem-sha256:sha256-file-hex actual) (cdr entry)) (error "Provenance mismatch: ~a" actual))
          (push (cons (car entry) actual) locations)))
      (unless (= count 864) (error "Expected 864 comparisons"))
      (obj "scope" "saved Phase 2 predictions and explicit provenance paths only" "locked_test_accessed" :false
           "comparisons_checked" count "datasets" (cons :obj (nreverse datasets))
           "verified_sha256" (cons :obj *phase2-hashes*) "historical_source_locations" (cons :obj (nreverse locations))))))

(defun run-self-checks ()
  (assert (= 1d0 (exact-p 0 0)))
  (assert (= (/ 2d0 32768) (exact-p 0 15)))
  (let ((r (paired-binary '(t t nil nil) '(t nil t nil))))
    (assert (= 1 (g r "gained"))) (assert (= 1 (g r "lost"))) (assert (= 0d0 (g r "diff"))))
  t)

(defun verify-fixtures (path)
  (let ((cases (g (read-json path) "cases")) (results nil))
    (loop for c across cases do
      (let* ((rejected nil) (result nil)
             (failure (handler-case
                          (progn (setf result (paired-records (coerce (g c "a") 'list) (coerce (g c "b") 'list) (g c "field")))
                                 (check-reference result (g c "expected")) nil)
                        (error (e) (setf rejected t) (princ-to-string e)))))
        (unless (eq rejected (eq (g c "reject") :true)) (error "Fixture verdict mismatch: ~a: ~a" (g c "name") failure))
        (push (obj "name" (g c "name") "rejected" (if rejected :true :false) "passed" :true) results)))
    (obj "cases" (coerce (nreverse results) 'vector) "passed" (length cases))))

;;; Binding verifier: independent finite grammar, solver, score argmax and joint outcomes.
(defun vlist (x) (coerce x 'list))
(defun require-equal (a b label) (unless (equalp a b) (error "Verification failed: ~a" label)))
(defun safe-data (text)
  (let ((*read-eval* nil) (*package* (find-package :keyword)))
    (multiple-value-bind (x end) (read-from-string text)
      (unless (every (lambda (c) (find c '(#\Space #\Tab #\Return #\Newline))) (subseq text end)) (error "Trailing metadata"))
      (labels ((valid (v) (or (null v) (stringp v) (integerp v) (keywordp v) (and (consp v) (valid (car v)) (valid (cdr v))))))
        (unless (valid x) (error "Invalid metadata"))) x)))
(defun substitute-slots (frame bindings)
  (let* ((s (with-output-to-string (out)
              (loop with pos = 0 while (< pos (length frame)) do
                (let ((open (position #\{ frame :start pos)))
                  (if open
                      (let* ((end (or (position #\} frame :start open) (error "Invalid frame")))
                             (slot (subseq frame (1+ open) end)) (value (assoc slot bindings :test #'equal)))
                        (unless value (error "Missing grammar slot: ~a" slot))
                        (write-string frame out :start pos :end open) (princ (cdr value) out) (setf pos (1+ end)))
                      (progn (write-string frame out :start pos) (setf pos (length frame)))))))))
    (when (plusp (length s)) (setf (char s 0) (char-upcase (char s 0)))) s))
(defun unique-match (matches text)
  (unless (= 1 (length matches)) (error "Ambiguous/unrecognized rendered text: ~a" text)) (first matches))
(defun parse-saved-world (family w)
  (let* ((cat (g w "category")) (people (vlist (g w "people"))) (vals (vlist (g w "values")))
         (frames (vlist (g family "passage_frames"))) (sentences (vlist (g w "sentences"))) (records nil))
    (require-equal cat (g family "category") "family category")
    (require-equal (format nil "~{~a~^ ~}" sentences) (g w "passage") "rendered passage")
    (unless (= (length people) (length (remove-duplicates people :test #'equal))) (error "Repeated entity inventory"))
    (unless (if (equal cat "relation") (= 4 (length people)) (if (equal cat "temporal") (= 1 (length people)) (= 4 (length people) (length vals)))) (error "Inventory size"))
    (unless (= (length sentences) (if (equal cat "relation") 3 4)) (error "Sentence count"))
    (loop for s in sentences for i from 0 for frame = (nth (if (equal cat "temporal") i 0) frames) do
      (let ((hits nil))
        (cond ((equal cat "relation")
               (dolist (a people) (dolist (b people)
                 (when (and (not (equal a b)) (equal s (substitute-slots frame (list (cons "A" a) (cons "B" b))))) (push (list a b) hits)))))
              ((equal cat "temporal")
               (dolist (x vals) (when (equal s (substitute-slots frame (list (cons "P" (first people)) (cons "X" x)))) (push x hits))))
              (t (dolist (p people) (dolist (v vals)
                   (when (equal s (substitute-slots frame (list (cons "P" p) (cons "V" v) (cons "N" v)))) (push (list p v) hits))))))
        (push (unique-match hits s) records)))
    (setf records (nreverse records))
    (let ((queries nil))
      (dolist (qf (cdr (g family "question_frames")))
        (dolist (arg (cond ((member (car qf) '("rel-subj" "rel-obj" "extract") :test #'equal) people)
                          ((member (car qf) '("reverse" "before" "after") :test #'equal) vals) (t '(nil))))
          (let ((bindings (list (cons "A" arg) (cons "B" arg) (cons "P" (if (equal cat "temporal") (first people) arg)) (cons "V" arg) (cons "X" arg))))
            (when (equal (g w "question") (substitute-slots (cdr qf) bindings)) (push (list (car qf) arg) queries)))))
      (let* ((query (unique-match queries (g w "question")))
             (kw (intern (string-upcase (first query)) :keyword))
             (facts (cond ((equal cat "relation") (list :people people :pairs records))
                          ((equal cat "temporal") (list :person (first people) :order records))
                          (t (list :people (mapcar #'first records) (if (equal cat "compare") :numbers :values) (mapcar #'second records))))))
        (require-equal facts (safe-data (g w "facts")) "stored vs parsed facts")
        (require-equal (if (second query) (list kw (second query)) (list kw)) (safe-data (g w "query")) "stored vs parsed query")
        (values records query people vals)))))
(defun resolve-answer (category records query)
  (let ((op (first query)) (arg (second query)))
    (cond ((equal category "relation")
           (let ((answers (loop for (agent patient) in records
                                when (equal arg (if (equal op "rel-subj") patient agent))
                                  collect (if (equal op "rel-subj") agent patient))))
             (unless (= 1 (length answers)) (error "Nonunique relationship answer")) (first answers)))
          ((equal category "extract") (second (assoc arg records :test #'equal)))
          ((equal category "reverse") (first (find arg records :key #'second :test #'equal)))
          ((equal category "compare")
           (let* ((ns (mapcar #'second records)) (best (reduce (if (equal op "max") #'max #'min) ns)))
             (unless (= 4 (length (remove-duplicates ns))) (error "Comparison values must differ"))
             (first (find best records :key #'second))))
          ((equal category "temporal")
           (let ((i (position arg records :test #'equal)))
             (cond ((equal op "first") (first records)) ((equal op "last") (car (last records)))
                   ((equal op "after") (and i (< i 3) (nth (1+ i) records)))
                   ((equal op "before") (and i (> i 0) (nth (1- i) records))))))
          (t (error "Unknown category")))))
(defun lexical-bag (text)
  (let ((out nil) (buffer (make-string-output-stream)))
    (labels ((flush () (let ((word (get-output-stream-string buffer))) (unless (equal word "") (push word out)))))
      (loop for c across (string-downcase text) do (if (alphanumericp c) (write-char c buffer) (flush))) (flush))
    (sort out #'string<)))
(defun check-chain (edges people)
  (unless (and (= 3 (length edges)) (= 1 (count-if (lambda (p) (not (find p edges :key #'second :test #'equal))) people))
               (= 1 (count-if (lambda (p) (not (assoc p edges :test #'equal))) people))) (error "Not a directed chain"))
  (let ((current (find-if (lambda (p) (not (find p edges :key #'second :test #'equal))) people)) (visited nil))
    (dotimes (i 4)
      (when (or (null current) (member current visited :test #'equal)) (error "Disconnected/cyclic chain"))
      (push current visited) (setf current (second (assoc current edges :test #'equal))))
    (when current (error "Chain exceeds inventory"))))
(defun validate-counterfactual (pair family)
  (let* ((ws (vlist (g pair "worlds"))) (a (first ws)) (b (second ws)) (cat (g pair "category")))
    (unless (= 2 (length ws)) (error "Exactly two worlds required"))
    (dolist (key '("category" "question" "options")) (require-equal (g a key) (g b key) key))
    (require-equal cat (g a "category") "pair category")
    (require-equal (lexical-bag (g a "passage")) (lexical-bag (g b "passage")) "lexical inventory")
    (let ((options (vlist (g a "options"))))
      (unless (= 4 (length options) (length (remove-duplicates options :test #'equal))) (error "Options must differ")))
    (multiple-value-bind (ra qa pa va) (parse-saved-world family a)
      (multiple-value-bind (rb qb pb vb) (parse-saved-world family b)
        (require-equal qa qb "fixed query") (require-equal pa pb "person inventory")
        (cond ((equal cat "relation")
               (check-chain ra pa) (check-chain rb pb)
               (require-equal (mapcar #'reverse ra) rb "edge reversal"))
              ((equal cat "temporal")
               (require-equal (sort (copy-list ra) #'string<) (sort (copy-list rb) #'string<) "place inventory")
               (unless (= 2 (count nil (mapcar #'equal ra rb))) (error "Exactly two locations must swap"))
               (when (second qa) (require-equal (position (second qa) ra :test #'equal) (position (second qa) rb :test #'equal) "query anchor")))
              (t (require-equal (mapcar #'first ra) (mapcar #'first rb) "fixed subject positions")
                 (unless (= 2 (count nil (mapcar #'equal ra rb))) (error "Exactly two values must swap"))
                 (require-equal (sort (mapcar #'princ-to-string va) #'string<) (sort (mapcar #'princ-to-string vb) #'string<) "value inventory")))
        (loop for w in ws for records in (list ra rb) do
          (let* ((key (g w "key")) (answer (resolve-answer cat records qa)) (ids (g w "prompt_token_ids"))
                 (tails (g w "option_token_ids")))
            (unless (and (integerp key) (<= 0 key 3) (= 4 (length tails)) (every (lambda (x) (plusp (length x))) tails)
                         (equal answer (aref (g w "options") key))) (error "Independent answer/key mismatch"))
            (unless (and (= 0 (aref ids 0)) (<= (+ (length ids) (reduce #'max tails :key #'length) -1) 128)) (error "Context budget"))))
        (when (= (g a "key") (g b "key")) (error "Answer must change"))
        (unless (= (length (g a "prompt_token_ids")) (length (g b "prompt_token_ids"))) (error "Matched prompt lengths"))
        (unless (= (length (aref (g a "option_token_ids") (g a "key"))) (length (aref (g b "option_token_ids") (g b "key")))) (error "Matched answer lengths"))
        t))))
(defun maximum-index (xs)
  (unless (= 4 (length xs)) (error "Four scores required"))
  (let ((best 0))
    (dotimes (i 4) (unless (and (realp (elt xs i)) (= (elt xs i) (elt xs i)) (< (abs (elt xs i)) 1d30)) (error "Invalid score"))
      (when (> (elt xs i) (elt xs best)) (setf best i))) best))
(defun validate-prediction (r w)
  (dolist (key '("id" "category" "subtype" "question" "key")) (require-equal (g r key) (g w key) key))
  (let* ((key (g w "key")) (tails (g w "option_token_ids")) (scores (g r "summed_option_logprob"))
         (lengths (map 'vector #'length tails)) (means (map 'vector #'/ scores lengths))
         (gold (aref tails key)) (generated (g r "generated_token_ids")) (prefix (equalp generated gold)))
    (require-equal (g r "gold_text") (aref (g w "options") key) "gold text")
    (require-equal (g r "option_token_lengths") lengths "option lengths")
    (require-equal (g r "summed_option_prediction") (maximum-index scores) "sum argmax")
    (require-equal (g r "mean_token_option_prediction") (maximum-index means) "mean argmax")
    (loop for x across means for y across (g r "mean_token_option_logprob") do
      (unless (< (abs (- x y)) 1d-8) (error "Mean score mismatch")))
    (require-equal (g r "gold_length_greedy_prefix_exact") (if prefix :true :false) "prefix exact")
    (require-equal (g r "prompt_tokens_without_eot") (1- (length (g w "prompt_token_ids"))) "prompt length")
    (let* ((text (g r "bounded_generated_text")) (exact (equal text (g r "gold_text")))
           (terminated (and exact (member (g r "generation_termination_reason") '("eot" "period_or_newline") :test #'equal))))
      (require-equal (g r "bounded_free_generation_exact") (if exact :true :false) "bounded exact")
      (require-equal (g r "bounded_free_generation_terminated_exact") (if terminated :true :false) "terminated exact"))
    t))

(defun joint-outcome (rows metric)
  (every (lambda (r) (row-hit r metric)) rows))
(defun fraction (k n) (/ k (max 1 n) 1d0))
(defun summarize-binding (pairs rows)
  (let ((index (make-hash-table :test 'equal)) (groups nil))
    (dolist (r rows) (when (gethash (g r "id") index) (error "Duplicate prediction ID")) (setf (gethash (g r "id") index) r))
    (dolist (category '("all" "relation" "extract" "reverse" "compare" "temporal"))
      (let* ((ps (if (equal category "all") pairs (remove-if-not (lambda (p) (equal category (g p "category"))) pairs)))
             (n (length ps)) (prefix 0) (sum 0) (mean 0) (switches 0) (wrong-role 0) (margin 0d0) (metrics nil))
        (dolist (p ps)
          (let* ((ws (vlist (g p "worlds"))) (rs (mapcar (lambda (w) (or (gethash (g w "id") index) (error "Missing prediction"))) ws))
                 (a (first rs)) (b (second rs)) (ka (g a "key")) (kb (g b "key")))
            (when (joint-outcome rs "gold_length_greedy_prefix_exact") (incf prefix))
            (when (joint-outcome rs "summed_option_prediction") (incf sum))
            (when (joint-outcome rs "mean_token_option_prediction") (incf mean))
            (unless (= (g a "summed_option_prediction") (g b "summed_option_prediction")) (incf switches))
            (when (equal (g p "category") "relation")
              (when (= (g a "summed_option_prediction") kb) (incf wrong-role))
              (when (= (g b "summed_option_prediction") ka) (incf wrong-role)))
            (incf margin (* 0.5d0 (+ (- (aref (g a "summed_option_logprob") ka) (aref (g a "summed_option_logprob") kb))
                                     (- (aref (g b "summed_option_logprob") kb) (aref (g b "summed_option_logprob") ka)))))))
        (dolist (m *metrics*)
          (let ((hits (list 0 0)) (joint 0))
            (dolist (p ps)
              (let ((rs (mapcar (lambda (w) (gethash (g w "id") index)) (vlist (g p "worlds")))))
                (loop for r in rs for i from 0 when (row-hit r (cdr m)) do (incf (nth i hits)))
                (when (joint-outcome rs (cdr m)) (incf joint))))
            (push (cons (car m) (obj "world0_correct" (first hits) "world1_correct" (second hits) "joint_correct" joint
                                          "world0_accuracy" (fraction (first hits) n) "world1_accuracy" (fraction (second hits) n) "joint_accuracy" (fraction joint n))) metrics)))
        (push (cons category (obj "pairs" n "joint_prefix_correct" prefix "joint_prefix_accuracy" (fraction prefix n)
                                  "joint_sum_correct" sum "joint_sum_accuracy" (fraction sum n) "joint_mean_correct" mean "joint_mean_accuracy" (fraction mean n)
                                  "answer_changed_count" switches "correct_switch_count" sum
                                  "wrong_role_choices" wrong-role "mean_binding_margin_nats" (/ margin (max 1 n)) "metrics" (cons :obj (nreverse metrics)))) groups)))
    (let* ((cats (remove "all" groups :key #'car :test #'equal))
           (macros (obj "joint_prefix_accuracy" (/ (reduce #'+ cats :key (lambda (x) (g (cdr x) "joint_prefix_accuracy"))) 5d0)
                        "joint_sum_accuracy" (/ (reduce #'+ cats :key (lambda (x) (g (cdr x) "joint_sum_accuracy"))) 5d0))))
      (obj "by_category" (cons :obj (nreverse groups)) "macro" macros))))

(defun check-evaluator-summary (rows summary)
  (dolist (m *metrics*)
    (dolist (category '("all" "relation" "extract" "reverse" "compare" "temporal"))
      (let* ((rs (if (equal category "all") rows (remove-if-not (lambda (r) (equal (g r "category") category)) rows)))
             (n (length rs)) (k (count-if (lambda (r) (row-hit r (cdr m))) rs))
             (metric (g summary (car m))) (reported (if (equal category "all") metric (g (g metric "by_category") category))))
        (require-equal n (g reported "n") "evaluator summary count")
        (require-equal k (g reported "correct") "evaluator summary correct")
        (unless (< (abs (- (fraction k n) (g reported "accuracy"))) 1d-10) (error "Evaluator accuracy mismatch")))))
  t)

(defun binomial-tail (n k p)
  ;; P[X >= k], evaluated directly; used only to invert conservative binomial bounds.
  (cond ((<= k 0) 1d0) ((> k n) 0d0) ((<= p 0) 0d0) ((>= p 1) 1d0)
        ((>= p .5d0)
         (let ((term (expt p n)) (sum 0d0))
           (loop for i from n downto k do (incf sum term)
                 unless (= i k) do (setf term (* term (/ i (1+ (- n i))) (/ (- 1d0 p) p))))
           (min 1d0 sum)))
        (t (let ((term (expt (- 1d0 p) n)) (sum 0d0))
             (dotimes (i (1+ n) (min 1d0 sum))
               (when (>= i k) (incf sum term))
               (unless (= i n) (setf term (* term (/ (- n i) (1+ i)) (/ p (- 1d0 p))))))))))
(defun binomial-lower (k n alpha)
  (if (zerop k) 0d0
      (loop with lo = 0d0 with hi = 1d0 repeat 70 for mid = (* .5d0 (+ lo hi))
            do (if (> (binomial-tail n k mid) alpha) (setf hi mid) (setf lo mid)) finally (return (* .5d0 (+ lo hi))))))
(defun paired-lower-bound (gained lost n)
  ;; Two simultaneous one-sided 97.5% CP bounds, union-bound coverage >=95%.
  ;; Valid even at zero discordance; unlike a zero-width empirical bootstrap CI.
  (- (binomial-lower gained n .025d0) (- 1d0 (binomial-lower (- n lost) n .025d0))))
(defun percentile (sorted p) (aref sorted (min (1- (length sorted)) (floor (* p (1- (length sorted)))))))
(defun family-bootstrap (values families)
  (let ((h (make-hash-table :test 'equal)) (rng (sb-ext:seed-random-state 11011)))
    (loop for v in values for f in families do (push v (gethash f h)))
    (let* ((keys (sort (loop for k being the hash-keys of h collect k) #'string<))
           (averages (coerce (mapcar (lambda (k) (/ (reduce #'+ (gethash k h)) (length (gethash k h)) 1d0)) keys) 'vector))
           (k (length keys)) (draws (make-array 10000 :element-type 'double-float)))
      (dotimes (i 10000) (setf (aref draws i) (/ (loop repeat k sum (aref averages (random k rng))) k)))
      (sort draws #'<)
      (obj "families" k "resamples" 10000 "seed" 11011 "ci95_low" (percentile draws .025d0) "ci95_high" (percentile draws .975d0)
           "one_sided95_low" (percentile draws .05d0)))))
(defun checkpoint-contrast (pairs first-rows second-rows field)
  (let ((a (make-hash-table :test 'equal)) (b (make-hash-table :test 'equal)) (ha nil) (hb nil) (families nil))
    (dolist (r first-rows) (setf (gethash (g r "id") a) r))
    (dolist (r second-rows) (setf (gethash (g r "id") b) r))
    (dolist (p pairs)
      (flet ((outcome (index) (joint-outcome (mapcar (lambda (w) (or (gethash (g w "id") index) (error "Missing checkpoint row"))) (vlist (g p "worlds"))) field)))
        (push (outcome a) ha) (push (outcome b) hb) (push (g p "family") families)))
    (let* ((r (paired-binary ha hb)) (se (g r "unbiased_se"))
           (boot (family-bootstrap (mapcar (lambda (x y) (- (if y 1d0 0d0) (if x 1d0 0d0))) ha hb) families)))
      (append r (list (cons "ci95_low" (max -1d0 (- (g r "diff") (* 1.96d0 se))))
                      (cons "ci95_high" (min 1d0 (+ (g r "diff") (* 1.96d0 se))))
                      (cons "conservative_one_sided95_low" (paired-lower-bound (g r "gained") (g r "lost") (g r "n")))
                      (cons "family_bootstrap" boot))))))

(defun verify-binding (bundle)
  (let* ((root (string-right-trim "/" bundle)) (manifest-path (format nil "~a/manifest.json" root))
         (manifest (read-json manifest-path)) (pairs (vlist (read-json (format nil "~a/pairs.json" root))))
         (families (vlist (read-json (format nil "~a/families.json" root)))) (rows nil) (summaries nil) (contrasts nil) (result-hashes nil))
    (require-equal (g manifest "schema") "asem-binding-bundle-1" "bundle schema")
    (unless (= 400 (length pairs)) (error "Exactly 400 pairs required"))
    (dolist (entry (cdr (g manifest "files_sha256")))
      (unless (member (car entry) '("pairs.json" "pairs.sexp" "families.json" "protocol.json") :test #'equal) (error "Unexpected bundle file"))
      (require-equal (asem-sha256:sha256-file-hex (format nil "~a/~a" root (car entry))) (cdr entry) "fixture hash"))
    (dolist (entry (cdr (g manifest "sources_sha256")))
      (unless (member (car entry) '("lisp/bin/binding-eval.lisp" "lisp/src/binding.lisp" "lisp/experimental/phase2/frames.lisp"
                                   "lisp/src/qa-analysis.lisp" "lisp/src/retrieval.lisp" "lisp/src/qagen.lisp" "lisp/src/bpe.lisp"
                                   "lisp/src/tf.lisp" "lisp/src/tf32.lisp" "lisp/src/sft.lisp" "lisp/src/sft32.lisp" "lisp/src/derive.lisp"
                                   "lisp/src/verify-saved.lisp" "lisp/bin/verify-saved.lisp") :test #'equal) (error "Unexpected source path"))
      (require-equal (asem-sha256:sha256-file-hex (car entry)) (cdr entry) "source freeze"))
    (let ((seen (make-hash-table :test 'equal)))
      (dolist (p pairs)
        (when (gethash (g p "id") seen) (error "Duplicate graph ID")) (setf (gethash (g p "id") seen) t)
        (validate-counterfactual p (or (find (g p "family") families :key (lambda (f) (g f "id")) :test #'equal) (error "Unknown family")))))
    (dolist (label '("r7" "control" "treatment"))
      (let* ((result (read-json (format nil "~a/~a.json" root label)))
             (rs (vlist (g (g (g result "conditions") "real") "items")))
             (worlds (loop for p in pairs append (vlist (g p "worlds"))))
             (spec (g (g manifest "models") label)))
        (let* ((expected-path (if (equal label "r7") "data/runs/retrieval/r7-L123-aug-opts-rev-rsn/last.ckpt"
                                 (format nil "data/runs/retrieval/p2-paraphrase-pilot/~a/last.ckpt" label)))
               (expected-hash (cdr (assoc expected-path *phase2-hashes* :test #'equal))))
          (require-equal (g spec "path") expected-path "permitted checkpoint")
          (require-equal (g spec "sha256") expected-hash "fixed checkpoint identity"))
        (require-equal (g result "schema") "asem-binding-result-1" "result schema")
        (require-equal (g result "label") label "model label")
        (require-equal (g result "bundle_manifest_sha256") (asem-sha256:sha256-file-hex manifest-path) "result fixture identity")
        (require-equal (g result "checkpoint_sha256") (g spec "sha256") "checkpoint provenance")
        (require-equal (asem-sha256:sha256-file-hex (g spec "path")) (g spec "sha256") "checkpoint unchanged")
        (unless (= 800 (length rs)) (error "Exactly 800 predictions required"))
        (loop for r in rs for w in worlds do (validate-prediction r w))
        (check-evaluator-summary rs (g (g (g result "conditions") "real") "summary"))
        (push (cons label (asem-sha256:sha256-file-hex (format nil "~a/~a.json" root label))) result-hashes)
        (push (cons label rs) rows) (push (cons label (summarize-binding pairs rs)) summaries)))
    (dolist (models '(("control" "treatment") ("r7" "control") ("r7" "treatment")))
      (let ((categories nil))
        (dolist (category '("relation" "extract" "reverse" "compare" "temporal"))
          (let ((ps (remove-if-not (lambda (p) (equal (g p "category") category)) pairs)) (metrics nil))
            (dolist (field '("gold_length_greedy_prefix_exact" "summed_option_prediction" "mean_token_option_prediction"))
              (push (cons field (checkpoint-contrast ps (cdr (assoc (first models) rows :test #'equal)) (cdr (assoc (second models) rows :test #'equal)) field)) metrics))
            (push (cons category (cons :obj (nreverse metrics))) categories)))
        (push (cons (format nil "~a_to_~a" (first models) (second models)) (cons :obj (nreverse categories))) contrasts)))
    (let* ((primary (g (g (cdr (assoc "control_to_treatment" contrasts :test #'equal)) "relation") "gold_length_greedy_prefix_exact"))
           (bootstrap (g primary "family_bootstrap"))
           (decision (cond ((and (<= (g primary "diff") -.10d0) (< (g primary "mcnemar_exact_two_sided_p") .05d0)
                                 (< (g primary "ci95_high") 0) (< (g bootstrap "ci95_high") 0)) "material_deficit_supported")
                           ((and (> (g primary "conservative_one_sided95_low") -.10d0) (> (g bootstrap "one_sided95_low") -.10d0)) "material_deficit_excluded_on_this_population")
                           (t "inconclusive"))))
      (obj "schema" "asem-binding-verification-1" "pair_count" 400 "counterfactuals_validated" 400 "predictions_validated" 2400
           "locked_test_accessed" :false "training_updates" 0 "reference" "r7" "promotion" "none"
           "summaries" (cons :obj (nreverse summaries)) "contrasts" (cons :obj (nreverse contrasts))
           "manifest_sha256" (asem-sha256:sha256-file-hex manifest-path) "result_sha256" (cons :obj (nreverse result-hashes))
           "primary" primary "decision" decision
           "verification_note" "Independent grammar, solver, argmax, accuracy, answer switching and statistics. Model forward passes are not recomputed. Template meanings remain human-authored assumptions."))))
