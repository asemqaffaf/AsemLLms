;;;; Minimal JSON: parse a value from a string, write with sorted keys and 2-space indent.
;;;; Objects are (:obj (key . value) ...), arrays are simple-vectors, literals :true :false :null.
(defpackage :asem-json
  (:use :cl)
  (:export #:parse-json #:write-json #:json-get))
(in-package :asem-json)

(define-condition json-error (error) ((msg :initarg :msg :reader msg))
  (:report (lambda (c s) (format s "JSON error: ~a" (msg c)))))
(defun fail (fmt &rest args) (error 'json-error :msg (apply #'format nil fmt args)))

(defun parse-json (string)
  (let ((i 0) (n (length string)))
    (labels ((peek () (if (< i n) (char string i) nil))
             (skip-ws () (loop while (and (< i n) (member (char string i) '(#\Space #\Tab #\Newline #\Return))) do (incf i)))
             (expect (c) (if (eql (peek) c) (incf i) (fail "expected ~a at ~d" c i)))
             (literal (word value)
               (if (and (<= (+ i (length word)) n) (string= word string :start2 i :end2 (+ i (length word))))
                   (progn (incf i (length word)) value)
                   (fail "bad literal at ~d" i)))
             (hex4 ()
               (when (> (+ i 4) n) (fail "short \\u escape"))
               (prog1 (parse-integer string :start i :end (+ i 4) :radix 16) (incf i 4)))
             (parse-string ()
               (expect #\")
               (let ((out (make-string-output-stream)))
                 (loop
                   (when (>= i n) (fail "unterminated string"))
                   (let ((c (char string i)))
                     (incf i)
                     (cond ((char= c #\") (return (get-output-stream-string out)))
                           ((char= c #\\)
                            (let ((e (peek))) (incf i)
                              (case e
                                (#\" (write-char #\" out)) (#\\ (write-char #\\ out)) (#\/ (write-char #\/ out))
                                (#\b (write-char #\Backspace out)) (#\f (write-char #\Page out))
                                (#\n (write-char #\Newline out)) (#\r (write-char #\Return out)) (#\t (write-char #\Tab out))
                                (#\u (let ((cp (hex4)))
                                       (when (<= #xd800 cp #xdbff)       ; high surrogate: needs a low one
                                         (if (and (< (+ i 1) n) (char= (char string i) #\\) (char= (char string (1+ i)) #\u))
                                             (progn (incf i 2)
                                                    (let ((lo (hex4)))
                                                      (setf cp (+ #x10000 (ash (- cp #xd800) 10) (- lo #xdc00)))))
                                             (setf cp #xfffd)))
                                       (when (<= #xdc00 cp #xdfff) (setf cp #xfffd))
                                       (write-char (code-char cp) out)))
                                (t (fail "bad escape at ~d" i)))))
                           (t (write-char c out)))))))
             (parse-number ()
               (let ((start i))
                 (loop while (and (< i n) (find (char string i) "+-0123456789.eE")) do (incf i))
                 (let ((s (subseq string start i)))
                   (if (every (lambda (c) (or (digit-char-p c) (char= c #\-))) s)
                       (parse-integer s)
                       (let ((*read-default-float-format* 'double-float) (*read-eval* nil))
                         (float (read-from-string s) 1d0))))))
             (parse-value ()
               (skip-ws)
               (let ((c (peek)))
                 (cond ((null c) (fail "unexpected end"))
                       ((char= c #\{) (incf i) (skip-ws)
                        (if (eql (peek) #\}) (progn (incf i) (list :obj))
                            (let ((pairs nil))
                              (loop (skip-ws)
                                    (let ((k (parse-string))) (skip-ws) (expect #\:)
                                      (push (cons k (parse-value)) pairs))
                                    (skip-ws)
                                    (cond ((eql (peek) #\,) (incf i))
                                          ((eql (peek) #\}) (incf i) (return))
                                          (t (fail "expected , or } at ~d" i))))
                              (cons :obj (nreverse pairs)))))
                       ((char= c #\[) (incf i) (skip-ws)
                        (if (eql (peek) #\]) (progn (incf i) (vector))
                            (let ((items nil))
                              (loop (push (parse-value) items) (skip-ws)
                                    (cond ((eql (peek) #\,) (incf i))
                                          ((eql (peek) #\]) (incf i) (return))
                                          (t (fail "expected , or ] at ~d" i))))
                              (coerce (nreverse items) 'simple-vector))))
                       ((char= c #\") (parse-string))
                       ((char= c #\t) (literal "true" :true))
                       ((char= c #\f) (literal "false" :false))
                       ((char= c #\n) (literal "null" :null))
                       (t (parse-number))))))
      (prog1 (parse-value) (skip-ws) (when (< i n) (fail "trailing data at ~d" i))))))

(defun json-get (obj key &optional default)
  (let ((p (and (consp obj) (eq (car obj) :obj) (assoc key (cdr obj) :test #'string=))))
    (if p (cdr p) default)))

(defun json-string (s)
  (with-output-to-string (o)
    (write-char #\" o)
    (loop for c across s
          do (case c
               (#\" (write-string "\\\"" o)) (#\\ (write-string "\\\\" o)) (#\Newline (write-string "\\n" o))
               (#\Return (write-string "\\r" o)) (#\Tab (write-string "\\t" o))
               (t (if (< (char-code c) 32) (format o "\\u~4,'0x" (char-code c)) (write-char c o)))))
    (write-char #\" o)))

(defun write-json (value stream &optional (indent 0))
  (flet ((pad (k) (dotimes (_ k) (write-char #\Space stream))))
    (cond ((eq value :true) (write-string "true" stream))
          ((eq value :false) (write-string "false" stream))
          ((eq value :null) (write-string "null" stream))
          ((stringp value) (write-string (json-string value) stream))
          ((integerp value) (format stream "~d" value))
          ((floatp value) (let ((*read-default-float-format* 'double-float)) (format stream "~a" value)))
          ((and (consp value) (eq (car value) :obj))
           (let ((pairs (sort (copy-list (cdr value)) #'string< :key #'car)))
             (if (null pairs) (write-string "{}" stream)
                 (progn (format stream "{~%")
                        (loop for ((k . v) . rest) on pairs
                              do (pad (+ indent 2)) (write-string (json-string k) stream) (write-string ": " stream)
                                 (write-json v stream (+ indent 2))
                                 (format stream "~a~%" (if rest "," "")))
                        (pad indent) (write-char #\} stream)))))
          ((vectorp value)
           (if (zerop (length value)) (write-string "[]" stream)
               (progn (format stream "[~%")
                      (loop for i from 0 below (length value)
                            do (pad (+ indent 2)) (write-json (aref value i) stream (+ indent 2))
                               (format stream "~a~%" (if (< i (1- (length value))) "," "")))
                      (pad indent) (write-char #\] stream))))
          (t (error "cannot encode ~s as JSON" value)))))
