(require :sb-posix)
(dolist (f '("util" "sha256" "json" "bpe" "data" "qagen" "retrieval" "tf32" "train32" "pretrain32" "sft32"))
  (load (format nil "lisp/src/~a.lisp" f)))
(defun read-data (path)
  (with-open-file (in path) (let ((*read-eval* nil)) (coerce (read in) 'vector))))
(defun question-count (s)
  (let ((prev -2) (n 0))
    (dolist (r (second s) n)
      (unless (= r (1+ prev)) (incf n))
      (setf prev r))))
(let* ((base "data/runs/retrieval/p2-paraphrase-pilot/")
       (cs (read-data (concatenate 'string base "control-data.sexp")))
       (ts (read-data (concatenate 'string base "treatment-data.sexp")))
       (perm (asem-sft32::epoch-perm 90000 802 0))
       (c-tokens 0) (t-tokens 0) (c-qs 0) (t-qs 0) (copies 0)
       (changed 0) (c-only-targets 0) (t-only-targets 0)
       (denom-diff-batches 0) (seen (make-hash-table)))
  (dotimes (batch 300)
    (let ((cd 0) (td 0))
      (dotimes (j 32)
        (let ((i (aref perm (+ (* batch 32) j))))
          (assert (not (gethash i seen)))
          (setf (gethash i seen) t)
          (if (>= i 75000)
              (progn (incf copies) (incf cd) (incf td))
              (let* ((c (aref cs i)) (tr (aref ts i))
                     (nc (length (third c))) (nt (length (third tr))))
                (incf c-tokens nc) (incf t-tokens nt)
                (incf cd nc) (incf td nt)
                (incf c-qs (question-count c)) (incf t-qs (question-count tr))
                (unless (equal c tr) (incf changed))
                (incf c-only-targets (max 0 (- nc nt)))
                (incf t-only-targets (max 0 (- nt nc)))))))
      (unless (= cd td) (incf denom-diff-batches))))
  (asem-json:write-json
    (list :obj (cons "steps" 300) (cons "batch" 32) (cons "unique_consumed_sequences" (hash-table-count seen))
          (cons "retrieval_sequences" (- 9600 copies)) (cons "copy_sequences" copies)
          (cons "control_retrieval_answer_tokens" c-tokens) (cons "treatment_retrieval_answer_tokens" t-tokens)
          (cons "control_questions" c-qs) (cons "treatment_questions" t-qs)
          (cons "changed_retrieval_sequences" changed)
          (cons "excess_control_answer_tokens_by_sequence" c-only-targets)
          (cons "excess_treatment_answer_tokens_by_sequence" t-only-targets)
          (cons "batches_with_different_denominator" denom-diff-batches)) *standard-output*)
  (terpri))
