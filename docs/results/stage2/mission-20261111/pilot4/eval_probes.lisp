;;;; Evaluate any checkpoint (or default frozen R7 + P3 baselines) across all 7 Pilot 4 independent probes + induction health checks.
;;;; Usage:
;;;;   TLM_BLAS=1 VECLIB_MAXIMUM_THREADS=1 sbcl --noinform --dynamic-space-size 6GB --script docs/results/stage2/mission-20261111/pilot4/eval_probes.lisp
;;;;   or with single-ckpt CLI args: ckpt=PATH tag=TAG out=OUT_JSON
(let ((here (truename "lisp/bin/")))
  (require :sb-posix)
  (dolist (f '("util" "sha256" "json" "bpe" "data" "qagen" "retrieval" "tf32" "train32" "pretrain32" "sft32" "qa-analysis" "wording" "mission-data"))
    (load (merge-pathnames (format nil "../src/~a.lisp" f) here))))

(defpackage :pilot4-eval (:use :cl))
(in-package :pilot4-eval)

(defun obj (&rest kvs) (apply #'asem-mission-data:obj kvs))
(defun vec (xs) (coerce xs 'vector))
(defun frac (a b) (/ a (max 1 b) 1.0d0))

(defun try-accel ()
  (ignore-errors (asem-tf32:native-init))
  (ignore-errors (asem-tf32:blas-init)))

(defun parse-cli ()
  (let ((h (make-hash-table :test 'equal)))
    (dolist (a (cdr sb-ext:*posix-argv*))
      (let ((p (position #\= a)))
        (when p (setf (gethash (subseq a 0 p) h) (subseq a (1+ p))))))
    h))

(defun load-json (path)
  (with-open-file (in path :external-format :utf-8)
    (let* ((s (make-string (file-length in)))
           (n (read-sequence s in)))
      (asem-json:parse-json (subseq s 0 n)))))

(defun load-jsonl (path)
  (with-open-file (in path :external-format :utf-8)
    (loop for l = (read-line in nil)
          while l
          when (plusp (length (string-trim '(#\Space #\Return #\Newline) l)))
          collect (asem-json:parse-json l))))

(defun make-worker-caches (w)
  (coerce (loop repeat w collect (cons (make-hash-table) (make-hash-table :test 'equal))) 'vector))

(defun clear-worker-caches (wc)
  (loop for c across wc do (clrhash (car c)) (clrhash (cdr c))))

(defun pmap-items (n-workers fn items wc)
  (let* ((v (coerce items 'vector))
         (total (length v))
         (out (make-array total))
         (w (min n-workers (max 1 total)))
         (threads nil))
    (dotimes (wi w)
      (let* ((lo (floor (* wi total) w))
             (hi (floor (* (1+ wi) total) w))
             (c (aref wc wi)))
        (push (sb-thread:make-thread
               (lambda ()
                 (let ((acts-1 (car c))
                       (acts-k (cdr c)))
                   (loop for idx from lo below hi
                         do (setf (aref out idx) (funcall fn (aref v idx) acts-1 acts-k))))))
              threads)))
    (dolist (th threads) (sb-thread:join-thread th))
    (coerce out 'list)))

(defun greedy-and-nll (model bpe prompt-no-tail gold acts-1 acts-k)
  (let* ((cfg (asem-tf32:model-config model))
         (ctx (asem-tf32:config-ctx cfg))
         (v (asem-tf32:config-vocab cfg))
         (full-prompt (concatenate 'string prompt-no-tail (string #\Newline) "The answer is"))
         (p-ids (cons 0 (asem-bpe:bpe-encode bpe full-prompt)))
         (g-ids (asem-bpe:bpe-encode bpe (concatenate 'string " " gold)))
         (klen (length g-ids))
         (max-steps (min (max 4 (1+ klen)) (- ctx (length p-ids))))
         (cur (copy-list p-ids))
         (gen-ids nil))
    (loop repeat (max 0 max-steps)
          for n = (length cur)
          while (< n ctx)
          do (let* ((x (coerce cur '(simple-array fixnum (*))))
                    (acts (or (gethash n acts-1)
                              (setf (gethash n acts-1) (asem-tf32:make-acts cfg n 1))))
                    (row (make-array 1 :element-type 'fixnum :initial-element (1- n))))
               (asem-tf32:forward-rows model x acts row)
               (let* ((probs (asem-tf32:acts-probs acts))
                      (bi 0) (bp -1d0))
                 (dotimes (j v)
                   (let ((p (aref probs j)))
                     (when (> p bp) (setf bp p bi j))))
                 (push bi gen-ids)
                 (setf cur (append cur (list bi))))))
    (setf gen-ids (nreverse gen-ids))
    (let* ((full (append p-ids g-ids))
           (nf (length full))
           (nll 0d0)
           (tok0-match (if (and gen-ids (= (first gen-ids) (first g-ids))) 1 0)))
      (when (> nf ctx) (error "Sequence exceeds ctx: ~d > ~d" nf ctx))
      (let* ((xf (coerce full '(simple-array fixnum (*))))
             (plen (length p-ids))
             (rows (make-array klen :element-type 'fixnum))
             (ak (or (gethash (cons nf klen) acts-k)
                     (setf (gethash (cons nf klen) acts-k) (asem-tf32:make-acts cfg nf klen)))))
        (dotimes (k klen) (setf (aref rows k) (+ (1- plen) k)))
        (asem-tf32:forward-rows model xf ak rows)
        (let ((probs (asem-tf32:acts-probs ak)))
          (dotimes (k klen)
            (decf nll (log (max 1d-300 (aref probs (+ (* k v) (nth k g-ids)))))))))
      (let* ((exact-ok (and (>= (length gen-ids) klen)
                            (equal (subseq gen-ids 0 klen) g-ids)))
             (next-tok (and (> (length gen-ids) klen) (nth klen gen-ids)))
             (next-str (if next-tok (asem-bpe:bpe-decode bpe (list next-tok)) ""))
             (bounded-ok (and exact-ok
                              (or (null next-tok)
                                  (= next-tok 0)
                                  (zerop (length next-str))
                                  (not (alphanumericp (char next-str 0))))))
             (gen-prefix (asem-bpe:bpe-decode bpe (subseq gen-ids 0 (min klen (length gen-ids))))))
        (list :exact (if exact-ok 1 0)
              :bounded (if bounded-ok 1 0)
              :tok0 tok0-match
              :nll (/ nll (max 1 klen))
              :gen (string-trim '(#\Space #\. #\Newline #\Return) gen-prefix))))))

(defun eval-k4-items (model bpe letters items)
  (let ((exs (make-array (length items)))
        (idx 0))
    (dolist (it items)
      (let* ((opts (coerce (asem-json:json-get it "options") 'list))
             (p (asem-qagen:format-prompt (asem-json:json-get it "passage")
                                          (asem-json:json-get it "question")
                                          opts))
             (gold (asem-json:json-get it "answer_text"))
             (cat (asem-json:json-get it "category"))
             (sub (asem-json:json-get it "subtype")))
        (multiple-value-bind (tex lex)
            (asem-sft32:choice-exs (asem-json:json-get it "id") cat sub p opts gold bpe 128)
          (declare (ignore lex))
          (setf (aref exs idx) tex)
          (incf idx))))
    (let ((preds (asem-sft32:qa-predict model exs letters :workers 4)))
      (loop for p in preds for e across exs
            collect (list :correct (if (= (first p) (asem-sft32:ex-answer e)) 1 0)
                          :pred-idx (first p))))))

(defun run-induction-bucket (model tok-ids &key (n 50) (half 40) (seed 17))
  (let* ((cfg (asem-tf32:model-config model))
         (v (asem-tf32:config-vocab cfg))
         (tlen (+ 1 (* 2 half)))
         (acts (asem-tf32:make-acts cfg tlen tlen))
         (ntok (length tok-ids))
         (rng-state (logand #xffffffff (sxhash seed)))
         (sum-l1 0d0) (sum-l2 0d0)
         (acc1 0) (acc2 0) (cnt1 0) (cnt2 0))
    (labels ((next-u32 ()
               (setf rng-state (logand #xffffffff (+ (* rng-state 1664525) 1013904223)))
               rng-state)
             (pick () (aref tok-ids (mod (next-u32) ntok))))
      (dotimes (_ n)
        (let ((x (make-array tlen :element-type 'fixnum :initial-element 0)))
          (dotimes (i half)
            (let ((tk (pick)))
              (setf (aref x (1+ i)) tk
                    (aref x (+ 1 half i)) tk)))
          (asem-tf32:forward model x acts)
          (let ((probs (asem-tf32:acts-probs acts)))
            (loop for i from 1 below half
                  for tgt = (aref x (1+ i))
                  for pr = (aref probs (+ (* i v) tgt))
                  do (decf sum-l1 (log (max 1d-300 pr)))
                     (incf cnt1)
                     (let ((bi 0) (bp -1d0) (base (* i v)))
                       (dotimes (j v)
                         (let ((p (aref probs (+ base j))))
                           (when (> p bp) (setf bp p bi j))))
                       (when (= bi tgt) (incf acc1))))
            (loop for i from 1 below half
                  for row = (+ half i)
                  for tgt = (aref x (1+ row))
                  for pr = (aref probs (+ (* row v) tgt))
                  do (decf sum-l2 (log (max 1d-300 pr)))
                     (incf cnt2)
                     (let ((bi 0) (bp -1d0) (base (* row v)))
                       (dotimes (j v)
                         (let ((p (aref probs (+ base j))))
                           (when (> p bp) (setf bp p bi j))))
                       (when (= bi tgt) (incf acc2))))))))
    (obj "n_sequences" n
         "pool_size" ntok
         "loss_first_copy" (/ sum-l1 cnt1)
         "loss_second_copy" (/ sum-l2 cnt2)
         "acc_first_copy" (frac acc1 cnt1)
         "acc_second_copy" (frac acc2 cnt2))))

(defun eval-checkpoint (tag path bpe letters manifest cjson wc)
  (format t "Evaluating ~a (~a)...~%" tag path)
  (force-output)
  (let* ((m (asem-sft32:load-ex-model path))
         (probe-names '("fresh_ans_before" "entity_copy" "extract_ret" "relation_ret" "reverse_ret" "compare_ret" "temporal_ret"))
         (probe-objs nil))
    (dolist (pn probe-names)
      (let* ((pfile (format nil "docs/results/stage2/mission-20261111/pilot4/probes/~a.jsonl" pn))
             (items (load-jsonl pfile))
             (do-k4 (not (string= pn "entity_copy")))
             (k4-res (when do-k4 (eval-k4-items m bpe letters items)))
             ;; For entity_copy, evaluate K4 on L3_copy items only
             (ec-l3 (when (string= pn "entity_copy")
                      (remove-if-not (lambda (it) (search "L3_" (asem-json:json-get it "subtype"))) items)))
             (ec-k4 (when ec-l3 (eval-k4-items m bpe letters ec-l3)))
             (ec-k4-map (make-hash-table :test 'equal))
             (do-greedy (or (string= pn "entity_copy") (string= pn "fresh_ans_before")))
             (g-res (when do-greedy
                      (pmap-items 4
                                  (lambda (it a1 ak)
                                    (let ((p (format nil "Text: ~a~%Q: ~a"
                                                     (asem-json:json-get it "passage")
                                                     (asem-json:json-get it "question"))))
                                      (greedy-and-nll m bpe p (asem-json:json-get it "answer_text") a1 ak)))
                                  items wc))))
        (when ec-l3
          (loop for it in ec-l3 for r in ec-k4
                do (setf (gethash (asem-json:json-get it "id") ec-k4-map) (getf r :correct))))
        (let ((rows
               (coerce
                (loop for it in items
                      for i from 0
                      for k4-r = (when do-k4 (nth i k4-res))
                      for gr = (when do-greedy (nth i g-res))
                      for id = (asem-json:json-get it "id")
                      collect (obj "id" id
                                   "split" (or (asem-json:json-get it "wording") (asem-json:json-get it "split"))
                                   "subtype" (asem-json:json-get it "subtype")
                                   "tag" (asem-json:json-get it "tag")
                                   "k4" (cond (do-k4 (getf k4-r :correct))
                                              ((gethash id ec-k4-map nil) (gethash id ec-k4-map))
                                              (t -1))
                                   "exact" (if do-greedy (getf gr :exact) -1)
                                   "bounded" (if do-greedy (getf gr :bounded) -1)
                                   "tok0" (if do-greedy (getf gr :tok0) -1)
                                   "nll" (if do-greedy (getf gr :nll) -1.0d0)))
                'vector)))
          (push (cons pn rows) probe-objs))))
    ;; Induction health checks
    (let* ((buckets (asem-json:json-get cjson "induction_buckets"))
           (hi-ids (asem-json:json-get buckets "p3_r7_hi100_alpha"))
           (ev-toks (asem-json:json-get manifest "reserved_ev_heldout_tokens"))
           (ev-alpha-ids (concatenate 'vector
                                      (asem-json:json-get ev-toks "space_title_alpha")
                                      (asem-json:json-get ev-toks "bare_lower_alpha")))
           (std-ids (coerce (loop for id from 300 below 7300 collect id) 'vector))
           (ind-obj (obj "std_300_7300" (run-induction-bucket m std-ids :n 50 :half 40 :seed 17)
                         "seen_hi100_alpha" (run-induction-bucket m hi-ids :n 50 :half 40 :seed 17)
                         "eval_heldout_alpha" (run-induction-bucket m ev-alpha-ids :n 50 :half 40 :seed 17))))
      (clear-worker-caches wc)
      (sb-ext:gc :full t)
      (obj "ckpt" path
           "induction" ind-obj
           "probes" (cons :obj (nreverse probe-objs))))))

(defun main ()
  (try-accel)
  (let* ((cli (parse-cli))
         (bpe (asem-bpe:load-bpe "data/fineweb/stage1/tokenizer.bpe"))
         (letters (asem-sft32:letter-token-ids bpe))
         (manifest (load-json "docs/results/stage2/mission-20261111/pilot4/probe_suite_manifest.json"))
         (cjson (load-json "docs/results/stage2/mission-20261111/pilot4/causal_probe_items.json"))
         (wc (make-worker-caches 4))
         (ckpt-arg (gethash "ckpt" cli))
         (tag-arg (or (gethash "tag" cli) "eval"))
         (out-arg (or (gethash "out" cli) "docs/results/stage2/mission-20261111/pilot4/baseline_eval_results.json"))
         (targets (if ckpt-arg
                      (list (cons tag-arg ckpt-arg))
                      '(("r7" . "data/runs/retrieval/r7-L123-aug-opts-rev-rsn/last.ckpt")
                        ("p3_5e4" . "data/runs/retrieval/p3-learnability/arm-5e-4/last.ckpt")
                        ("p3_1e3" . "data/runs/retrieval/p3-learnability/arm-1e-3/last.ckpt"))))
         (res-list nil))
    (dolist (ck targets)
      (push (cons (car ck) (eval-checkpoint (car ck) (cdr ck) bpe letters manifest cjson wc)) res-list))
    (with-open-file (out out-arg :direction :output :if-exists :supersede :if-does-not-exist :create :external-format :utf-8)
      (asem-json:write-json (obj "schema" "asem-pilot4-probe-eval-1"
                                 "results" (cons :obj (nreverse res-list)))
                            out)
      (terpri out))
    (format t "Wrote ~a~%" out-arg)))

(main)
