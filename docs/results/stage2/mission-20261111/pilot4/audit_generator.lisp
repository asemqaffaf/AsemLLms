;;;; Deterministic Data Audit for Pilot 4 Prep (Entity/BPE Coverage + Task Distribution)
;;;; Read-only on frozen artifacts; NEVER accesses :test splits, confirmation.sexp, or locked tests.
(let ((here (truename "lisp/bin/")))
  (require :sb-posix)
  (dolist (f '("util" "sha256" "json" "bpe" "data" "qagen" "retrieval" "tf32" "train32" "pretrain32" "sft32" "qa-analysis" "wording" "mission-data"))
    (load (merge-pathnames (format nil "../src/~a.lisp" f) here))))

(defpackage :pilot4-audit (:use :cl))
(in-package :pilot4-audit)

(defun obj (&rest kvs) (apply #'asem-mission-data:obj kvs))
(defun vec (xs) (coerce xs 'vector))
(defun frac (a b) (/ a (max 1 b) 1.0d0))

(defun read-bin-u16-counts (paths vocab)
  (let ((counts (make-array vocab :initial-element 0))
        (total 0)
        (buf (make-array 65536 :element-type '(unsigned-byte 8))))
    (dolist (p paths)
      (with-open-file (in p :element-type '(unsigned-byte 8))
        (loop for n = (read-sequence buf in)
              while (plusp n)
              do (loop for i from 0 below n by 2
                       do (let ((tok (+ (aref buf i) (ash (aref buf (1+ i)) 8))))
                            (incf total)
                            (when (< tok vocab) (incf (aref counts tok))))))))
    (values counts total)))

(defun token-shape (id decoded)
  (cond
    ((= id 0) "eot")
    ((and (<= 1 id 256) (= (length decoded) 1)
          (not (alpha-char-p (char decoded 0)))
          (not (digit-char-p (char decoded 0))))
     "raw_non_alnum_byte")
    ((and (plusp (length decoded)) (char= (char decoded 0) #\Space)
          (> (length decoded) 1)
          (every #'alpha-char-p (subseq decoded 1)))
     (let ((tail (subseq decoded 1)))
       (cond ((every #'lower-case-p tail) "space_lower_alpha")
             ((and (upper-case-p (char tail 0))
                   (every #'lower-case-p (subseq tail 1)))
              "space_title_alpha")
             ((every #'upper-case-p tail) "space_upper_alpha")
             (t "space_mixed_alpha"))))
    ((and (plusp (length decoded)) (every #'alpha-char-p decoded))
     (cond ((every #'lower-case-p decoded) "bare_lower_alpha")
           ((and (upper-case-p (char decoded 0))
                 (every #'lower-case-p (subseq decoded 1)))
            "bare_title_alpha")
           (t "bare_mixed_alpha")))
    ((and (plusp (length decoded))
          (every (lambda (c) (or (digit-char-p c) (char= c #\Space))) decoded))
     "digits")
    (t "other")))

(defun read-lines (path)
  (with-open-file (in path :external-format :utf-8)
    (loop for line = (read-line in nil)
          while line
          for tr = (string-trim '(#\Space #\Tab #\Return #\Newline) line)
          when (plusp (length tr)) collect tr)))

(defun d1-names-list ()
  (let ((all (read-lines "docs/results/stage2/mission-20261111/pilot2/d1-entities.txt")))
    (remove-if-not (lambda (s) (member s (asem-qagen:split-pool asem-qagen:*names* :dev) :test #'string=)) all)))

(defun pool-token-stats (bpe strings &key (prefix " ") (vocab 8192))
  (let ((tok-str-counts (make-array vocab :initial-element 0))
        (init-counts (make-hash-table :test 'equal))
        (tok-lens (make-hash-table))
        (same-bare-vs-sp 0)
        (same-sp-tail 0)
        (total-toks 0))
    (dolist (s strings)
      (let* ((sp-ids (asem-bpe:bpe-encode bpe (concatenate 'string prefix s)))
             (bare-ids (asem-bpe:bpe-encode bpe s))
             (seen (make-hash-table))
             (c0 (string (char s 0))))
        (incf (gethash c0 init-counts 0))
        (incf (gethash (length sp-ids) tok-lens 0))
        (incf total-toks (length sp-ids))
        (when (equal sp-ids bare-ids) (incf same-bare-vs-sp))
        (when (equal (cdr sp-ids) (cdr bare-ids)) (incf same-sp-tail))
        (dolist (id sp-ids)
          (unless (gethash id seen)
            (setf (gethash id seen) t)
            (incf (aref tok-str-counts id))))))
    (let ((covered 0))
      (dotimes (i vocab) (when (plusp (aref tok-str-counts i)) (incf covered)))
      (values tok-str-counts
              (obj "n_strings" (length strings)
                   "distinct_spaced_tokens" covered
                   "mean_spaced_tokens" (frac total-toks (length strings))
                   "same_bare_vs_spaced_fraction" (frac same-bare-vs-sp (length strings))
                   "same_tail_after_first_token_fraction" (frac same-sp-tail (length strings))
                   "initial_char_counts" (cons :obj (sort (loop for k being the hash-keys of init-counts using (hash-value v) collect (cons k v)) #'string< :key #'car))
                   "spaced_token_length_hist" (cons :obj (sort (loop for k being the hash-keys of tok-lens using (hash-value v) collect (cons (format nil "~d" k) v)) #'< :key (lambda (x) (parse-integer (car x))))))))))

(defun whole-word-pos (w s)
  (let ((len (length w)) (slen (length s)))
    (loop for i = (search w s :test #'char-equal) then (search w s :start2 (1+ i) :test #'char-equal)
          while i
          when (and (or (zerop i) (not (alphanumericp (char s (1- i)))))
                    (or (= (+ i len) slen) (not (alphanumericp (char s (+ i len))))))
            do (return i))))

(defun extract-qa-pairs-from-text (text)
  "Parse passage and ordered list of (q-text . ans-text) from decoded retrieval sequence."
  (let* ((nl1 (position #\Newline text))
         (passage (subseq text (length "Text: ") nl1))
         (rest (subseq text (1+ nl1)))
         (pos 0)
         (n (length rest))
         (qas nil))
    (loop while (< pos n)
          do (let ((qstart (search "Q: " rest :start2 pos)))
               (unless qstart (return))
               (let* ((qend (position #\Newline rest :start (+ qstart 3)))
                      (qtext (subseq rest (+ qstart 3) qend))
                      (tpos (search (format nil "~%The answer is ") rest :start2 qend))
                      (a-start (+ tpos (length (format nil "~%The answer is "))))
                      (a-end (search (format nil ".~%") rest :start2 a-start))
                      (ans (subseq rest a-start a-end)))
                 (push (cons qtext ans) qas)
                 (setf pos (+ a-end 2)))))
    (values passage (nreverse qas))))

(defun classify-question-exact (bpe passage qtext ans meta-entry)
  "Determine exact kind, subtype/op, attr, frame-info, and answer-before-query using fact meta-entry + passage check."
  (declare (ignore bpe))
  (let* ((kind (getf meta-entry :kind))
         (attr (getf meta-entry :attr))
         (op (getf meta-entry :op))
         (qentity (getf meta-entry :qentity))
         (sframe (getf meta-entry :sframe))
         (qframe (getf meta-entry :qframe))
         (ans-before :null))
    (when (and qentity (member kind '(:attr :rel :num)))
      ;; Find sentence in passage containing qentity & ans
      (dolist (sent (asem-qagen::sentences-of passage))
        (let ((pa (whole-word-pos ans sent))
              (pq (whole-word-pos qentity sent)))
          (when (and pa pq)
            (setf ans-before (if (< pa pq) :true :false))
            (return)))))
    (list :kind kind :attr attr :op op :sframe sframe :qframe qframe :ans-before ans-before)))

(defun run-r7-audit (bpe vocab)
  (let* ((asem-retrieval:*broad-train* t)
         (asem-retrieval:*augment* t)
         (asem-retrieval:*reverse* t)
         (asem-retrieval:*reasoning* t)
         (asem-retrieval:*vocab-words* (asem-retrieval:vocab-words-of bpe))
         (orig-mfs (symbol-function 'asem-retrieval:make-fact-set))
         (orig-fill (symbol-function 'asem-qagen::fill-frame))
         (orig-aug (symbol-function 'asem-retrieval::augmented))
         (passage-map (make-hash-table :test 'equal))
         (ret-all (make-array vocab :initial-element 0))
         (ret-ans (make-array vocab :initial-element 0))
         (copy-all (make-array vocab :initial-element 0))
         (seqs-by-level-kind (make-hash-table :test 'equal))
         (qs-by-cell (make-hash-table :test 'equal))
         (toks-by-cell (make-hash-table :test 'equal))
         (sframes-seen (make-hash-table :test 'equal))
         (qframes-seen (make-hash-table :test 'equal))
         (aug-generic-q-count 0)
         (unresolved-op-count 0)
         (ret-seqs 0)
         (ret-qs 0)
         (ret-ans-toks 0)
         (copy-seqs 0)
         (copy-toks 0))
    (unwind-protect
         (progn
           (setf (symbol-function 'asem-retrieval:make-fact-set)
                 (lambda (level entities wording rng)
                   (let ((captured-sframes nil)
                         (captured-qframes nil)
                         (aug-records nil))
                     (setf (symbol-function 'asem-qagen::fill-frame)
                           (lambda (frame &rest pairs)
                             (let ((res (apply orig-fill frame pairs)))
                               (if (find #\? frame)
                                   (push (list :frame frame :pairs pairs :text res) captured-qframes)
                                   (push (list :frame frame :pairs pairs :text res) captured-sframes))
                               res)))
                     (setf (symbol-function 'asem-retrieval::augmented)
                           (lambda (sents qa-in people tkey protect r &rest rest)
                             (let ((vals (multiple-value-list (apply orig-aug sents qa-in people tkey protect r rest))))
                               (when (= (length qa-in) (length (second vals)))
                                 (loop for in-p in qa-in for out-p in (second vals)
                                       do (push (list :out-q (car out-p) :orig-q (car in-p) :ans (cdr out-p))
                                                aug-records)))
                               (values-list vals))))
                     (unwind-protect
                          (multiple-value-bind (passage qa kind cands padder)
                              (funcall orig-mfs level entities wording rng)
                            (setf aug-records (nreverse aug-records))
                            (let ((qmetas (make-hash-table :test 'equal)))
                              (loop for (q . ans) in qa
                                    do (let* ((aug-rec (find-if (lambda (r)
                                                                  (and (string= (getf r :out-q) q)
                                                                       (string= (getf r :ans) ans)))
                                                                aug-records))
                                              (orig-q (if aug-rec (getf aug-rec :orig-q) q))
                                              (is-mod-q (not (string= orig-q q)))
                                              (qf-match (find-if (lambda (e) (search (getf e :text) orig-q)) captured-qframes))
                                              (qframe (if qf-match (getf qf-match :frame) "UNMATCHED_Q"))
                                              (pairs (and qf-match (getf qf-match :pairs)))
                                              (qent (or (getf pairs :p) (getf pairs :v) (getf pairs :a) (getf pairs :b) (getf pairs :x)))
                                              (attr :none)
                                              (op :none))
                                         (when is-mod-q (incf aug-generic-q-count))
                                         (cond
                                           ((eq kind :attr)
                                            (dolist (ty asem-qagen::*attr-types*)
                                              (when (or (member qframe (getf (getf (cdr ty) :q-extract) :train) :test #'string=)
                                                        (member qframe (getf (getf (cdr ty) :q-reverse) :train) :test #'string=))
                                                (setf attr (car ty))
                                                (setf op (if (member qframe (getf (getf (cdr ty) :q-extract) :train) :test #'string=)
                                                             :extract :reverse))
                                                (return))))
                                           ((eq kind :num)
                                            (dolist (ty asem-qagen::*num-types*)
                                              (cond ((member qframe (getf (getf (cdr ty) :q-extract) :train) :test #'string=)
                                                     (setf attr (car ty) op :extract) (return))
                                                    ((member qframe (getf (getf (cdr ty) :q-max) :train) :test #'string=)
                                                     (setf attr (car ty) op :max) (return))
                                                    ((member qframe (getf (getf (cdr ty) :q-min) :train) :test #'string=)
                                                     (setf attr (car ty) op :min) (return)))))
                                           ((eq kind :rel)
                                            (dolist (ty asem-qagen::*relations*)
                                              (cond ((member qframe (getf (getf (cdr ty) :q-subj) :train) :test #'string=)
                                                     (setf attr (car ty) op :q-subj) (return))
                                                    ((member qframe (getf (getf (cdr ty) :q-obj) :train) :test #'string=)
                                                     (setf attr (car ty) op :q-obj) (return)))))
                                           ((eq kind :cmp)
                                            (dolist (ty asem-qagen::*num-types*)
                                              (cond ((member qframe (getf (getf (cdr ty) :q-max) :train) :test #'string=)
                                                     (setf attr (car ty) op :max) (return))
                                                    ((member qframe (getf (getf (cdr ty) :q-min) :train) :test #'string=)
                                                     (setf attr (car ty) op :min) (return)))))
                                           ((eq kind :tmp)
                                            (let ((tm asem-qagen::*temporal*))
                                              (setf attr :temporal)
                                              (setf op (cond ((member qframe (getf (getf tm :q-first) :train) :test #'string=) :first)
                                                             ((member qframe (getf (getf tm :q-last) :train) :test #'string=) :last)
                                                             ((member qframe (getf (getf tm :q-after) :train) :test #'string=) :after)
                                                             ((member qframe (getf (getf tm :q-before) :train) :test #'string=) :before)
                                                             (t :unknown))))))
                                         (when (or (eq op :none) (eq op :unknown) (eq attr :none))
                                           (incf unresolved-op-count))
                                         (let ((sframe "MULTI/OTHER"))
                                           (when (eq kind :attr)
                                             (let ((sf (find-if (lambda (e)
                                                                  (let ((ps (getf e :pairs)))
                                                                    (or (and (equal (getf ps :p) ans) (equal (getf ps :v) qent))
                                                                        (and (equal (getf ps :v) ans) (equal (getf ps :p) qent)))))
                                                                captured-sframes)))
                                               (when sf (setf sframe (getf sf :frame)))))
                                           (when (eq kind :rel)
                                             (let ((sf (find-if (lambda (e)
                                                                  (let ((ps (getf e :pairs)))
                                                                    (or (and (equal (getf ps :a) ans) (equal (getf ps :b) qent))
                                                                        (and (equal (getf ps :b) ans) (equal (getf ps :a) qent)))))
                                                                captured-sframes)))
                                               (when sf (setf sframe (getf sf :frame)))))
                                           (when (eq kind :num)
                                             (let ((sf (find-if (lambda (e)
                                                                  (let ((ps (getf e :pairs)))
                                                                    (and (equal (getf ps :p) qent) (equal (getf ps :n) ans))))
                                                                captured-sframes)))
                                               (when sf (setf sframe (getf sf :frame)))))
                                           (setf (gethash (cons q ans) qmetas)
                                                 (list :kind kind :attr attr :op op :qentity qent :sframe sframe :qframe qframe)))))
                              (setf (gethash passage passage-map) (list :level level :kind kind :qmetas qmetas)))
                            (values passage qa kind cands padder))
                       (setf (symbol-function 'asem-qagen::fill-frame) orig-fill
                             (symbol-function 'asem-retrieval::augmented) orig-aug))))))
           (let ((seqs (asem-retrieval:train-sequences 75000 '(1 2 3) 7 bpe 128 :options t)))
             (setf ret-seqs (length seqs))
             (dolist (seq seqs)
               (destructuring-bind (ids rows tg) seq
                 (dolist (id ids) (incf (aref ret-all id)))
                 (dolist (tk tg) (incf (aref ret-ans tk)))
                 (let* ((text (asem-bpe:bpe-decode bpe ids)))
                   (multiple-value-bind (passage qas) (extract-qa-pairs-from-text text)
                     (let* ((pinfo (or (gethash passage passage-map) (error "Missing passage map")))
                            (level (getf pinfo :level))
                            (kind (getf pinfo :kind))
                            (qmetas (getf pinfo :qmetas))
                            (lk-key (format nil "L~d|~a" level (string-downcase (symbol-name kind)))))
                       (incf (gethash lk-key seqs-by-level-kind 0))
                       ;; Tally per-question tokens cleanly by matching answer token runs
                       (let ((runs nil) (cur nil) (prev nil))
                         (loop for r in rows for tok in tg
                               do (if (or (null prev) (= r (1+ prev)))
                                      (push tok cur)
                                      (progn (push (nreverse cur) runs) (setf cur (list tok))))
                                  (setf prev r))
                         (when cur (push (nreverse cur) runs))
                         (setf runs (nreverse runs))
                         (unless (= (length runs) (length qas))
                           (error "Run/QA mismatch: ~d vs ~d" (length runs) (length qas)))
                         (loop for (qtext . ans) in qas for rtoks in runs
                               do (let* ((m (or (gethash (cons qtext ans) qmetas)
                                                (error "Missing qmeta for q=~s ans=~s" qtext ans)))
                                         (cls (classify-question-exact bpe passage qtext ans m))
                                         (cell-key (format nil "L~d|~a|~a|~a|~a"
                                                           level
                                                           (string-downcase (symbol-name (getf cls :kind)))
                                                           (string-downcase (symbol-name (getf cls :attr)))
                                                           (string-downcase (symbol-name (getf cls :op)))
                                                           (cond ((eq (getf cls :ans-before) :true) "ans_before")
                                                                 ((eq (getf cls :ans-before) :false) "ans_after")
                                                                 (t "multi_sent")))))
                                    (incf ret-qs)
                                    (incf ret-ans-toks (length rtoks))
                                    (incf (gethash cell-key qs-by-cell 0))
                                    (incf (gethash cell-key toks-by-cell 0) (length rtoks))
                                    (incf (gethash (getf cls :sframe) sframes-seen 0))
                                    (incf (gethash (getf cls :qframe) qframes-seen 0))))))))))
             (let ((copy-exs (asem-sft32:make-copy-examples 15000 77 :min-len 10 :max-len 40 :lo 1 :hi vocab)))
               (setf copy-seqs (length copy-exs))
               (loop for e across copy-exs
                     do (let ((ids (coerce (asem-sft32:ex-ids e) 'list))
                              (tg (coerce (asem-sft32::ex-tgt e) 'list)))
                          (dolist (id (rest ids)) (incf (aref copy-all id)))
                          (dolist (id tg) (incf (aref copy-all id)) (incf copy-toks))))))
      (setf (symbol-function 'asem-retrieval:make-fact-set) orig-mfs
            (symbol-function 'asem-qagen::fill-frame) orig-fill
            (symbol-function 'asem-retrieval::augmented) orig-aug))
    (labels ((ht->obj (h) (cons :obj (sort (loop for k being the hash-keys of h using (hash-value v) collect (cons k v)) #'string< :key #'car))))
      (values ret-all ret-ans copy-all
              (obj "ret_sequences" ret-seqs
                   "copy_sequences" copy-seqs
                   "total_sequences" (+ ret-seqs copy-seqs)
                   "ret_questions" ret-qs
                   "ret_answer_tokens" ret-ans-toks
                   "copy_target_tokens" copy-toks
                   "copy_sequence_weight_fraction" (frac copy-seqs (+ ret-ans-toks copy-seqs))
                   "aug_modified_q_count" aug-generic-q-count
                   "unresolved_op_count" unresolved-op-count
                   "seqs_by_level_kind" (ht->obj seqs-by-level-kind)
                   "questions_by_cell" (ht->obj qs-by-cell)
                   "answer_tokens_by_cell" (ht->obj toks-by-cell)
                   "sframes_seen" (ht->obj sframes-seen)
                   "qframes_seen" (ht->obj qframes-seen))))))

(defun split-ws (s)
  (loop with n = (length s)
        with i = 0
        while (< i n)
        do (loop while (and (< i n) (not (alphanumericp (char s i)))) do (incf i))
        when (< i n)
          collect (let ((j i))
                    (loop while (and (< j n) (alphanumericp (char s j))) do (incf j))
                    (prog1 (subseq s i j) (setf i j)))))

(defun starts-with-ci (prefix s)
  (and (>= (length s) (length prefix))
       (string-equal prefix s :end2 (length prefix))))

(defun ends-with-ci (suffix s)
  (and (>= (length s) (length suffix))
       (string-equal suffix s :start2 (- (length s) (length suffix)))))

(defun extract-all-qa-with-opts (txt)
  (let* ((nl1 (position #\Newline txt))
         (passage (subseq txt (length "Text: ") nl1))
         (rest (subseq txt (1+ nl1)))
         (pos 0)
         (n (length rest))
         (qas nil))
    (loop while (< pos n)
          do (let ((qstart (search "Q: " rest :start2 pos)))
               (unless qstart (return))
               (let* ((apos (search (format nil "~%A. ") rest :start2 qstart))
                      (qtext (subseq rest (+ qstart 3) apos))
                      (tpos (search (format nil "~%The answer is ") rest :start2 apos))
                      (a-start (+ tpos (length (format nil "~%The answer is "))))
                      (a-end (or (search (format nil ".~%") rest :start2 a-start)
                                 (position #\. rest :start a-start)))
                      (ans (subseq rest a-start a-end)))
                 (push (list :q qtext :ans ans) qas)
                 (setf pos (1+ a-end)))))
    (values passage (nreverse qas))))

(defun classify-p3-seq (passage qtext ans)
  (let* ((qlow (string-downcase qtext))
         (slow (string-downcase passage))
         (is-vf (or (starts-with-ci "tell me " qlow)
                    (starts-with-ci "report " qlow)
                    (ends-with-ci ", please?" qlow)
                    (starts-with-ci "where " qlow)
                    (starts-with-ci "what town " qlow)
                    (starts-with-ci "which town " qlow)
                    (starts-with-ci "what city " qlow)
                    (starts-with-ci "which city " qlow)
                    (starts-with-ci "what instrument " qlow)
                    (starts-with-ci "which instrument " qlow)
                    (and (starts-with-ci "what does " qlow) (search " play" qlow))
                    (and (starts-with-ci "which " qlow) (search " learning" qlow))))
         (dir (if is-vf "vf" "pf"))
         (attr (cond
                 ((or (search "live" qlow) (search "town" qlow) (search "where " qlow)
                      (search "house" qlow) (search "home" qlow) (search "resid" qlow) (search "dwell" qlow)) "town")
                 ((or (search "play" qlow) (search "instrument" qlow) (search "music" qlow)
                      (search "practic" qlow) (search "is learning" qlow)) "instrument")
                 ((or (search "color" qlow) (search "colour" qlow) (search "loves " qlow) (search "likes " qlow)
                      (search "prefer" qlow) (search "favorite" qlow)) "color")
                 ((or (search "pet" qlow) (search "owns" qlow) (search "animal" qlow)
                      (search "takes care" qlow) (search "keeps" qlow) (search "adopt" qlow)) "pet")
                 ((or (search "job" qlow) (search "works as" qlow) (search "work?" qlow) (search "trade" qlow)
                      (search "living as" qlow) (search "profession" qlow) (search "career" qlow)
                      (search "employ" qlow) (search " is a " qlow) (search " is an " qlow)) "job")
                 ((or (search " town " slow) (search " lives " slow) (search " live in " slow) (search " belongs to " slow)) "town")
                 ((or (search " instrument " slow) (search " plays " slow) (search " learning to play " slow) (search " practices " slow)) "instrument")
                 ((or (search " color " slow) (search " favorite color " slow)) "color")
                 ((or (search " as a pet." slow) (search " at home." slow) (search " takes care " slow) (search " owns " slow)) "pet")
                 ((or (search " job " slow) (search " trade," slow) (search " living as " slow) (search " works as " slow)) "job")
                 (t "unknown")))
         (sent-idx -1)
         (ans-order "unknown")
         (ignore-words '("who" "whose" "which" "what" "where" "person" "is" "are" "was" "does" "do" "did"
                         "the" "a" "an" "in" "as" "on" "at" "of" "to" "for" "by" "and" "or" "most" "best" "now"
                         "still" "always" "usually" "currently" "actually" "indeed" "already" "often"
                         "maybe" "perhaps" "today" "it" "seems" "happens" "moment" "report" "tell" "me"
                         "please" "every" "day" "rumor" "says" "that" "this" "all" "with" "goes" "from"))
         (frame-words '("color" "colour" "favorite" "pet" "job" "town" "city" "instrument"
                        "live" "lives" "living" "house" "home" "work" "works" "trade" "owns" "own"
                        "loves" "love" "likes" "prefer" "prefers" "learning" "learn" "plays" "play" "takes" "care"
                        "earns" "has" "have")))
    (loop for sent in (asem-qagen::sentences-of passage)
          for idx from 0
          for pa = (whole-word-pos ans sent)
          when pa
            do (setf sent-idx idx)
               (let* ((qclean (remove-if (lambda (w) (or (< (length w) 2) (string-equal w ans) (member (string-downcase w) ignore-words :test #'string=))) (split-ws qtext)))
                      (qnonframe (remove-if (lambda (w) (member (string-downcase w) frame-words :test #'string=)) qclean))
                      (qent (or (find-if (lambda (w) (whole-word-pos w sent)) qnonframe)
                                (find-if (lambda (w) (whole-word-pos w sent)) qclean))))
                 (when qent
                   (let ((pq (whole-word-pos qent sent)))
                     (setf ans-order (if (< pa pq) "ans_before" "ans_after")))))
               (return))
    (values dir attr ans-order sent-idx)))

(defun run-p3-audit (bpe vocab)
  (let* ((data (with-open-file (in "data/runs/retrieval/p3-learnability/data-train.sexp") (let ((*read-eval* nil)) (read in))))
         (p3-all (make-array vocab :initial-element 0))
         (p3-ans (make-array vocab :initial-element 0))
         (by-attr-dir (make-hash-table :test 'equal))
         (by-order (make-hash-table :test 'equal))
         (by-sent-idx (make-hash-table :test 'equal))
         (unknown-samples nil)
         (n-seq 0) (n-qs 0) (n-toks 0))
    (dolist (seq data)
      (incf n-seq)
      (destructuring-bind (ids rows tg) seq
        (declare (ignore rows))
        (dolist (id ids) (incf (aref p3-all id)))
        (dolist (tk tg) (incf (aref p3-ans tk)))
        (incf n-toks (length tg))
        (multiple-value-bind (passage qas) (extract-all-qa-with-opts (asem-bpe:bpe-decode bpe ids))
          (dolist (qa qas)
            (incf n-qs)
            (let ((qtext (getf qa :q))
                  (ans (getf qa :ans)))
              (multiple-value-bind (dir attr order sidx) (classify-p3-seq passage qtext ans)
                (incf (gethash (format nil "~a|~a" dir attr) by-attr-dir 0))
                (incf (gethash order by-order 0))
                (incf (gethash (format nil "sent_~d" sidx) by-sent-idx 0))
                (when (and (or (string= attr "unknown") (string= order "unknown"))
                           (< (length unknown-samples) 5))
                  (push (list :dir dir :attr attr :order order :passage passage :q qtext :ans ans) unknown-samples))))))))
    (when unknown-samples
      (format t "WARNING Pilot 3 unknown samples: ~s~%" (nreverse unknown-samples)))
    (labels ((ht->obj (h) (cons :obj (sort (loop for k being the hash-keys of h using (hash-value v) collect (cons k v)) #'string< :key #'car))))
      (values p3-all p3-ans
              (obj "sequences" n-seq
                   "questions" n-qs
                   "answer_tokens" n-toks
                   "distinct_answer_tokens" (loop for i below vocab count (plusp (aref p3-ans i)))
                   "by_dir_attr" (ht->obj by-attr-dir)
                   "by_ans_order" (ht->obj by-order)
                   "by_ans_sent_idx" (ht->obj by-sent-idx))))))

(let* ((bpe (asem-bpe:load-bpe "data/fineweb/stage1/tokenizer.bpe"))
       (vocab 8192))
  (format t "1/4 Reading FineWeb train shards...~%")
  (multiple-value-bind (fw-counts fw-total)
      (read-bin-u16-counts '("data/fineweb/stage1/train_00000.bin"
                             "data/fineweb/stage1/train_00001.bin"
                             "data/fineweb/stage1/train_00002.bin")
                           vocab)
    (format t "2/4 Auditing entity pools...~%")
    (multiple-value-bind (bn-cnts bn-stats) (pool-token-stats bpe (asem-retrieval::broad-pool :names))
      (multiple-value-bind (bt-cnts bt-stats) (pool-token-stats bpe (asem-retrieval::broad-pool :towns))
        (multiple-value-bind (vw-cnts vw-stats) (pool-token-stats bpe (asem-retrieval:vocab-words-of bpe))
          (multiple-value-bind (sn-cnts sn-stats) (pool-token-stats bpe (asem-qagen:synthetic-pool 'asem-qagen:*names*))
            (multiple-value-bind (tn-cnts tn-stats) (pool-token-stats bpe (asem-qagen:split-pool asem-qagen:*names* :train))
              (multiple-value-bind (dn-cnts dn-stats) (pool-token-stats bpe (d1-names-list))
                (multiple-value-bind (nn-cnts nn-stats) (pool-token-stats bpe (asem-retrieval::new-pool :names))
                  (format t "3/4 Auditing R7 generator (75k + 15k copy)...~%")
                  (multiple-value-bind (r7-all r7-ans r7-copy r7-task-summary) (run-r7-audit bpe vocab)
                    (format t "4/4 Auditing Pilot 3 data-train.sexp (16k)...~%")
                    (multiple-value-bind (p3-all p3-ans p3-summary) (run-p3-audit bpe vocab)
                      (declare (ignore bt-cnts vw-cnts sn-cnts tn-cnts nn-cnts))
                      (let ((tokens-vec
                              (coerce
                               (loop for i below vocab
                                     for dec = (asem-bpe:bpe-decode bpe (list i))
                                     collect (obj "id" i
                                                  "str" dec
                                                  "shape" (token-shape i dec)
                                                  "fw_train" (aref fw-counts i)
                                                  "r7_ret_all" (aref r7-all i)
                                                  "r7_ret_ans" (aref r7-ans i)
                                                  "r7_copy" (aref r7-copy i)
                                                  "p3_all" (aref p3-all i)
                                                  "p3_ans" (aref p3-ans i)
                                                  "broad_names_tok_types" (aref bn-cnts i)
                                                  "d1_names_tok_types" (aref dn-cnts i)))
                               'vector)))
                        (with-open-file (out "docs/results/stage2/mission-20261111/pilot4/audit_raw.json"
                                             :direction :output :if-exists :supersede :if-does-not-exist :create :external-format :utf-8)
                          (asem-json:write-json
                           (obj "schema" "asem-pilot4-data-audit-raw-1"
                                "fineweb_train_total_tokens" fw-total
                                "pools" (obj "broad_names" bn-stats
                                             "broad_towns" bt-stats
                                             "vocab_words" vw-stats
                                             "synthetic_names" sn-stats
                                             "qagen_train_names" tn-stats
                                             "d1_dev_names" dn-stats
                                             "new_pool_names" nn-stats)
                                "r7" r7-task-summary
                                "pilot3" p3-summary
                                "vocab_tokens" tokens-vec)
                           out)
                          (terpri out))
                        (format t "Wrote docs/results/stage2/mission-20261111/pilot4/audit_raw.json~%")))))))))))))
