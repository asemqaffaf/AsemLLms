;;;; Build and freeze the Pilot 4 Independent 7-Probe Evaluation Suite.
;;;; NEVER reads confirmation.sexp, test.jsonl, test.lock, or qagen.lisp :test splits.
(let ((here (truename "lisp/bin/")))
  (require :sb-posix)
  (dolist (f '("util" "sha256" "json" "bpe" "data" "qagen" "retrieval" "tf32" "train32" "pretrain32" "sft32" "qa-analysis" "wording" "mission-data"))
    (load (merge-pathnames (format nil "../src/~a.lisp" f) here))))

(defpackage :pilot4-eval-build (:use :cl))
(in-package :pilot4-eval-build)

(defun obj (&rest kvs) (apply #'asem-mission-data:obj kvs))
(defun vec (xs) (coerce xs 'vector))

(defun load-json (path)
  (with-open-file (in path :external-format :utf-8)
    (let* ((s (make-string (file-length in)))
           (n (read-sequence s in)))
      (asem-json:parse-json (subseq s 0 n)))))

(defun find-attr (kw) (find kw asem-qagen::*attr-types* :key #'car))
(defun find-num (kw) (find kw asem-qagen::*num-types* :key #'car))

(defun extract-cap-words (str tbl)
  "Insert every ASCII alphabetic capitalized word (len >= 2) from STR into hash-table TBL."
  (let ((n (length str))
        (i 0))
    (loop while (< i n)
          for ch = (char str i)
          do (if (alpha-char-p ch)
                 (let ((j i))
                   (loop while (and (< j n) (alpha-char-p (char str j))) do (incf j))
                   (when (and (>= (- j i) 2) (upper-case-p (char str i)))
                     (setf (gethash (subseq str i j) tbl) t))
                   (setf i j))
                 (incf i)))))

(defun build-exclusions (bpe)
  "Collect every entity/word from non-test datasets and training pools (NEVER reads :test)."
  (let ((excl (make-hash-table :test 'equalp)))
    (dolist (p '("docs/results/stage2/mission-20261111/pilot2/d1-entities.txt"
                 "docs/results/stage2/mission-20261111/pilot3/excluded-extra.txt"))
      (with-open-file (in p)
        (loop for l = (read-line in nil) while l
              for tr = (string-trim '(#\Space #\Return #\Newline) l)
              when (plusp (length tr)) do (setf (gethash tr excl) t))))
    (dolist (jp (append (list #P"lisp/eval/qa/dev.jsonl"
                              #P"docs/results/stage2/mission-20261111/pilot3/probe-fresh-500.jsonl"
                              #P"docs/results/stage2/mission-20261111/pilot3/probe-seen-500.jsonl")
                        (directory "docs/results/stage2/diagnostics-20261113/*.jsonl")))
      (when (probe-file jp)
        (with-open-file (in jp)
          (loop for l = (read-line in nil) while l
                when (plusp (length l))
                do (let ((o (asem-json:parse-json l)))
                     (when (asem-json:json-get o "options")
                       (loop for opt across (asem-json:json-get o "options") do (setf (gethash opt excl) t)))
                     (when (asem-json:json-get o "passage")
                       (extract-cap-words (asem-json:json-get o "passage") excl))
                     (when (asem-json:json-get o "answer_text")
                       (setf (gethash (asem-json:json-get o "answer_text") excl) t)))))))
    (dolist (it (asem-mission-data:read-data "docs/results/stage2/mission-20261111/selection.sexp"))
      (dolist (o (getf it :options)) (setf (gethash o excl) t))
      (when (getf it :answer-text) (setf (gethash (getf it :answer-text) excl) t))
      (when (getf it :passage) (extract-cap-words (getf it :passage) excl)))
    (dolist (it (asem-mission-data:read-data "data/runs/retrieval/p3-learnability/data-train.sexp"))
      (when (and (listp it) (listp (first it)))
        (extract-cap-words (asem-bpe:bpe-decode bpe (first it)) excl)))
    ;; Non-test qagen pools + retrieval pools
    (dolist (sym '(asem-qagen:*names* asem-qagen::*towns* asem-qagen::*jobs* asem-qagen::*pets*
                   asem-qagen::*colors* asem-qagen::*instruments* asem-qagen::*places*))
      (dolist (sp '(:train :dev))
        (dolist (x (asem-qagen:split-pool (symbol-value sym) sp))
          (setf (gethash x excl) t))))
    (dolist (x (asem-retrieval::broad-pool :names)) (setf (gethash x excl) t))
    (dolist (x (asem-retrieval::broad-pool :towns)) (setf (gethash x excl) t))
    (dolist (x (asem-retrieval::new-pool :names)) (setf (gethash x excl) t))
    (dolist (x (asem-retrieval::new-pool :towns)) (setf (gethash x excl) t))
    (dolist (w (asem-retrieval:vocab-words-of bpe)) (setf (gethash w excl) t))
    excl))

(defun shuffle-vec (lst rng)
  (let ((v (coerce lst 'vector)))
    (loop for i from (1- (length v)) downto 1
          do (rotatef (aref v i) (aref v (random (1+ i) rng))))
    (coerce v 'list)))

(defun build-recomb-names (bpe title-ids tail-ids excl existing-words needed rng)
  "Construct BPE-verified 2-token TitleCase words [title-id, tail-id] disjoint from EXCL and EXISTING-WORDS."
  (let ((tvec (shuffle-vec (coerce title-ids 'list) rng))
        (evec (shuffle-vec (coerce tail-ids 'list) rng))
        (out nil)
        (seen (make-hash-table :test 'equalp)))
    (dolist (w existing-words) (setf (gethash w seen) t))
    (let ((nt (length tvec)) (ne (length evec)))
      (block outer
        (dotimes (step (* nt ne))
          (let* ((a (nth (mod step nt) tvec))
                 (b (nth (mod (+ (floor step nt) (* 7 step)) ne) evec))
                 (sa (asem-bpe:bpe-decode bpe (list a)))
                 (sb (asem-bpe:bpe-decode bpe (list b)))
                 (raw (concatenate 'string sa sb))
                 (w (string-trim '(#\Space) raw)))
            (when (and (>= (length w) 4) (<= (length w) 12)
                       (upper-case-p (char w 0))
                       (every #'lower-case-p (subseq w 1))
                       (not (gethash w excl))
                       (not (gethash w seen))
                       (equal (asem-bpe:bpe-encode bpe raw) (list a b)))
              (setf (gethash w seen) t)
              (push w out)
              (when (>= (length out) needed) (return-from outer)))))))
    (nreverse out)))

(defun sample-distinct-from (vec ptr count &key exclude)
  "Return (values list new-ptr) taking COUNT unique items from cyclic vector VEC excluding EXCLUDE."
  (let ((out nil) (n (length vec)) (guard 0))
    (loop while (< (length out) count)
          do (when (> (incf guard) (* 4 n)) (error "Unable to sample ~d distinct items" count))
             (let ((cand (aref vec (mod ptr n))))
               (incf ptr)
               (unless (or (member cand out :test #'string=)
                           (and exclude (member cand exclude :test #'string=)))
                 (push cand out))))
    (values (nreverse out) ptr)))

(defun make-choice-item (id wording category subtype passage question options gold-idx sframe qframe &optional extra-tag)
  (let ((letters '("A" "B" "C" "D")))
    (list :id id :split "dev" :wording wording :category category :subtype subtype
          :passage passage :question question
          :options options :answer gold-idx :answer-letter (nth gold-idx letters)
          :answer-text (nth gold-idx options)
          :sframe sframe :qframe qframe :tag (or extra-tag ""))))

(defun item-max-tok-len (bpe item)
  (let ((passage (getf item :passage))
        (q (getf item :question))
        (opts (getf item :options))
        (m 0))
    (let ((p-hdr (format nil "Text: ~a~%Q: ~a~%A. ~a~%B. ~a~%C. ~a~%D. ~a~%The answer is"
                         passage q (first opts) (second opts) (third opts) (fourth opts))))
      (dolist (o opts)
        (let ((len (1+ (length (asem-bpe:bpe-encode bpe (concatenate 'string p-hdr " " o))))))
          (when (> len m) (setf m len))))
      m)))

(defun write-compact-json (v s)
  (cond ((stringp v) (write-string (asem-json::json-string v) s))
        ((integerp v) (format s "~d" v))
        ((vectorp v)
         (write-char #\[ s)
         (dotimes (i (length v))
           (when (plusp i) (write-char #\, s))
           (write-compact-json (aref v i) s))
         (write-char #\] s))
        ((and (consp v) (eq (car v) :obj))
         (write-char #\{ s)
         (loop for ((k . val) . rest) on (cdr v)
               do (write-string (asem-json::json-string k) s)
                  (write-char #\: s)
                  (write-compact-json val s)
                  (when rest (write-char #\, s)))
         (write-char #\} s))
        (t (error "Bad compact json value ~s" v))))

(defun write-probe-jsonl (path items)
  (ensure-directories-exist path)
  (with-open-file (out path :direction :output :if-exists :supersede :if-does-not-exist :create :external-format :utf-8)
    (dolist (it items)
      (write-compact-json
       (obj "answer" (getf it :answer)
            "answer_letter" (getf it :answer-letter)
            "answer_text" (getf it :answer-text)
            "category" (getf it :category)
            "cf_answer" 0
            "cf_question" ""
            "facts" "()"
            "id" (getf it :id)
            "options" (vec (getf it :options))
            "passage" (getf it :passage)
            "qframe" (getf it :qframe)
            "query" "()"
            "question" (getf it :question)
            "sframe" (getf it :sframe)
            "split" (getf it :split)
            "subtype" (getf it :subtype)
            "tag" (getf it :tag)
            "wording" (getf it :wording))
       out)
      (terpri out))))

(defun rotated-options (list-of-4 gold-orig-idx target-ans-pos)
  "Reorder 4 distinct items so that element at GOLD-ORIG-IDX lands at TARGET-ANS-POS."
  (let* ((shift (mod (- target-ans-pos gold-orig-idx) 4))
         (arr (make-array 4)))
    (dotimes (j 4) (setf (aref arr (mod (+ j shift) 4)) (nth j list-of-4)))
    (coerce arr 'list)))

(defun main ()
  (let* ((bpe (asem-bpe:load-bpe "data/fineweb/stage1/tokenizer.bpe"))
         (audit (load-json "docs/results/stage2/mission-20261111/pilot4/audit_raw.json"))
         (part (load-json "docs/results/stage2/mission-20261111/pilot4/subword_partition.json"))
         (toks (asem-json:json-get audit "vocab_tokens"))
         (r7-cnt (make-array 8192 :initial-element 0))
         (p3-cnt (make-array 8192 :initial-element 0))
         (excl (build-exclusions bpe))
         (rng (sb-ext:seed-random-state 20261113)))
    (loop for tk across toks for id = (asem-json:json-get tk "id")
          do (setf (aref r7-cnt id) (asem-json:json-get tk "r7_ret_all")
                   (aref p3-cnt id) (asem-json:json-get tk "p3_all")))

    (let* (;; Disjoint synthetic-pool *names* with all subwords >=100 in R7 & P3
           (synth-n-seen100
             (shuffle-vec
              (remove-if-not
               (lambda (x)
                 (and (not (gethash x excl))
                      (let ((ids (asem-bpe:bpe-encode bpe (concatenate 'string " " x))))
                        (every (lambda (id) (and (>= (aref r7-cnt id) 100) (>= (aref p3-cnt id) 100))) ids))))
               (asem-qagen:synthetic-pool 'asem-qagen:*names*))
              rng))
           (synth-t-all
             (shuffle-vec
              (remove-if (lambda (x) (gethash x excl)) (asem-qagen:synthetic-pool 'asem-qagen::*towns*))
              rng))
           ;; Partition Train-Copy vs Eval-Heldout tokens & words
           (tr-part (asem-json:json-get part "train_copy"))
           (ev-part (asem-json:json-get part "eval_heldout"))
           (tr-title (asem-json:json-get tr-part "space_title_alpha"))
           (tr-tail (asem-json:json-get tr-part "bare_lower_alpha"))
           (ev-title (asem-json:json-get ev-part "space_title_alpha"))
           (ev-tail (asem-json:json-get ev-part "bare_lower_alpha"))
           (fw-tr-set (let ((h (make-hash-table :test 'equalp)))
                        (loop for x across (asem-json:json-get part "fw_tr_only_2tok")
                              do (setf (gethash (asem-json:json-get x "word") h) t))
                        (loop for x across (asem-json:json-get part "fw_tr_only_3tok")
                              do (setf (gethash (asem-json:json-get x "word") h) t))
                        h))
           (fw-ev-all
             (let ((xs nil))
               (loop for x across (asem-json:json-get part "fw_ev_only_2tok")
                     for w = (asem-json:json-get x "word")
                     for ids = (coerce (asem-json:json-get x "ids") 'list)
                     when (and (not (gethash w excl))
                               (equal (asem-bpe:bpe-encode bpe (concatenate 'string " " w)) ids))
                     do (push w xs))
               (nreverse xs)))
           (fw-ev-3tok
             (let ((xs nil))
               (loop for x across (asem-json:json-get part "fw_ev_only_3tok")
                     for w = (asem-json:json-get x "word")
                     for ids = (coerce (asem-json:json-get x "ids") 'list)
                     when (and (not (gethash w excl))
                               (equal (asem-bpe:bpe-encode bpe (concatenate 'string " " w)) ids))
                     do (push w xs))
               (nreverse xs)))
           (recomb-tr-eval
             (build-recomb-names bpe tr-title tr-tail excl
                                 (loop for k being the hash-keys of fw-tr-set collect k)
                                 320 rng))
           (recomb-ev-extra
             (build-recomb-names bpe ev-title ev-tail excl fw-ev-all 180 rng)))

      (format t "Pools ready: synth_n_seen100=~d synth_t=~d fw_ev_2=~d fw_ev_3=~d recomb_tr=~d recomb_ev=~d~%"
              (length synth-n-seen100) (length synth-t-all)
              (length fw-ev-all) (length fw-ev-3tok)
              (length recomb-tr-eval) (length recomb-ev-extra))
      (assert (>= (length synth-n-seen100) 500))
      (assert (>= (length synth-t-all) 350))
      (assert (>= (length fw-ev-all) 105))
      (assert (>= (length recomb-tr-eval) 300))
      (assert (>= (length recomb-ev-extra) 150))

      ;; Split disjoint people slices across probes where cleanliness matters
      ;; Ev heldout targets: [0..50) -> fresh_ans_before, [50..110) -> entity_copy s1 (60) + fw_ev_3tok (5) + recomb_ev (15) = 80
      (let* ((ev-fresh-targs (coerce (subseq fw-ev-all 0 50) 'vector))
             (ev-copy-s1-targs (coerce (append (subseq fw-ev-all 50 110)
                                               (subseq fw-ev-3tok 0 (min 5 (length fw-ev-3tok)))
                                               (subseq recomb-ev-extra 0 (- 80 (- 60 0) (min 5 (length fw-ev-3tok)))))
                                       'vector))
             (ev-l3-copy-targs (coerce (subseq recomb-ev-extra 30 60) 'vector))
             (ev-dist-pool (coerce (subseq recomb-ev-extra 60) 'vector))
             (tr-fresh-pool (coerce (subseq recomb-tr-eval 0 120) 'vector))
             (tr-copy-s1-targs (coerce (subseq recomb-tr-eval 120 200) 'vector))
             (tr-l3-copy-targs (coerce (subseq recomb-tr-eval 200 230) 'vector))
             (tr-dist-pool (coerce (subseq recomb-tr-eval 230) 'vector))
             (sn-vec (coerce synth-n-seen100 'vector))
             (st-vec (coerce synth-t-all 'vector))
             (sn-ptr 50) (st-ptr 0)
             (vf-s-frames '((:town . ((:train . ("In {V} lives {P}." "{V} is where {P} lives."))
                                      (:dev   . ("{V} is the place where {P} resides."))))
                            (:instrument . ((:train . ("The {V} is the instrument {P} plays."))
                                            (:dev   . ("The {V} is the instrument {P} plays."))))
                            (:color . ((:train . ("{V} is the favorite color of {P}."))
                                       (:dev   . ("{V} is the favorite color of {P}."))))))
             (pf-attr-sframes
              (lambda (ty sp)
                (let ((all (getf (getf (cdr ty) :frames) sp))
                      (bad '("In {V} lives {P}." "{V} is where {P} lives." "{V} is the place where {P} resides."
                             "The {V} is the instrument {P} plays." "{V} is the favorite color of {P}.")))
                  (remove-if (lambda (f) (member f bad :test #'string=)) all))))
             (dev-val-pool (lambda (ty)
                             (if (eq (car ty) :town)
                                 synth-t-all
                                 (asem-qagen:split-pool (symbol-value (getf (cdr ty) :pool)) :dev))))
             (fresh-items nil)
             (copy-items nil)
             (extract-items nil)
             (relation-items nil)
             (reverse-items nil)
             (compare-items nil)
             (temporal-items nil))

        ;; 1. FRESH_ANS_BEFORE (n=300: 150 L3 pf-reverse + 150 L3 vf-extract)
        (let ((attrs '(:town :job :pet :color :instrument))
              (reg-i 0))
          ;; 150 L3 pf-reverse across 3 subword regimes x 50
          (dolist (reg-spec (list (list "seen100" sn-vec)
                                  (list "recomb_tr" tr-fresh-pool)
                                  (list "heldout_ev" ev-fresh-targs)))
            (destructuring-bind (rtag tvec) reg-spec
              (dotimes (k 50)
                (let* ((idx (+ (* 50 reg-i) k))
                       (akw (nth (mod k 5) attrs))
                       (ty (find-attr akw))
                       (sp (if (< k 25) :train :dev))
                       (slot (mod idx 4))
                       (ans-pos (mod (+ idx (floor k 4)) 4))
                       (gold (if (string= rtag "heldout_ev")
                                 (aref tvec k)
                                 (prog1 (aref tvec (mod (* k 1) (length tvec))) nil)))
                       (dist-pool (cond ((string= rtag "seen100") sn-vec)
                                        ((string= rtag "recomb_tr") tr-fresh-pool)
                                        (t ev-dist-pool)))
                       (dists (let ((res nil) (p (+ (* 7 idx) 1)) (nl (length dist-pool)))
                                (loop while (< (length res) 3)
                                      for c = (aref dist-pool (mod p nl))
                                      do (incf p)
                                         (unless (or (string= c gold) (member c res :test #'string=))
                                           (push c res)))
                                (nreverse res)))
                       (people (let ((arr (make-array 4)) (di 0))
                                 (setf (aref arr slot) gold)
                                 (dotimes (s 4) (unless (= s slot) (setf (aref arr s) (nth di dists)) (incf di)))
                                 (coerce arr 'list)))
                       (vpool (coerce (funcall dev-val-pool ty) 'vector))
                       (vals (multiple-value-bind (vs np) (sample-distinct-from vpool (+ st-ptr (* 3 idx)) 4)
                               (declare (ignore np)) vs))
                       (sfs (funcall pf-attr-sframes ty sp))
                       (qf (let ((qs (getf (getf (cdr ty) :q-reverse) sp))) (nth (mod idx (length qs)) qs)))
                       (sents (loop for p in people for v in vals for j from 0
                                    collect (asem-qagen::fill-frame (nth (mod (+ idx j) (length sfs)) sfs) :p p :v v)))
                       (passage (format nil "~{~a~^ ~}" sents))
                       (question (asem-qagen::fill-frame qf :v (nth slot vals)))
                       (opts (rotated-options people slot ans-pos)))
                  (push (make-choice-item (format nil "p4-fab-pf-~3,'0d" idx)
                                          (if (eq sp :dev) "dev" "seen")
                                          "fresh_ans_before"
                                          (format nil "pf-rev-~(~a~)-~a" akw rtag)
                                          passage question opts ans-pos
                                          (nth (mod idx (length sfs)) sfs) qf rtag)
                        fresh-items))))
            (incf reg-i))
          ;; 150 L3 vf-extract (75 :town, 75 :instrument, half :train / half :dev)
          (dotimes (k 150)
            (let* ((akw (if (< k 75) :town :instrument))
                   (ty (find-attr akw))
                   (sp (if (zerop (mod k 2)) :train :dev))
                   (slot (mod k 4))
                   (ans-pos (mod (+ k 1 (floor k 4)) 4))
                   (people (multiple-value-bind (ps np) (sample-distinct-from sn-vec sn-ptr 4)
                             (setf sn-ptr np) ps))
                   (vpool (coerce (funcall dev-val-pool ty) 'vector))
                   (vals (multiple-value-bind (vs np) (sample-distinct-from vpool st-ptr 4)
                           (incf st-ptr 4) vs))
                   (vfs (cdr (assoc sp (cdr (assoc akw vf-s-frames)))))
                   (qfs (getf (getf (cdr ty) :q-extract) sp))
                   (qf (nth (mod k (length qfs)) qfs))
                   (sents (loop for p in people for v in vals for j from 0
                                collect (asem-qagen::fill-frame (nth (mod (+ k j) (length vfs)) vfs) :p p :v v)))
                   (passage (format nil "~{~a~^ ~}" sents))
                   (question (asem-qagen::fill-frame qf :p (nth slot people)))
                   (opts (rotated-options vals slot ans-pos)))
              (push (make-choice-item (format nil "p4-fab-vf-~3,'0d" k)
                                      (if (eq sp :dev) "dev" "seen")
                                      "fresh_ans_before"
                                      (format nil "vf-ext-~(~a~)" akw)
                                      passage question opts ans-pos
                                      (first vfs) qf "seen100")
                    fresh-items))))
        (setf fresh-items (nreverse fresh-items))

        ;; 2. ENTITY_COPY (n=300: 80 seen100 s1 + 80 recomb_tr s1 + 80 heldout_ev s1 + 60 L3 copy)
        (let ((idx 0))
          (dolist (spec (list (list "seen_synth" sn-vec 80 t)
                              (list "recomb_tr" tr-copy-s1-targs 80 t)
                              (list "heldout_ev" ev-copy-s1-targs 80 t)))
            (destructuring-bind (rtag tvec cnt is-s1) spec
              (declare (ignore is-s1))
              (dotimes (k cnt)
                (let* ((targ (aref tvec k))
                       (town (aref st-vec (mod (+ st-ptr k) (length st-vec))))
                       (ans-before-p (zerop (mod k 2)))
                       (sent (if ans-before-p
                                 (format nil "~a lives in ~a." targ town)
                                 (format nil "In ~a lives ~a." town targ)))
                       (passage sent)
                       (question (format nil "Who lives in ~a?" town))
                       (dists (multiple-value-bind (ds np)
                                  (sample-distinct-from (cond ((string= rtag "seen_synth") sn-vec)
                                                              ((string= rtag "recomb_tr") tr-dist-pool)
                                                              (t ev-dist-pool))
                                                        (+ idx 17) 3 :exclude (list targ))
                                (declare (ignore np)) ds))
                       (opts (rotated-options (cons targ dists) 0 (mod idx 4))))
                  (push (make-choice-item (format nil "p4-cpy-s1-~3,'0d" idx)
                                          "dev" "entity_copy"
                                          (format nil "s1-~a-~a" rtag (if ans-before-p "pf" "vf"))
                                          passage question opts (mod idx 4)
                                          (if ans-before-p "{P} lives in {V}." "In {V} lives {P}.")
                                          "Who lives in {V}?" rtag)
                        copy-items)
                  (incf idx)))
              (incf st-ptr cnt)))
          ;; 60 L3 copy under 3 distractors (30 recomb_tr + 30 heldout_ev)
          (dolist (spec (list (list "L3_recomb_tr" tr-l3-copy-targs tr-dist-pool)
                              (list "L3_heldout_ev" ev-l3-copy-targs ev-dist-pool)))
            (destructuring-bind (rtag tvec dvec) spec
              (dotimes (k 30)
                (let* ((targ (aref tvec k))
                       (slot (mod k 4))
                       (ans-pos (mod (+ idx k) 4))
                       (ds (multiple-value-bind (xs np) (sample-distinct-from dvec (+ (* 5 idx) 3) 3 :exclude (list targ))
                             (declare (ignore np)) xs))
                       (people (let ((arr (make-array 4)) (di 0))
                                 (setf (aref arr slot) targ)
                                 (dotimes (s 4) (unless (= s slot) (setf (aref arr s) (nth di ds)) (incf di)))
                                 (coerce arr 'list)))
                       (towns (multiple-value-bind (ts np) (sample-distinct-from st-vec st-ptr 4)
                                (incf st-ptr 4) ts))
                       (passage (format nil "~{~a~^ ~}"
                                        (loop for p in people for tw in towns collect (format nil "~a lives in ~a." p tw))))
                       (question (format nil "Who lives in ~a?" (nth slot towns)))
                       (opts (rotated-options people slot ans-pos)))
                  (push (make-choice-item (format nil "p4-cpy-s4-~3,'0d" idx)
                                          "dev" "entity_copy" rtag
                                          passage question opts ans-pos
                                          "{P} lives in {V}." "Who lives in {V}?" rtag)
                        copy-items)
                  (incf idx))))))
        (setf copy-items (nreverse copy-items))

        ;; 3. EXTRACT_RET (n=200: 125 :attr + 75 :num, ans_after, half :train / half :dev, 4 people -> L3/L4)
        (let ((attrs '(:town :job :pet :color :instrument))
              (nums '(:age :score :height)))
          (dotimes (k 125)
            (let* ((akw (nth (mod k 5) attrs))
                   (ty (find-attr akw))
                   (sp (if (zerop (mod k 2)) :train :dev))
                   (with-extra (< (mod k 3) 1))
                   (slot (mod k 4))
                   (ans-pos (mod (+ k 2 (floor k 4)) 4))
                   (people (multiple-value-bind (ps np) (sample-distinct-from sn-vec sn-ptr 4)
                             (setf sn-ptr np) ps))
                   (vpool (coerce (funcall dev-val-pool ty) 'vector))
                   (vals (multiple-value-bind (vs np) (sample-distinct-from vpool st-ptr 4)
                           (incf st-ptr 4) vs))
                   (sfs (funcall pf-attr-sframes ty sp))
                   (qfs (getf (getf (cdr ty) :q-extract) sp))
                   (qf (nth (mod k (length qfs)) qfs))
                   (s1 (loop for p in people for v in vals for j from 0
                             collect (asem-qagen::fill-frame (nth (mod (+ k j) (length sfs)) sfs) :p p :v v)))
                   (s2 (when with-extra
                         (let* ((tyb (find-attr (nth (mod (1+ k) 5) attrs)))
                                (vp2 (coerce (funcall dev-val-pool tyb) 'vector))
                                (vs2 (multiple-value-bind (vs np) (sample-distinct-from vp2 (+ st-ptr 13) 4)
                                       (declare (ignore np)) vs))
                                (sfb (funcall pf-attr-sframes tyb sp)))
                           (loop for p in people for v in vs2 for j from 0
                                 collect (asem-qagen::fill-frame (nth (mod (+ k j) (length sfb)) sfb) :p p :v v)))))
                   (opts (rotated-options vals slot ans-pos))
                   (question (asem-qagen::fill-frame qf :p (nth slot people)))
                   (passage
                    (block pick-p
                      (dolist (cand (if s2
                                        (list (format nil "~{~a~^ ~}" (append s1 (subseq s2 0 2)))
                                              (format nil "~{~a~^ ~}" (append s1 (subseq s2 0 1)))
                                              (format nil "~{~a~^ ~}" s1))
                                        (list (format nil "~{~a~^ ~}" s1))))
                        (let ((tmp (make-choice-item "tmp" "seen" "extract_ret" "x" cand question opts ans-pos (first sfs) qf "ans_after")))
                          (when (<= (item-max-tok-len bpe tmp) 122)
                            (return-from pick-p cand))))
                      (format nil "~{~a~^ ~}" s1))))
              (push (make-choice-item (format nil "p4-ext-attr-~3,'0d" k)
                                      (if (eq sp :dev) "dev" "seen")
                                      "extract_ret"
                                      (format nil "ext-~(~a~)" akw)
                                      passage question opts ans-pos (first sfs) qf "ans_after")
                    extract-items)))
          (dotimes (k 75)
            (let* ((nkw (nth (mod k 3) nums))
                   (ty (find-num nkw))
                   (sp (if (zerop (mod k 2)) :train :dev))
                   (slot (mod k 4))
                   (ans-pos (mod (+ k 1 (floor k 4)) 4))
                   (people (multiple-value-bind (ps np) (sample-distinct-from sn-vec sn-ptr 4)
                             (setf sn-ptr np) ps))
                   (rng-pair (getf (cdr ty) :range))
                   (vals (mapcar #'princ-to-string
                                 (asem-qagen::distinct-numbers (first rng-pair) (second rng-pair) 4 rng)))
                   (sfs (getf (getf (cdr ty) :frames) sp))
                   (qfs (getf (getf (cdr ty) :q-extract) sp))
                   (qf (nth (mod k (length qfs)) qfs))
                   (sents (loop for p in people for v in vals for j from 0
                                collect (asem-qagen::fill-frame (nth (mod (+ k j) (length sfs)) sfs) :p p :n v)))
                   (passage (format nil "~{~a~^ ~}" sents))
                   (question (asem-qagen::fill-frame qf :p (nth slot people)))
                   (opts (rotated-options vals slot ans-pos)))
              (push (make-choice-item (format nil "p4-ext-num-~3,'0d" k)
                                      (if (eq sp :dev) "dev" "seen")
                                      "extract_ret"
                                      (format nil "ext-~(~a~)" nkw)
                                      passage question opts ans-pos (first sfs) qf "ans_after")
                    extract-items))))
        (setf extract-items (nreverse extract-items))

        ;; 4. RELATION_RET (n=200: 6 verbs, 100 subj/obj, 100 pairs/chain, half :train/:dev)
        (dotimes (k 200)
          (let* ((rel (nth (mod k (length asem-qagen::*relations*)) asem-qagen::*relations*))
                 (chain (zerop (mod (floor k 6) 2)))
                 (subj (zerop (mod k 2)))
                 (sp (if (< (mod k 4) 2) :train :dev))
                 (people (multiple-value-bind (ps np) (sample-distinct-from sn-vec sn-ptr 4)
                           (setf sn-ptr np) ps))
                 (facts (if chain
                            (list (list (first people) (second people))
                                  (list (second people) (third people))
                                  (list (third people) (fourth people)))
                            (list (list (first people) (second people))
                                  (list (third people) (fourth people)))))
                 (frames (getf (getf (cdr rel) :frames) sp))
                 (sents (shuffle-vec
                         (loop for f in facts for j from 0
                               collect (asem-qagen::fill-frame (nth (mod (+ k j) (length frames)) frames)
                                                               :a (first f) :b (second f)))
                         rng))
                 (qf (let ((qs (getf (getf (cdr rel) (if subj :q-subj :q-obj)) sp)))
                       (nth (mod k (length qs)) qs)))
                 (fi (mod (floor k 2) (length facts)))
                 (fpair (nth fi facts))
                 (gold (if subj (first fpair) (second fpair)))
                 (gpos (position gold people :test #'string=))
                 (ans-pos (mod (+ k (floor k 4)) 4))
                 (opts (rotated-options people gpos ans-pos))
                 (passage (format nil "~{~a~^ ~}" sents))
                 (question (if subj (asem-qagen::fill-frame qf :b (second fpair))
                               (asem-qagen::fill-frame qf :a (first fpair)))))
            (push (make-choice-item (format nil "p4-rel-~3,'0d" k)
                                    (if (eq sp :dev) "dev" "seen")
                                    "relation_ret"
                                    (format nil "~(~a~)-~a-~a" (car rel) (if chain "chain" "pairs") (if subj "subj" "obj"))
                                    passage question opts ans-pos (first frames) qf (if chain "chain" "pairs"))
                  relation-items)))
        (setf relation-items (nreverse relation-items))

        ;; 5. REVERSE_RET (n=200: 100 vf-reverse [ans_after] + 100 pf-reverse [ans_before], seen100 people)
        (dotimes (k 100)
          ;; vf-reverse (50 :town, 25 :instrument, 25 :color)
          (let* ((akw (cond ((< k 50) :town) ((< k 75) :instrument) (t :color)))
                 (ty (find-attr akw))
                 (sp (if (zerop (mod k 2)) :train :dev))
                 (slot (mod k 4))
                 (ans-pos (mod (+ k 1 (floor k 4)) 4))
                 (people (multiple-value-bind (ps np) (sample-distinct-from sn-vec sn-ptr 4)
                           (setf sn-ptr np) ps))
                 (vpool (coerce (funcall dev-val-pool ty) 'vector))
                 (vals (multiple-value-bind (vs np) (sample-distinct-from vpool st-ptr 4)
                         (incf st-ptr 4) vs))
                 (vfs (cdr (assoc sp (cdr (assoc akw vf-s-frames)))))
                 (qfs (getf (getf (cdr ty) :q-reverse) sp))
                 (qf (nth (mod k (length qfs)) qfs))
                 (sents (loop for p in people for v in vals for j from 0
                              collect (asem-qagen::fill-frame (nth (mod (+ k j) (length vfs)) vfs) :p p :v v)))
                 (passage (format nil "~{~a~^ ~}" sents))
                 (question (asem-qagen::fill-frame qf :v (nth slot vals)))
                 (opts (rotated-options people slot ans-pos)))
            (push (make-choice-item (format nil "p4-rev-vf-~3,'0d" k)
                                    (if (eq sp :dev) "dev" "seen")
                                    "reverse_ret"
                                    (format nil "vf-rev-~(~a~)" akw)
                                    passage question opts ans-pos (first vfs) qf "ans_after")
                  reverse-items)))
        (dotimes (k 100)
          ;; pf-reverse (20 each of 5 attrs, seen100 people)
          (let* ((akw (nth (mod k 5) '(:town :job :pet :color :instrument)))
                 (ty (find-attr akw))
                 (sp (if (zerop (mod k 2)) :train :dev))
                 (slot (mod k 4))
                 (ans-pos (mod (+ k 3 (floor k 4)) 4))
                 (people (multiple-value-bind (ps np) (sample-distinct-from sn-vec sn-ptr 4)
                           (setf sn-ptr np) ps))
                 (vpool (coerce (funcall dev-val-pool ty) 'vector))
                 (vals (multiple-value-bind (vs np) (sample-distinct-from vpool st-ptr 4)
                         (incf st-ptr 4) vs))
                 (sfs (funcall pf-attr-sframes ty sp))
                 (qfs (getf (getf (cdr ty) :q-reverse) sp))
                 (qf (nth (mod k (length qfs)) qfs))
                 (sents (loop for p in people for v in vals for j from 0
                              collect (asem-qagen::fill-frame (nth (mod (+ k j) (length sfs)) sfs) :p p :v v)))
                 (passage (format nil "~{~a~^ ~}" sents))
                 (question (asem-qagen::fill-frame qf :v (nth slot vals)))
                 (opts (rotated-options people slot ans-pos)))
            (push (make-choice-item (format nil "p4-rev-pf-~3,'0d" k)
                                    (if (eq sp :dev) "dev" "seen")
                                    "reverse_ret"
                                    (format nil "pf-rev-~(~a~)" akw)
                                    passage question opts ans-pos (first sfs) qf "ans_before")
                  reverse-items)))
        (setf reverse-items (nreverse reverse-items))

        ;; 6. COMPARE_RET (n=200: 100 max / 100 min across age/score/height, seen100 people)
        (dotimes (k 200)
          (let* ((nkw (nth (mod k 3) '(:age :score :height)))
                 (ty (find-num nkw))
                 (mx (zerop (mod k 2)))
                 (sp (if (< (mod k 4) 2) :train :dev))
                 (people (multiple-value-bind (ps np) (sample-distinct-from sn-vec sn-ptr 4)
                           (setf sn-ptr np) ps))
                 (rng-pair (getf (cdr ty) :range))
                 (vals (asem-qagen::distinct-numbers (first rng-pair) (second rng-pair) 4 rng))
                 (target-num (reduce (if mx #'max #'min) vals))
                 (gpos (position target-num vals))
                 (ans-pos (mod (+ k (floor k 4)) 4))
                 (sfs (getf (getf (cdr ty) :frames) sp))
                 (qfs (getf (getf (cdr ty) (if mx :q-max :q-min)) sp))
                 (qf (nth (mod k (length qfs)) qfs))
                 (sents (shuffle-vec
                         (loop for p in people for v in vals for j from 0
                               collect (asem-qagen::fill-frame (nth (mod (+ k j) (length sfs)) sfs) :p p :n v))
                         rng))
                 (passage (format nil "~{~a~^ ~}" sents))
                 (question (asem-qagen::fill-frame qf))
                 (opts (rotated-options people gpos ans-pos)))
            (push (make-choice-item (format nil "p4-cmp-~3,'0d" k)
                                    (if (eq sp :dev) "dev" "seen")
                                    "compare_ret"
                                    (format nil "~(~a~)-~a" nkw (if mx "max" "min"))
                                    passage question opts ans-pos (first sfs) qf (if mx "max" "min"))
                  compare-items)))
        (setf compare-items (nreverse compare-items))

        ;; 7. TEMPORAL_RET (n=200: 50 first/last/after/before, :dev places, seen100 people)
        (let ((dev-places (coerce (asem-qagen:split-pool asem-qagen::*places* :dev) 'vector))
              (tkinds '(:first :last :after :before)))
          (dotimes (k 200)
            (let* ((tk (nth (mod k 4) tkinds))
                   (sp (if (< (mod k 8) 4) :train :dev))
                   (p (aref sn-vec (mod (incf sn-ptr) (length sn-vec))))
                   (places (multiple-value-bind (ps np) (sample-distinct-from dev-places (+ (* 4 k) 1) 4)
                             (declare (ignore np)) ps))
                   (f-sf (asem-qagen::pick (getf (getf asem-qagen::*temporal* :first) sp) rng))
                   (m-sfs (getf (getf asem-qagen::*temporal* :middle) sp))
                   (l-sf (asem-qagen::pick (getf (getf asem-qagen::*temporal* :last) sp) rng))
                   (sents (list (asem-qagen::fill-frame f-sf :p p :x (first places))
                                (asem-qagen::fill-frame (nth (mod k (length m-sfs)) m-sfs) :p p :x (second places))
                                (asem-qagen::fill-frame (nth (mod (1+ k) (length m-sfs)) m-sfs) :p p :x (third places))
                                (asem-qagen::fill-frame l-sf :p p :x (fourth places))))
                   (passage (format nil "~{~a~^ ~}" sents)))
              (multiple-value-bind (q qf a query)
                  (asem-qagen::temporal-question tk places sp rng p)
                (declare (ignore query))
                (let* ((gpos (position a places :test #'string=))
                       (ans-pos (mod (+ k (floor k 4)) 4))
                       (opts (rotated-options places gpos ans-pos)))
                  (push (make-choice-item (format nil "p4-tmp-~3,'0d" k)
                                          (if (eq sp :dev) "dev" "seen")
                                          "temporal_ret"
                                          (string-downcase (symbol-name tk))
                                          passage q opts ans-pos f-sf qf (string-downcase (symbol-name tk)))
                        temporal-items))))))
        (setf temporal-items (nreverse temporal-items))

        ;; Verify context limits across ALL 1,600 items
        (let ((max-len 0)
              (all-groups (list (cons "fresh_ans_before" fresh-items)
                                (cons "entity_copy" copy-items)
                                (cons "extract_ret" extract-items)
                                (cons "relation_ret" relation-items)
                                (cons "reverse_ret" reverse-items)
                                (cons "compare_ret" compare-items)
                                (cons "temporal_ret" temporal-items))))
          (dolist (g all-groups)
            (dolist (it (cdr g))
              (let ((l (item-max-tok-len bpe it)))
                (when (> l max-len) (setf max-len l))
                (assert (<= l 124) () "Item ~a exceeded ctx margin: ~d" (getf it :id) l)))
            (let ((out-j (format nil "docs/results/stage2/mission-20261111/pilot4/probes/~a.jsonl" (car g))))
              (write-probe-jsonl out-j (cdr g))))
          (format t "Verified ALL 1,600 items fit safely within ctx=128 (max token length=~d).~%" max-len)

          ;; Verify ZERO leakage of eval_heldout tokens in train_copy, and ZERO overlap of reserved words
          (let ((ev-set (make-hash-table)))
            (dolist (sh '("space_title_alpha" "bare_lower_alpha" "space_lower_alpha" "bare_title_alpha"))
              (loop for id across (asem-json:json-get ev-part sh) do (setf (gethash id ev-set) t))
              (loop for id across (asem-json:json-get tr-part sh)
                    do (assert (not (gethash id ev-set)))))
            ;; Write frozen manifest with SHA-256 checksums of all 7 probe jsonls + reserved eval words
            (let ((reserved-tr (vec recomb-tr-eval))
                  (hashes (loop for g in all-groups
                                for path = (format nil "docs/results/stage2/mission-20261111/pilot4/probes/~a.jsonl" (car g))
                                collect (cons (car g) (asem-sha256:sha256-file-hex path))))
                  (counts (loop for g in all-groups collect (cons (car g) (length (cdr g))))))
              (with-open-file (out "docs/results/stage2/mission-20261111/pilot4/probe_suite_manifest.json"
                                   :direction :output :if-exists :supersede :if-does-not-exist :create :external-format :utf-8)
                (asem-json:write-json
                 (obj "schema" "asem-pilot4-probe-manifest-1"
                      "seed" 20261113
                      "max_item_token_len" max-len
                      "counts" (cons :obj counts)
                      "sha256" (cons :obj hashes)
                      "synth_towns_eval_pool" (vec synth-t-all)
                      "reserved_recomb_tr_words" reserved-tr
                      "reserved_ev_heldout_tokens" (obj "space_title_alpha" ev-title
                                                        "bare_lower_alpha" ev-tail
                                                        "space_lower_alpha" (asem-json:json-get ev-part "space_lower_alpha")
                                                        "bare_title_alpha" (asem-json:json-get ev-part "bare_title_alpha")))
                 out)
                (terpri out)))
            (format t "Wrote probes/*.jsonl and probe_suite_manifest.json.~%")))))))

(main)
