;;;; Inference-only Causal Disentanglement Micro-Probes for Pilot 4 Prep.
;;;; Evaluates frozen checkpoints (R7, P3 arm-5e-4, P3 arm-1e-3, P2 treatment).
;;;; NEVER reads :test splits, confirmation.sexp, or locked test sets.
(let ((here (truename "lisp/bin/")))
  (require :sb-posix)
  (dolist (f '("util" "sha256" "json" "bpe" "data" "qagen" "retrieval" "tf32" "train32" "pretrain32" "sft32" "qa-analysis" "wording" "mission-data"))
    (load (merge-pathnames (format nil "../src/~a.lisp" f) here))))

(defpackage :pilot4-causal (:use :cl))
(in-package :pilot4-causal)

(defun obj (&rest kvs) (apply #'asem-mission-data:obj kvs))
(defun vec (xs) (coerce xs 'vector))
(defun frac (a b) (/ a (max 1 b) 1.0d0))

(defun try-accel ()
  (ignore-errors (asem-tf32:native-init))
  (ignore-errors (asem-tf32:blas-init)))

(defun load-json-file (path)
  (with-open-file (in path :external-format :utf-8)
    (let* ((s (make-string (file-length in)))
           (n (read-sequence s in)))
      (asem-json:parse-json (subseq s 0 n)))))

(defun make-worker-caches (w)
  (coerce (loop repeat w collect (cons (make-hash-table) (make-hash-table :test 'equal))) 'vector))

(defun clear-worker-caches (wc)
  (loop for c across wc do (clrhash (car c)) (clrhash (cdr c))))

(defun pmap-items (n-workers fn items &optional worker-caches)
  "Map FN over vector/list ITEMS using N-WORKERS threads, preserving order."
  (let* ((v (coerce items 'vector))
         (total (length v))
         (out (make-array total))
         (w (min n-workers (max 1 total)))
         (wc (or worker-caches (make-worker-caches w)))
         (threads nil))
    (dotimes (wi w)
      (let* ((lo (floor (* wi total) w))
             (hi (floor (* (1+ wi) total) w))
             (c (aref wc wi)))
        (push (sb-thread:make-thread
               (lambda ()
                 (let ((acts-1 (car c))
                       (acts-k (cdr c)))
                   (loop for idx from lo below hi
                         do (setf (aref out idx) (funcall fn (aref v idx) acts-1 acts-k))))))
              threads)))
    (dolist (th threads) (sb-thread:join-thread th))
    (coerce out 'list)))

(defun greedy-and-nll (model bpe prompt-no-tail gold acts-1 acts-k)
  "Autoregressive greedy decode (up to (max 4 (1+ (length g-ids))) tokens) + teacher-forced gold NLL."
  (let* ((cfg (asem-tf32:model-config model))
         (ctx (asem-tf32:config-ctx cfg))
         (v (asem-tf32:config-vocab cfg))
         (full-prompt (concatenate 'string prompt-no-tail (string #\Newline) "The answer is"))
         (p-ids (cons 0 (asem-bpe:bpe-encode bpe full-prompt)))
         (g-ids (asem-bpe:bpe-encode bpe (concatenate 'string " " gold)))
         (klen (length g-ids))
         (max-steps (max 4 (1+ klen)))
         (cur (copy-list p-ids))
         (gen-ids nil))
    ;; Autoregressive greedy steps
    (loop repeat max-steps
          for n = (length cur)
          while (< n ctx)
          do (let* ((x (coerce cur '(simple-array fixnum (*))))
                    (acts (or (gethash n acts-1)
                              (setf (gethash n acts-1) (asem-tf32:make-acts cfg n 1))))
                    (row (make-array 1 :element-type 'fixnum :initial-element (1- n))))
               (asem-tf32:forward-rows model x acts row)
               (let* ((probs (asem-tf32:acts-probs acts))
                      (bi 0) (bp -1d0))
                 (dotimes (j v)
                   (let ((p (aref probs j)))
                     (when (> p bp) (setf bp p bi j))))
                 (push bi gen-ids)
                 (setf cur (append cur (list bi))))))
    (setf gen-ids (nreverse gen-ids))
    ;; Teacher-forced gold NLL
    (let* ((full (append p-ids g-ids))
           (nf (length full))
           (nll 0d0)
           (tok0-match (if (and gen-ids (= (first gen-ids) (first g-ids))) 1 0)))
      (when (> nf ctx) (error "Sequence exceeds ctx: ~d > ~d" nf ctx))
      (let* ((xf (coerce full '(simple-array fixnum (*))))
             (plen (length p-ids))
             (rows (make-array klen :element-type 'fixnum))
             (ak (or (gethash (cons nf klen) acts-k)
                     (setf (gethash (cons nf klen) acts-k) (asem-tf32:make-acts cfg nf klen)))))
        (dotimes (k klen) (setf (aref rows k) (+ (1- plen) k)))
        (asem-tf32:forward-rows model xf ak rows)
        (let ((probs (asem-tf32:acts-probs ak)))
          (dotimes (k klen)
            (decf nll (log (max 1d-300 (aref probs (+ (* k v) (nth k g-ids)))))))))
      (let* ((exact-ok (and (>= (length gen-ids) klen)
                            (equal (subseq gen-ids 0 klen) g-ids)))
             (next-tok (and (> (length gen-ids) klen) (nth klen gen-ids)))
             (next-str (if next-tok (asem-bpe:bpe-decode bpe (list next-tok)) ""))
             (bounded-ok (and exact-ok
                              (or (null next-tok)
                                  (= next-tok 0)
                                  (zerop (length next-str))
                                  (not (alphanumericp (char next-str 0))))))
             (gen-prefix (asem-bpe:bpe-decode bpe (subseq gen-ids 0 (min klen (length gen-ids)))))
             (gen-full (asem-bpe:bpe-decode bpe gen-ids)))
        (list :exact (if exact-ok 1 0)
              :bounded (if bounded-ok 1 0)
              :tok0 tok0-match
              :nll (/ nll (max 1 klen))
              :gen-prefix (string-trim '(#\Space #\. #\Newline #\Return) gen-prefix)
              :gen-full (string-trim '(#\Newline #\Return) gen-full))))))

(defun eval-k4-batch (model bpe letters items-spec)
  "items-spec: list of (id prompt options gold)."
  (let ((exs (make-array (length items-spec)))
        (idx 0))
    (dolist (sp items-spec)
      (destructuring-bind (id prompt opts gold) sp
        (multiple-value-bind (tex lex)
            (asem-sft32:choice-exs id "causal" "swap" prompt opts gold bpe 128)
          (declare (ignore lex))
          (setf (aref exs idx) tex)
          (incf idx))))
    (let ((preds (asem-sft32:qa-predict model exs letters :workers 4)))
      (loop for p in preds for e across exs
            for pred-tok = (nth (first p) letters)
            collect (list :correct (if (= pred-tok (asem-sft32:ex-target e)) 1 0)
                          :pred-idx (first p)
                          :choice-loss (second p))))))

(defun run-induction-bucket (model tok-ids &key (n 50) (half 40) (seed 17))
  (let* ((cfg (asem-tf32:model-config model))
         (v (asem-tf32:config-vocab cfg))
         (tlen (+ 1 (* 2 half)))
         (acts (asem-tf32:make-acts cfg tlen tlen))
         (ntok (length tok-ids))
         (rng-state (logand #xffffffff (sxhash seed)))
         (sum-l1 0d0) (sum-l2 0d0)
         (acc1 0) (acc2 0) (cnt1 0) (cnt2 0))
    (labels ((next-u32 ()
               (setf rng-state (logand #xffffffff (+ (* rng-state 1664525) 1013904223)))
               rng-state)
             (pick () (aref tok-ids (mod (next-u32) ntok))))
      (dotimes (_ n)
        (let ((x (make-array tlen :element-type 'fixnum :initial-element 0)))
          (dotimes (i half)
            (let ((tk (pick)))
              (setf (aref x (1+ i)) tk
                    (aref x (+ 1 half i)) tk)))
          (asem-tf32:forward model x acts)
          (let ((probs (asem-tf32:acts-probs acts)))
            (loop for i from 1 below half
                  for tgt = (aref x (1+ i))
                  for pr = (aref probs (+ (* i v) tgt))
                  do (decf sum-l1 (log (max 1d-300 pr)))
                     (incf cnt1)
                     (let ((bi 0) (bp -1d0) (base (* i v)))
                       (dotimes (j v)
                         (let ((p (aref probs (+ base j))))
                           (when (> p bp) (setf bp p bi j))))
                       (when (= bi tgt) (incf acc1))))
            (loop for i from 1 below half
                  for row = (+ half i)
                  for tgt = (aref x (1+ row))
                  for pr = (aref probs (+ (* row v) tgt))
                  do (decf sum-l2 (log (max 1d-300 pr)))
                     (incf cnt2)
                     (let ((bi 0) (bp -1d0) (base (* row v)))
                       (dotimes (j v)
                         (let ((p (aref probs (+ base j))))
                           (when (> p bp) (setf bp p bi j))))
                       (when (= bi tgt) (incf acc2))))))))
    (obj "n_sequences" n
         "half_len" half
         "pool_size" ntok
         "loss_first_copy" (/ sum-l1 cnt1)
         "loss_second_copy" (/ sum-l2 cnt2)
         "acc_first_copy" (frac acc1 cnt1)
         "acc_second_copy" (frac acc2 cnt2))))

(defun build-prose-probes (bpe data-json audit-json)
  "Build paired 1-sentence copy-in-prose & 4-sentence L3 pf-reverse items across 3 subword regimes (n=60 each)."
  (let* ((toks (asem-json:json-get audit-json "vocab_tokens"))
         (p3-cnt (make-array 8192 :initial-element 0))
         (r7-cnt (make-array 8192 :initial-element 0)))
    (loop for tk across toks
          do (let ((id (asem-json:json-get tk "id")))
               (setf (aref p3-cnt id) (asem-json:json-get tk "p3_all")
                     (aref r7-cnt id) (asem-json:json-get tk "r7_ret_all"))))
    (let ((excl (make-hash-table :test 'equal)))
      (flet ((add-excl (s) (setf (gethash (string-downcase (string-trim '(#\Space #\Return #\Newline) s)) excl) t)))
        (with-open-file (in "docs/results/stage2/mission-20261111/pilot2/d1-entities.txt")
          (loop for l = (read-line in nil) while l do (add-excl l)))
        (with-open-file (in "docs/results/stage2/mission-20261111/pilot3/excluded-extra.txt")
          (loop for l = (read-line in nil) while l do (add-excl l)))
        (dolist (nm (asem-qagen:split-pool asem-qagen:*names* :train)) (add-excl nm))
        (dolist (nm (asem-qagen:split-pool asem-qagen:*names* :dev)) (add-excl nm))
        (dolist (tn (asem-qagen:split-pool asem-qagen::*towns* :train)) (add-excl tn))
        (dolist (tn (asem-qagen:split-pool asem-qagen::*towns* :dev)) (add-excl tn))
        (dolist (bn (asem-retrieval::broad-pool :names)) (add-excl bn))
        (dolist (bt (asem-retrieval::broad-pool :towns)) (add-excl bt))
        (dolist (np (asem-retrieval::new-pool :names)) (add-excl np)))
      (let* ((d1-and-qdev (make-hash-table :test 'equal))
             (seen-synth nil)
             (d1-zeros (coerce (asem-json:json-get data-json "d1_zero_names") 'list))
             (fw-cands (coerce (asem-json:json-get data-json "fw_zero_ret_words") 'list))
             (fw-zeros nil)
             (seen-towns nil)
             (seen-dists nil))
        (with-open-file (in "docs/results/stage2/mission-20261111/pilot2/d1-entities.txt")
          (loop for l = (read-line in nil) while l
                for tr = (string-trim '(#\Space #\Return #\Newline) l)
                when (plusp (length tr)) do (setf (gethash (string-downcase tr) d1-and-qdev) t)))
        (dolist (nm (asem-qagen:split-pool asem-qagen:*names* :dev))
          (setf (gethash (string-downcase nm) d1-and-qdev) t))
        (dolist (tw (asem-retrieval::broad-pool :towns))
          (unless (gethash (string-downcase tw) d1-and-qdev)
            (let ((ids (asem-bpe:bpe-encode bpe (concatenate 'string " " tw))))
              (when (every (lambda (id) (and (>= (aref p3-cnt id) 50) (>= (aref r7-cnt id) 50))) ids)
                (push tw seen-towns)))))
        (setf seen-towns (nreverse seen-towns))
        (dolist (nm (asem-qagen:synthetic-pool 'asem-qagen:*names*))
          (unless (gethash (string-downcase nm) d1-and-qdev)
            (let ((ids (asem-bpe:bpe-encode bpe (concatenate 'string " " nm))))
              (when (and (>= (length ids) 2)
                         (<= (length ids) 3)
                         (every (lambda (id) (and (>= (aref p3-cnt id) 100) (>= (aref r7-cnt id) 100))) ids))
                (push nm seen-synth)))))
        (setf seen-synth (nreverse seen-synth))
        (setf seen-dists (subseq seen-synth 0 60))
        (let ((r1-targets (subseq seen-synth 60 120))
              (r2-targets (loop repeat 60 for i from 0 collect (nth (mod i (length d1-zeros)) d1-zeros))))
          (dolist (w fw-cands)
            (unless (gethash (string-downcase w) excl)
              (let ((ids (asem-bpe:bpe-encode bpe (concatenate 'string " " w))))
                (when (and (= (length ids) 2)
                           (every (lambda (id) (and (zerop (aref r7-cnt id)) (zerop (aref p3-cnt id)))) ids))
                  (push w fw-zeros)))))
          (setf fw-zeros (subseq (nreverse fw-zeros) 0 60))
          (format t "Prose probe pools built: r1=~d r2=~d r3=~d towns=~d dists=~d~%"
                  (length r1-targets) (length r2-targets) (length fw-zeros) (length seen-towns) (length seen-dists))
          (let ((items nil)
                (tidx 0))
            (loop for (regime . tlist) in (list (cons "seen_hi100" r1-targets)
                                                (cons "d1_zero" r2-targets)
                                                (cons "fw_zero" fw-zeros))
                  do (loop for targ in tlist
                           for k from 0
                           do (let* ((ts (loop for j from 0 below 4 collect (nth (mod (+ (* 4 tidx) j) (length seen-towns)) seen-towns)))
                                     (ds (loop with res = nil with p = 0
                                               while (< (length res) 3)
                                               for cand = (nth (mod (+ (* 3 tidx) p) (length seen-dists)) seen-dists)
                                               do (incf p)
                                                  (unless (string-equal cand targ) (push cand res))
                                               finally (return (nreverse res))))
                                     (slot (mod k 4))
                                     (people (let ((arr (make-array 4)))
                                               (setf (aref arr slot) targ)
                                               (let ((di 0))
                                                 (dotimes (s 4)
                                                   (unless (= s slot)
                                                     (setf (aref arr s) (nth di ds))
                                                     (incf di))))
                                               (coerce arr 'list)))
                                     (t-gold (nth slot ts))
                                     (p1 (format nil "Text: ~a lives in ~a.~%Q: Who lives in ~a?" targ t-gold t-gold))
                                     (p4 (format nil "Text: ~a~%Q: Who lives in ~a?"
                                                 (format nil "~{~a~^ ~}" (loop for nm in people for tw in ts collect (format nil "~a lives in ~a." nm tw)))
                                                 t-gold))
                                     (rot (mod tidx 4))
                                     (opts (let ((o (make-array 4)))
                                             (dotimes (j 4) (setf (aref o (mod (+ j rot) 4)) (nth j people)))
                                             (coerce o 'list))))
                                (push (list :id (format nil "p1-~a-~3,'0d" regime k)
                                            :cue "s1_copy" :regime regime :slot slot
                                            :prompt p1 :options opts :gold targ)
                                      items)
                                (push (list :id (format nil "p4-~a-~3,'0d" regime k)
                                            :cue "s4_ret" :regime regime :slot slot
                                            :prompt p4 :options opts :gold targ)
                                      items)
                                (incf tidx))))
            (nreverse items)))))))

(defun eval-prose-probes (model bpe letters items &optional wc)
  (let* ((s4-items (remove-if-not (lambda (x) (string= (getf x :cue) "s4_ret")) items))
         (k4-res (eval-k4-batch model bpe letters
                                (loop for it in s4-items for i from 0
                                      collect (list i (getf it :prompt) (getf it :options) (getf it :gold)))))
         (k4-map (make-hash-table :test 'equal)))
    (loop for it in s4-items for r in k4-res
          do (setf (gethash (getf it :id) k4-map) (getf r :correct)))
    (let ((g-res (pmap-items 4
                             (lambda (it a1 ak)
                               (greedy-and-nll model bpe (getf it :prompt) (getf it :gold) a1 ak))
                             items wc)))
      (coerce
       (loop for it in items for gr in g-res
             collect (obj "id" (getf it :id)
                          "cue" (getf it :cue)
                          "regime" (getf it :regime)
                          "slot" (getf it :slot)
                          "gold" (getf it :gold)
                          "gen" (getf gr :gen-prefix)
                          "gen_full" (getf gr :gen-full)
                          "exact" (getf gr :exact)
                          "bounded" (getf gr :bounded)
                          "tok0_ok" (getf gr :tok0)
                          "k4" (gethash (getf it :id) k4-map -1)
                          "nll" (getf gr :nll)))
       'vector))))

(defun eval-swap-pairs (model bpe letters pairs &optional wc)
  (let ((orig-specs nil)
        (swap-specs nil))
    (loop for p across pairs for i from 0
          for q = (asem-json:json-get p "question")
          for p1 = (format nil "Text: ~a~%Q: ~a" (asem-json:json-get p "passage") q)
          for p2 = (format nil "Text: ~a~%Q: ~a" (asem-json:json-get p "swap_passage") q)
          for o1 = (coerce (asem-json:json-get p "options") 'list)
          for o2 = (coerce (asem-json:json-get p "swap_options") 'list)
          for g1 = (asem-json:json-get p "orig_gold")
          for g2 = (asem-json:json-get p "swap_gold")
          do (push (list i p1 o1 g1) orig-specs)
             (push (list i p2 o2 g2) swap-specs))
    (setf orig-specs (nreverse orig-specs)
          swap-specs (nreverse swap-specs))
    (let* ((o-k4 (eval-k4-batch model bpe letters orig-specs))
           (s-k4 (eval-k4-batch model bpe letters swap-specs))
           (o-g (pmap-items 4 (lambda (sp a1 ak) (greedy-and-nll model bpe (second sp) (fourth sp) a1 ak)) orig-specs wc))
           (s-g (pmap-items 4 (lambda (sp a1 ak) (greedy-and-nll model bpe (second sp) (fourth sp) a1 ak)) swap-specs wc)))
      (coerce
       (loop for p across pairs
             for os in orig-specs for ok in o-k4 for og in o-g
             for ss in swap-specs for sk in s-k4 for sg in s-g
             collect (obj "id" (asem-json:json-get p "id")
                          "stratum" (asem-json:json-get p "stratum")
                          "direction" (asem-json:json-get p "direction")
                          "swap_sub_regime" (asem-json:json-get p "swap_sub_regime")
                          "orig_gold" (fourth os)
                          "swap_gold" (fourth ss)
                          "orig_k4" (getf ok :correct)
                          "swap_k4" (getf sk :correct)
                          "orig_gen" (getf og :gen-prefix)
                          "swap_gen" (getf sg :gen-prefix)
                          "orig_ex" (getf og :exact)
                          "swap_ex" (getf sg :exact)
                          "orig_bd" (getf og :bounded)
                          "swap_bd" (getf sg :bounded)
                          "orig_tok0" (getf og :tok0)
                          "swap_tok0" (getf sg :tok0)
                          "orig_nll" (getf og :nll)
                          "swap_nll" (getf sg :nll)))
       'vector))))

(defun main ()
  (try-accel)
  (let* ((bpe (asem-bpe:load-bpe "data/fineweb/stage1/tokenizer.bpe"))
         (letters (asem-sft32:letter-token-ids bpe))
         (cjson (load-json-file "docs/results/stage2/mission-20261111/pilot4/causal_probe_items.json"))
         (ajson (load-json-file "docs/results/stage2/mission-20261111/pilot4/audit_raw.json"))
         (pairs (asem-json:json-get cjson "swap_pairs"))
         (buckets (asem-json:json-get cjson "induction_buckets"))
         (std-ids (coerce (loop for id from 300 below 7300 collect id) 'vector))
         (hi-ids (asem-json:json-get buckets "p3_r7_hi100_alpha"))
         (zr-ids (asem-json:json-get buckets "zero_ret_high_fw_alpha"))
         (prose-items (build-prose-probes bpe cjson ajson))
         (ckpts '(("r7" . "data/runs/retrieval/r7-L123-aug-opts-rev-rsn/last.ckpt")
                  ("p3_5e4" . "data/runs/retrieval/p3-learnability/arm-5e-4/last.ckpt")
                  ("p3_1e3" . "data/runs/retrieval/p3-learnability/arm-1e-3/last.ckpt")
                  ("p2_trt" . "data/runs/retrieval/p2-answer-before/treatment/last.ckpt")))
         (wc (make-worker-caches 4))
         (results nil))
    (dolist (ck ckpts)
      (destructuring-bind (tag . path) ck
        (format t "Evaluating causal probes on ~a (~a)...~%" tag path)
        (force-output)
        (let* ((m (asem-sft32:load-ex-model path))
               (ind-std (run-induction-bucket m std-ids :n 50 :half 40 :seed 17))
               (ind-hi (run-induction-bucket m hi-ids :n 50 :half 40 :seed 17))
               (ind-zr (run-induction-bucket m zr-ids :n 50 :half 40 :seed 17))
               (swap-res (eval-swap-pairs m bpe letters pairs wc))
               (prose-res (eval-prose-probes m bpe letters prose-items wc)))
          (push (cons tag (obj "ckpt" path
                               "induction" (obj "std_300_7300" ind-std
                                                "p3_r7_hi100_alpha" ind-hi
                                                "zero_ret_high_fw_alpha" ind-zr)
                               "d1_swap_pairs" swap-res
                               "prose_probes" prose-res))
                results)))
      (clear-worker-caches wc)
      (sb-ext:gc :full t))
    (with-open-file (out "docs/results/stage2/mission-20261111/pilot4/causal_probe_results.json"
                         :direction :output :if-exists :supersede :if-does-not-exist :create :external-format :utf-8)
      (asem-json:write-json (obj "schema" "asem-pilot4-causal-probes-2"
                                 "results" (cons :obj (nreverse results)))
                            out)
      (terpri out))
    (format t "Wrote docs/results/stage2/mission-20261111/pilot4/causal_probe_results.json~%")))

(main)
