;;; Model-free replay of R7's copy-mix stream and epoch-0 order (lisp/bin/retrieval.lisp:92, lisp/src/sft.lisp epoch-perm/step-examples).
;;; R7 argv: copy-mix=15000 train-n=75000 steps=2500 batch=32 seed=7  -> 90,000 examples, positions 0..79,999 consumed.
(let* ((n-ret 75000) (n-copy 15000) (n (+ n-ret n-copy)) (consumed (* 2500 32)) (vocab 8192)
       (held (with-open-file (in (second sb-ext:*posix-argv*)) (loop for x = (read in nil) while x collect x)))
       (copies (let ((rng (sb-ext:seed-random-state 77)))
                 (coerce (loop for i below n-copy
                               collect (let ((len (+ 10 (random (1+ (- 40 10)) rng))))
                                         (loop repeat len collect (+ 1 (random (- 8192 1) rng)))))
                         'vector)))
       (perm (let ((v (make-array n)) (rng (sb-ext:seed-random-state (+ (* 1000003 7) 0))))
               (dotimes (i n) (setf (aref v i) i))
               (loop for i from (1- n) downto 1 do (rotatef (aref v i) (aref v (random (1+ i) rng))))
               v))
       (ctx-all (make-array vocab :initial-element 0)) (tgt-all (make-array vocab :initial-element 0))
       (ctx-used (make-array vocab :initial-element 0)) (tgt-used (make-array vocab :initial-element 0))
       (used 0))
  (flet ((tally (s ctx tgt) (dolist (id s) (incf (aref ctx id))) (dolist (id (rest s)) (incf (aref tgt id)))))
    (loop for s across copies do (tally s ctx-all tgt-all))
    (loop for pos below consumed for idx = (aref perm pos)
          when (>= idx n-ret) do (incf used) (tally (aref copies (- idx n-ret)) ctx-used tgt-used)))
  (flet ((show-row (name ids ctx tgt)
           (let ((c (mapcar (lambda (i) (aref ctx i)) ids)) (tg (mapcar (lambda (i) (aref tgt i)) ids)))
             (format t "~a n=~d | first-copy occurrences: zero=~d min=~d max=~d mean=~,2f | supervised-target occurrences: zero=~d min=~d max=~d mean=~,2f sum=~d~%"
                     name (length ids) (count 0 c) (reduce #'min c) (reduce #'max c) (/ (reduce #'+ c) (length c) 1.0)
                     (count 0 tg) (reduce #'min tg) (reduce #'max tg) (/ (reduce #'+ tg) (length tg) 1.0) (reduce #'+ tg)))))
    (let ((all (loop for i from 1 below vocab collect i)))
      (format t "copy sequences generated ~d, consumed in 2500 steps ~d (~,1f%)~%" n-copy used (* 100.0 (/ used n-copy)))
      (format t "token id 0 drawn: ~d~%" (aref ctx-all 0))
      (show-row "ALL-15000  eval_heldout" held ctx-all tgt-all)
      (show-row "ALL-15000  ids 1..8191 " all ctx-all tgt-all)
      (show-row "CONSUMED   eval_heldout" held ctx-used tgt-used)
      (show-row "CONSUMED   ids 1..8191 " all ctx-used tgt-used)
      (format t "total supervised copy targets: all ~d, consumed ~d; share on eval_heldout (consumed) ~,2f%~%"
              (reduce #'+ tgt-all) (reduce #'+ tgt-used)
              (* 100.0 (/ (reduce #'+ (mapcar (lambda (i) (aref tgt-used i)) held)) (reduce #'+ tgt-used)))))))
