;;;; Paired dev wording semantics, protected inputs, scoring arithmetic and autoregressive output.
(let ((here (directory-namestring *load-truename*)))
  (require :sb-posix)
  (dolist (f '("util" "sha256" "json" "bpe" "data" "qagen" "tf32" "train32" "pretrain32" "sft32" "qa-analysis"))
    (load (merge-pathnames (format nil "../src/~a.lisp" f) here)))
  (load (merge-pathnames "harness.lisp" here))
  (defparameter cl-user::*analysis-lock* (merge-pathnames "../eval/qa/test.lock" here)))
(in-package :harness)
(defparameter *items* (asem-qagen:generate-split :dev 100 82031))
(defparameter *tmp* (format nil "/tmp/asem-qa-analysis-~d/" (sb-posix:getpid)))
(defun raises (thunk) (handler-case (progn (funcall thunk) nil) (error () t)))

(deftest familiar-questions-preserve-all-facts-and-answer-keys
  (let ((familiar (asem-qa-analysis:familiar-items *items*)))
    (dolist (c asem-qagen:+categories+) (check (find c familiar :key (lambda (it) (getf it :category)) :test #'equal)))
    (loop for old in *items* for new in familiar
          do (dolist (k '(:id :passage :options :answer :cf-answer :query :cf-query :facts))
               (check-equal (getf old k) (getf new k)))
             (check (string/= (getf old :question) (getf new :question)))
             (check (null (asem-qagen:validate-item new)))
             (check (member (getf new :qframe) (asem-qagen:all-frames :train) :test #'equal))
             (check-equal (getf new :cf-question) (asem-qa-analysis::familiar-question old (getf old :cf-query))))))

(deftest counterfactual-and-reversal-remap-the-key
  (dolist (it *items*)
    (let ((cf (asem-qa-analysis:condition-item *items* it :counterfactual))
          (rev (asem-qa-analysis:condition-item *items* it :reversed)))
      (check-equal (getf cf :question) (getf it :cf-question))
      (check-equal (getf cf :answer) (getf it :cf-answer))
      (check (/= (getf cf :answer) (getf it :answer)))
      (check-equal (nth (getf rev :answer) (getf rev :options)) (nth (getf it :answer) (getf it :options)))
      (check-equal (getf (asem-qa-analysis:condition-item *items* rev :reversed) :options) (getf it :options)))))

(deftest summed-and-mean-token-scores-are-distinct
  (multiple-value-bind (sum mean means) (asem-qa-analysis:score-predictions '(-2d0 -3d0 -4d0 -5d0) '(1 3 2 2))
    (check-equal sum 0) (check-equal mean 1) (check-equal means '(-2d0 -1d0 -2d0 -2.5d0)))
  (multiple-value-bind (sum mean) (asem-qa-analysis:score-predictions '(-1d0 -1d0 -2d0 -3d0) '(1 1 1 1))
    (check-equal sum 0) (check-equal mean 0)))

(deftest development-reader-roundtrips-structured-metadata-and-refuses-test-input
  (ensure-directories-exist *tmp*)
  (let ((path (format nil "~adev.jsonl" *tmp*)) (bad (format nil "~anondevelopment.jsonl" *tmp*))
        (lock (format nil "~alock" *tmp*)))
    (with-open-file (out path :direction :output :if-exists :supersede)
      (dolist (it *items*) (write-line (asem-qagen:item-json-line it) out)))
    (let ((read-back (asem-qa-analysis:read-development path cl-user::*analysis-lock*)))
      (check-equal (length read-back) (length *items*))
      (loop for a in *items* for b in read-back do
        (dolist (k '(:id :facts :query :cf-query :answer :cf-answer)) (check-equal (getf a k) (getf b k)))))
    (with-open-file (out lock :direction :output :if-exists :supersede) (write-line (asem-sha256:sha256-file-hex path) out))
    (check (raises (lambda () (asem-qa-analysis:read-development path lock))) "locked content refused before JSON parse")
    (check (raises (lambda () (asem-qa-analysis:read-development (format nil "~atest.jsonl" *tmp*) lock))) "test name refused even without opening")
    (let ((it (copy-list (first *items*))))
      (setf (getf it :split) "test")
      (with-open-file (out bad :direction :output :if-exists :supersede) (write-line (asem-qagen:item-json-line it) out))
      (check (raises (lambda () (asem-qa-analysis:read-development bad cl-user::*analysis-lock*))))
    (check (raises (lambda () (asem-qa-analysis::data-form "#.(error \"reader evaluation\")")))))))

(deftest numerical-option-scores-and-greedy-prefix-agree-with-reference
  (let* ((bpe (asem-bpe:train-bpe (append (mapcar #'asem-qagen:item-prompt *items*) '(" A B C D A B C D A B C D")) 1400))
         (it (first *items*))
         (model (asem-tf32:init-model (asem-tf32:make-config :vocab (asem-bpe:bpe-vocab-size bpe) :ctx 256 :dim 16 :heads 2 :layers 1 :ff 32) 17))
         (e (aref (asem-sft32:encode-items (list it) bpe 256 :mode :text) 0))
         (r (asem-qa-analysis::predict-item model bpe it (make-hash-table)))
         (tail (first (asem-sft32::ex-opts e)))
         (x (asem-sft32::padded-x (asem-sft32:ex-ids e) (+ (length (asem-sft32:ex-ids e)) (length tail) -1) tail))
         (acts (asem-tf32:make-acts (asem-tf32:model-config model) (length x)))
         (v (asem-tf32:config-vocab (asem-tf32:model-config model))) (reference 0d0))
    (asem-tf32:forward model x acts)
    (dotimes (k (length tail))
      (incf reference (log (max 1d-300 (float (aref (asem-tf32::acts-probs acts)
                                                                    (+ (* (+ (length (asem-sft32:ex-ids e)) -1 k) v) (aref tail k))) 1d0)))))
    (check-close (first (getf r :scores)) reference 1d-5)
    (check (<= (length (getf r :generated)) (length (asem-sft32::ex-tgt e))))
    (check (<= (length (getf r :bounded-generated)) 8))
    (check-equal (getf r :bounded-exact) (string= (getf r :bounded-text) (getf r :gold-text)))
    (check-equal (getf r :prefix-exact) (equal (getf r :generated) (coerce (asem-sft32::ex-tgt e) 'list)))
    (check (every (lambda (id) (<= 0 id (1- v))) (getf r :generated)))
    (let ((ids (coerce (asem-sft32:ex-ids e) 'list)))
      (dolist (pred (getf r :bounded-generated))
        (let ((a (asem-tf32:make-acts (asem-tf32:model-config model) (length ids))))
          (asem-tf32:forward model (asem-sft32::ivec-of ids) a)
          (let* ((offset (* (1- (length ids)) v)) (ll (asem-tf32::acts-logits a)) (best 0))
            (dotimes (j v) (when (> (aref ll (+ offset j)) (aref ll (+ offset best))) (setf best j)))
            (check-equal pred best)))
        (setf ids (append ids (list pred)))))
    (let* ((few (subseq *items* 0 12))
           (one (asem-qa-analysis:evaluate model bpe few :workers 1 :controls nil :paired nil)))
      ;; Every worker sees distinct cold strings, exercising memoization writes concurrently.
      (clrhash (asem-bpe::bpe-cache bpe))
      (let ((four (asem-qa-analysis:evaluate model bpe few :workers 4 :controls nil :paired nil)))
        (check-equal one four)
        (check-equal (hash-table-count (asem-bpe::bpe-cache bpe)) 0)))
    ;; A zero-logit model deterministically emits EOT, proving termination does not use the gold answer length.
    (loop for p across (asem-tf32:model-params model) do (fill p 0f0))
    (multiple-value-bind (tokens text reason) (asem-qa-analysis::greedy-answer model bpe e (make-hash-table))
      (check-equal tokens '(0)) (check-equal text "") (check-equal reason "eot"))
    (check (raises (lambda () (asem-qa-analysis:evaluate model bpe (list (list :split "test"))))))))

(unwind-protect (run-all) (when (probe-file *tmp*) (sb-ext:delete-directory *tmp* :recursive t)))
