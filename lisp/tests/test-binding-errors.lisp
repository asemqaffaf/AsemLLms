;;;; Saved-record analysis tests. No model packages, inference or training.
(let ((here (directory-namestring *load-truename*)))
  (dolist (f '("util" "sha256" "json" "verify-saved" "binding-errors"))
    (load (merge-pathnames (format nil "../src/~a.lisp" f) here)))
  (load (merge-pathnames "harness.lisp" here)))
(in-package :harness)
(defun g (o k) (asem-verify-saved:g o k))
(defun obj (&rest kvs) (apply #'asem-verify-saved:obj kvs))
(defparameter *family* (obj "id" "manual-family" "category" "relation" "predicate" "teach"))
(defun world (i &optional (query :rel-subj))
  (let* ((edges (if (zerop i) '(("Alba" "Bren") ("Bren" "Cora") ("Cora" "Dara"))
                   '(("Bren" "Alba") ("Cora" "Bren") ("Dara" "Cora"))))
         (key (if (eq query :rel-subj) (if (zerop i) 0 2) (if (zerop i) 2 0))))
    (obj "id" (format nil "manual/w~d" i) "key" key "options" #("Alba" "Bren" "Cora" "Dara")
         "option_token_ids" #(#(1 2) #(3 4) #(5 6) #(7 8))
         "query" (asem-binding-errors::data-string (list query "Bren"))
         "facts" (asem-binding-errors::data-string (list :people '("Alba" "Bren" "Cora" "Dara") :pairs edges)))))
(defun pair () (obj "id" "manual" "family" "manual-family" "category" "relation"))
(defun detail (i pred prefix-choice &optional (query :rel-subj))
  (let* ((w (world i query)) (other (world (- 1 i) query))
         (row (obj "summed_option_prediction" pred "mean_token_option_prediction" pred
                   "generated_token_ids" (if prefix-choice (aref (g w "option_token_ids") prefix-choice) #(99 100)))))
    (asem-binding-errors:world-detail "manual" (pair) *family* w other row)))
(defun outcome (a b) (asem-binding-errors:pair-detail "manual" (pair) *family* a b))
(defun closep (a b) (< (abs (- a b)) 1d-12))
(deftest analysis-loads-no-evaluator-or-model
  (check (not (find-package :asem-qa-analysis))) (check (not (find-package :asem-tf32))))
(deftest json-object-order-does-not-hide-changed-results
  (check (asem-binding-errors::json-equivalent-p (obj "a" 1 "b" #(2 3)) (obj "b" #(2 3) "a" 1)))
  (check (not (asem-binding-errors::json-equivalent-p (obj "a" 1 "b" 2) (obj "b" 2 "a" 0))))
  (check (not (asem-binding-errors::json-equivalent-p (obj "a" 1) (obj "b" 1)))))
(deftest classify-all-role-choices-from-the-graph
  (loop for choice from 0 for expected in '("correct" "query_anchor" "opposite_direction" "other_entity") do
    (let ((d (detail 0 choice choice)))
      (check-equal (g d "ranking_role") expected) (check-equal (g d "prefix_role") expected)))
  (check-equal (g (detail 0 0 0 :rel-obj) "ranking_role") "opposite_direction")
  (check-equal (g (detail 0 2 2 :rel-obj) "ranking_role") "correct"))
(deftest distinguish-listed-errors-from-unlisted-prefixes
  (let ((unlisted (detail 0 0 nil)) (listed (detail 0 0 2)))
    (check-equal (g unlisted "ranking_only_unlisted_error") :true)
    (check-equal (g unlisted "ranking_only_listed_error") :false)
    (check-equal (g listed "ranking_only_listed_error") :true)
    (check-equal (g listed "prefix_role") "opposite_direction"))
  ;; Index zero is a valid listed prefix, not absence.
  (check-equal (g (detail 0 0 0) "prefix_option_index") 0)
  (check-equal (g (detail 0 0 0) "prefix_correct") :true))
(deftest prefix-divergence-distinguishes-first-later-and-short-errors
  (dolist (case '((#(1 9) #(1 2) 1 "later_token") (#(9 2) #(1 2) 0 "first_token")
                  (#(1) #(1 2) 1 "short_prefix") (#() #(1 2) 0 "empty_prefix") (#(1 2) #(1 2) 2 "correct")))
    (multiple-value-bind (n stage) (asem-binding-errors::prefix-overlap (first case) (second case))
      (check-equal n (third case)) (check-equal stage (fourth case)))))
(deftest conditional-failure-distinguishes-fixed-choice-from-incorrect-switch
  (let* ((a (detail 0 0 nil)) (fixed (outcome a (detail 1 0 0)))
         (changed (outcome a (detail 1 3 3))))
    (check-equal (g fixed "ranking_state") "world0_only")
    (check-equal (g fixed "transition") "one_correct_unchanged_choice")
    (check-equal (g changed "transition") "one_correct_changed_to_wrong")
    (check-equal (g (outcome (detail 0 0 0) (detail 1 2 2)) "transition") "correct_switch")
    (check-equal (g (outcome (detail 0 2 2) (detail 1 0 0)) "both_opposite_direction") :true)))
(deftest association-uses-marginals-and-paired-contingency
  (let* ((ps (loop for state in '("both_correct" "world0_only" "world1_only" "neither_correct") collect (obj "ranking_state" state)))
         (s (asem-binding-errors:association ps "ranking")))
    (check-equal (g s "both_correct") 1)
    (check (closep (g s "product_of_marginal_accuracies") .25d0))
    (check (closep (g s "joint_minus_product") 0d0))
    (check (closep (g s "phi") 0d0))
    (check (closep (g s "world1_correct_given_world0_correct") .5d0))))
(deftest partitions-add-up-with-no-double-counting
  (let* ((a (detail 0 0 nil)) (b (detail 1 0 0)) (p (outcome a b))
         (s (asem-binding-errors:summarize (list a b) (list p)))
         (cells (g s "ranking_generation_contingency")))
    (check-equal (g s "worlds") 2) (check-equal (g s "ranking_correct") 1)
    (check-equal (g s "prefix_correct") 0)
    (check-equal (g cells "ranking_only") 1) (check-equal (g cells "neither_correct") 1)
    (check-equal (g s "wrong_prefix_listed") 1) (check-equal (g s "wrong_prefix_unlisted") 1))
  (check-equal (g (asem-binding-errors:summarize nil nil) "prefix_correct_given_ranking_correct") :null))
(run-all)
