(let ((here (directory-namestring *load-truename*)))
  (defparameter cl-user::*nf-here* here)
  (require :sb-posix)
  (dolist (f '("util" "sha256" "json" "verify-saved")) (load (merge-pathnames (format nil "../src/~a.lisp" f) here)))
  (load (merge-pathnames "harness.lisp" here)))
(in-package :harness)
(deftest recover-only-unquoted-exponents-and-preserve-the-original
  (let* ((dir (format nil "/tmp/asem-float-recovery-test-~d/" (sb-posix:getpid)))
         (raw (concatenate 'string dir "raw.txt")) (out (concatenate 'string dir "normalized.json"))
         (record (concatenate 'string dir "record.json"))
         (literal "value 2.0f-6 with \"quotes\""))
    (ensure-directories-exist raw)
    (with-open-file (s raw :direction :output :if-exists :error :if-does-not-exist :create)
      (format s "{~%  \"a\": 1.0f-5,~%  \"b\": -3f+4,~%  \"text\": ")
      (asem-json:write-json literal s) (write-string "}" s))
    (let* ((hash (asem-sha256:sha256-file-hex raw))
           (args (list "--script" "lisp/bin/normalize-fp32-audit.lisp" (concatenate 'string "raw=" raw)
                       (concatenate 'string "out=" out) (concatenate 'string "record=" record)))
           (p (sb-ext:run-program "sbcl" args :search t :wait t :output nil :error nil :directory (merge-pathnames "../../" cl-user::*nf-here*))))
      (check-equal (sb-ext:process-exit-code p) 0)
      (let ((v (asem-verify-saved:read-json out)) (r (asem-verify-saved:read-json record)))
        (check-equal (asem-verify-saved:g v "text") literal)
        (check-close (asem-verify-saved:g v "a") 1d-5 1d-12)
        (check-close (asem-verify-saved:g v "b") -30000d0 1d-12)
        (check-equal (asem-verify-saved:g r "numeric_exponent_markers_replaced") 2))
      (check-equal (asem-sha256:sha256-file-hex raw) hash)
      (let ((output-hash (asem-sha256:sha256-file-hex out)))
        (check (not (zerop (sb-ext:process-exit-code (sb-ext:run-program "sbcl" args :search t :wait t :output nil :error nil :directory (merge-pathnames "../../" cl-user::*nf-here*))))))
        (check-equal (asem-sha256:sha256-file-hex out) output-hash)))
    (sb-ext:delete-directory dir :recursive t)))
(run-all)
