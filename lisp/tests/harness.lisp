;;;; Minimal test harness (no Quicklisp needed).
(defpackage :harness (:use :cl) (:export #:deftest #:check #:check-equal #:check-close #:run-all #:*tests*))
(in-package :harness)
(defvar *tests* nil)
(defvar *failures* 0)
(defvar *checks* 0)
(defmacro deftest (name &body body)
  `(progn (setf *tests* (append (remove ',name *tests* :key #'car) (list (cons ',name (lambda () ,@body)))))
          ',name))
(defmacro check (form &optional (msg (format nil "~s" form)))
  `(progn (incf *checks*)
          (unless ,form (incf *failures*) (format t "  FAIL: ~a~%" ,msg))))
(defmacro check-equal (a b)
  `(let ((x ,a) (y ,b))
     (incf *checks*)
     (unless (equalp x y) (incf *failures*) (format t "  FAIL: ~s~%    got ~s~%    expected ~s~%" ',a x y))))
(defmacro check-close (a b tol)
  `(let ((x ,a) (y ,b))
     (incf *checks*)
     (unless (<= (abs (- x y)) (* ,tol (max 1d0 (abs y)))) (incf *failures*)
       (format t "  FAIL: ~s = ~s, expected ~s (tol ~s)~%" ',a x y ,tol))))
(defun run-all ()
  (dolist (tc *tests*)
    (format t "~a~%" (car tc))
    (handler-case (funcall (cdr tc))
      (error (e) (incf *failures*) (format t "  ERROR: ~a~%" e))))
  (format t "~%~d tests, ~d checks, ~d failures~%" (length *tests*) *checks* *failures*)
  (sb-ext:exit :code (if (zerop *failures*) 0 1)))
