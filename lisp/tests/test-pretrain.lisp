;;;; Pretraining on token shards, both precisions: it learns, the untrained baseline is logged, the same seed gives the same
;;;; checkpoint bytes, checkpoints reload to identical logits, and the multiple-choice scorer behaves.
(let ((here (directory-namestring *load-truename*)))
  (require :sb-posix)
  (dolist (f '("util" "sha256" "json" "bpe" "data" "tf" "train" "pretrain" "tf32" "train32" "pretrain32"))
    (load (merge-pathnames (format nil "../src/~a.lisp" f) here)))
  (load (merge-pathnames "harness.lisp" here))
  (defparameter cl-user::*eval-file* (namestring (merge-pathnames "../eval/asem_eval.jsonl" here))))
(in-package :harness)

(defparameter *words* #("the" "sky" "is" "blue" "grass" "green" "water" "wet" "sun" "bright" "moon" "night" "cat" "dog" "runs" "sleeps" "fast" "slow" "big" "small"))
(defun doc-text (state)
  (with-output-to-string (o)
    (dotimes (i 120) (format o "~a " (aref *words* (random (length *words*) state)))
                     (when (zerop (mod i 9)) (format o "~%")))))
(defun tmpdir (name) (format nil "/tmp/asem-pretrain-~a-~d" name (get-universal-time)))
(defun rm-rf (d) (sb-ext:run-program "/bin/rm" (list "-rf" d)))

(defun make-data (dir)
  (let ((state (sb-ext:seed-random-state 5)))
    (asem-data:build (lambda (cb) (dotimes (i 300) (funcall cb (list :text (doc-text state) :score 4d0 :language-score 0.99d0))))
                     dir :min-chars 100 :vocab-size 300 :tokenizer-docs 100 :shard-tokens 30000 :val-permille 100 :test-permille 50 :near-dedup nil)))

(defun log-lines (path)
  (with-open-file (in path) (loop for l = (read-line in nil) while l collect (asem-json:parse-json l))))

(defmacro with-precisions ((pkg fn-sym) &body body)
  `(dolist (,pkg '("ASEM-PRETRAIN" "ASEM-PRETRAIN32"))
     (flet ((,fn-sym (name) (symbol-function (find-symbol name ,pkg))))
       ,@body)))

(deftest pretraining-learns-logs-a-baseline-and-is-reproducible
  (let ((data (tmpdir "d")))
    (make-data data)
    (with-precisions (pkg fn)
      (flet ((run (out workers)
               (funcall (fn "PRETRAIN") data out :size :1m :ctx 32 :steps 60 :batch 8 :workers workers :lr 0.01 :warmup 5
                                                  :eval-every 30 :val-windows 8 :eval-file cl-user::*eval-file* :seed 3
                                                  :config (funcall (fn "PRESET-CONFIG") :1m 300 32))))
        (let* ((o1 (tmpdir (format nil "a-~a" pkg))) (o2 (tmpdir (format nil "b-~a" pkg)))
               (r1 (run o1 1)) (r2 (run o2 1)) (events (log-lines (format nil "~a/log.jsonl" o1))))
          (let ((evals (remove-if-not (lambda (e) (equal (asem-json:json-get e "event") "eval")) events)))
            (check (= (length evals) 3) (format nil "~a: baseline + 2 evals expected, got ~d" pkg (length evals)))
            (check (zerop (asem-json:json-get (first evals) "step")) "first eval is the untrained baseline")
            (check (< (asem-json:json-get (car (last evals)) "val_loss") (- (asem-json:json-get (first evals) "val_loss") 0.5))
                   (format nil "~a: validation loss did not fall: ~a -> ~a" pkg (asem-json:json-get (first evals) "val_loss")
                           (asem-json:json-get (car (last evals)) "val_loss")))
            (check (< (abs (- (asem-json:json-get (first evals) "val_loss") (log 300d0))) 0.5) "untrained loss is near log(vocab)")
            (check (every (lambda (e) (and (asem-json:json-get e "peak_rss_mb") (asem-json:json-get e "tokens_per_sec"))) evals) "memory and speed are logged")
            (check-equal (asem-json:json-get (first events) "precision") (if (equal pkg "ASEM-PRETRAIN") "f64" "f32")))
          ;; same seed, same data, one worker: identical checkpoint bytes
          (check-equal (getf r1 :checkpoint-sha256) (getf r2 :checkpoint-sha256))
          (check-equal (getf r1 :best-val-loss) (getf r2 :best-val-loss))
          (rm-rf o1) (rm-rf o2))))
    (rm-rf data)))

(deftest checkpoint-round-trip-gives-identical-logits
  (let ((data (tmpdir "c")))
    (make-data data)
    (with-precisions (pkg fn)
      (let* ((out (tmpdir (format nil "r-~a" pkg)))
             (cfg (funcall (fn "PRESET-CONFIG") :1m 300 32)))
        (funcall (fn "PRETRAIN") data out :ctx 32 :steps 10 :batch 4 :eval-every 10 :val-windows 4 :config cfg :seed 2)
        (multiple-value-bind (m header) (funcall (fn "LOAD-CHECKPOINT") (format nil "~a/last.ckpt" out))
          (check-equal (asem-json:json-get header "format") "asem-ckpt-1")
          (check-equal (asem-json:json-get header "vocab") 300)
          (let* ((pkg-tf (if (equal pkg "ASEM-PRETRAIN") "ASEM-TF" "ASEM-TF32"))
                 (ll (symbol-function (find-symbol "LAST-LOGITS" pkg-tf)))
                 (x (make-array 10 :element-type 'fixnum :initial-contents '(1 5 9 12 40 7 3 99 150 2)))
                 (a (funcall ll m x)))
            (multiple-value-bind (m2) (funcall (fn "LOAD-CHECKPOINT") (format nil "~a/last.ckpt" out))
              (check (equalp a (funcall ll m2 x)) "reloading the same checkpoint changes the logits"))
            (check (every (lambda (v) (= v v)) a) "logits contain a NaN")))
        (rm-rf out)))
    (rm-rf data)))

(deftest eval-scorer-is-a-pure-function-of-the-model
  (let ((data (tmpdir "e")))
    (make-data data)
    (with-precisions (pkg fn)
      (let* ((cfg (funcall (fn "PRESET-CONFIG") :1m 300 32)) (out (tmpdir (format nil "s-~a" pkg))))
        (funcall (fn "PRETRAIN") data out :ctx 32 :steps 2 :batch 2 :eval-every 2 :val-windows 2 :config cfg :seed 4)
        (let* ((m (funcall (fn "LOAD-CHECKPOINT") (format nil "~a/last.ckpt" out)))
               (bpe (asem-bpe:load-bpe (format nil "~a/tokenizer.bpe" data)))
               (items (subseq (funcall (fn "READ-EVAL-SET") cl-user::*eval-file*) 0 12))
               (a (funcall (fn "SCORE-EVAL") m bpe items)) (b (funcall (fn "SCORE-EVAL") m bpe items)))
          (check-equal a b)
          (check (<= 0 (getf a :accuracy) 1) "accuracy is a fraction")
          (check-equal (getf a :n) 12)
          (check (every (lambda (c) (<= 0 (cdr c) 1)) (getf a :by-category)) "per-category accuracy is a fraction"))
        (rm-rf out)))
    (rm-rf data)))

(deftest eval-set-is-well-formed-and-balanced
  (let ((items (funcall (symbol-function (find-symbol "READ-EVAL-SET" "ASEM-PRETRAIN")) cl-user::*eval-file*)))
    (check-equal (length items) 90)
    (dolist (it items)
      (check (and (= (length (getf it :options)) 4) (= (length (remove-duplicates (getf it :options) :test #'string=)) 4)
                  (<= 0 (getf it :answer) 3))
             (format nil "~a is malformed" (getf it :id))))
    (let ((counts (loop for i below 4 collect (count i items :key (lambda (x) (getf x :answer))))))
      (check (<= (- (reduce #'max counts) (reduce #'min counts)) 2) (format nil "answer positions are unbalanced: ~a" counts)))
    (dolist (c '("fact" "reading" "reasoning"))
      (check-equal (count c items :key (lambda (x) (getf x :category)) :test #'string=) 30))))

(run-all)
