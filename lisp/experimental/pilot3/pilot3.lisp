;;;; Pilot 3 (Learnability Control): 100% 4-person answer-before-entity lookup, streaming fresh data, two LRs (5e-4 vs 1e-3).
;;;; Protocol & decision table pre-registered in docs/results/stage2/mission-20261111/pilot3/protocol.md BEFORE training.
;;;; Usage:
;;;;   sbcl --dynamic-space-size 6GB --script lisp/experimental/pilot3/pilot3.lisp mode=preflight
;;;;   sbcl --dynamic-space-size 6GB --script lisp/experimental/pilot3/pilot3.lisp mode=prepare
;;;;   TLM_BLAS=1 VECLIB_MAXIMUM_THREADS=1 sbcl --dynamic-space-size 6GB --script lisp/experimental/pilot3/pilot3.lisp mode=train arm=5e-4|1e-3

(let ((src (merge-pathnames "../../src/" (directory-namestring *load-truename*))))
  (require :sb-posix)
  (dolist (f '("util" "sha256" "json" "bpe" "data" "qagen" "retrieval" "tf32" "train32" "pretrain32" "sft32" "qa-analysis"))
    (load (merge-pathnames (format nil "~a.lisp" f) src))))

(defpackage :pilot3
  (:use :cl))
(in-package :pilot3)

(defparameter +seed+ 111303)
(defparameter +steps+ 500)
(defparameter +batch+ 32)
(defparameter +train-n+ (* +steps+ +batch+))       ; 16,000 sequences (1.0 epoch at 500 steps * batch 32)
(defparameter +preflight-steps+ 1000)             ; 32,000 sequences (1,000-step stream capacity check)
(defparameter +probe-n+ 500)
(defparameter +ctx+ 128)
(defparameter +bundle+ "docs/results/stage2/mission-20261111/pilot3")
(defparameter +run+ "data/runs/retrieval/p3-learnability")
(defparameter +init+ "data/runs/retrieval/r7-L123-aug-opts-rev-rsn/last.ckpt")
(defparameter +reference+ "33a5c24521dfb1b28b456b8344bfd0869b84fe56aa622191b8f6bfa71cc42aa1")

(defun opt (key)
  (let ((p (concatenate 'string key "=")))
    (let ((a (find-if (lambda (a) (and (>= (length a) (length p)) (string= p a :end2 (length p))))
                      (cdr sb-ext:*posix-argv*))))
      (and a (subseq a (length p))))))

(defun obj (&rest x) (apply #'asem-qa-analysis::obj x))
(defun qsym (name) (find-symbol name :asem-qagen))
(defun qf (name &rest args) (apply (symbol-function (find-symbol name :asem-qagen)) args))
(defun rf (name &rest args) (apply (symbol-function (find-symbol name :asem-retrieval)) args))
(defun rng-for (i attempt stream)
  (sb-ext:seed-random-state (+ (* +seed+ 1000003) (* i 7919) (* attempt 104729) stream)))

(defun set-recipe (bpe)
  (setf asem-retrieval:*augment* t
        asem-retrieval:*reverse* t
        asem-retrieval:*reasoning* t
        asem-retrieval:*broad-train* t
        asem-retrieval:*vocab-words* (asem-retrieval:vocab-words-of bpe)))

(defun person-first-p (frame)
  (< (search "{P}" frame) (or (search "{V}" frame) (search "{aV}" frame))))

(defvar *excluded* nil)
(defvar *clean-names* nil)     ; simple-vector
(defvar *clean-pools* nil)     ; alist: sym -> simple-vector

(defun build-exclusions ()
  (let ((ex (make-hash-table :test 'equalp)))
    (maphash (lambda (k v) (declare (ignore v)) (setf (gethash k ex) t))
             (asem-retrieval::heldout-strings))
    (dolist (path (list "docs/results/stage2/mission-20261111/pilot2/d1-entities.txt"
                        (format nil "~a/excluded-extra.txt" +bundle+)))
      (with-open-file (in path)
        (loop for line = (read-line in nil) while line
              for trimmed = (string-trim '(#\Space #\Tab #\Return #\Newline) line)
              when (plusp (length trimmed))
                do (setf (gethash trimmed ex) t))))
    (setf *excluded* ex)
    (let ((aug-words (make-hash-table :test 'equalp)))
      (dolist (s (append asem-retrieval::*modifiers* asem-retrieval::*leads*))
        (dolist (w (words-of s)) (setf (gethash w aug-words) t)))
      (dolist (ty (symbol-value (qsym "*ATTR-TYPES*")))
        (dolist (fr (rf "FRAMES-OF" (cdr ty) :frames :seen))
          (dolist (w (words-of fr))
            (unless (member w '("P" "V" "aV") :test #'string=)
              (setf (gethash w aug-words) t)))))
      (let* ((raw-names (rf "POOL" :train '*names*))
             (flt-names (coerce (remove-if (lambda (x) (or (gethash x ex) (gethash x aug-words))) raw-names) 'vector)))
        (setf *clean-names* flt-names)
        (setf *clean-pools*
              (loop for sym-name in '("*TOWNS*" "*JOBS*" "*PETS*" "*COLORS*" "*INSTRUMENTS*")
                    for sym = (qsym sym-name)
                    for raw = (rf "POOL" :train sym)
                    for flt = (coerce (remove-if (lambda (x) (or (gethash x ex) (gethash x aug-words))) raw) 'vector)
                    collect (cons sym flt)))))))

(defun vec-pick (vec rng)
  (aref vec (random (length vec) rng)))

(defun vec-sample-n (vec n rng)
  (let ((len (length vec)) (out nil))
    (loop while (< (length out) n)
          do (let ((x (aref vec (random len rng))))
               (unless (member x out :test #'string-equal)
                 (push x out))))
    (nreverse out)))

(defun no-substring-group-p (xs)
  (loop for tail on xs
        for a = (car tail)
        always (loop for b in (cdr tail)
                     never (or (search a b :test #'char-equal)
                               (search b a :test #'char-equal)))))

(defun words-of (text)
  (let ((out nil) (start nil))
    (loop for i from 0 to (length text)
          do (if (and (< i (length text)) (alpha-char-p (char text i)))
                 (unless start (setf start i))
                 (when start (push (subseq text start i) out) (setf start nil))))
    out))

(defun clean-texts-p (texts)
  (notany (lambda (text) (some (lambda (w) (gethash w *excluded*)) (words-of text))) texts))

(defun whole-word-pos (w s)
  (let ((len (length w)) (slen (length s)))
    (loop for i = (search w s) then (search w s :start2 (1+ i))
          while i
          when (and (or (zerop i) (not (alpha-char-p (char s (1- i)))))
                    (or (= (+ i len) slen) (not (alpha-char-p (char s (+ i len))))))
            do (return i))))

(defun answer-before-fact-set (rng)
  "Four people, one attribute type. Every sentence's answer precedes its queried entity:
pf + q-reverse across all 5 attr types (23 passage frames), vf + q-extract on town & instrument (3 passage frames)."
  (let* ((ty (qf "PICK" (symbol-value (qsym "*ATTR-TYPES*")) rng))
         (spec (cdr ty))
         (pool-sym (getf spec :pool))
         (vpool (cdr (assoc pool-sym *clean-pools*)))
         (people (loop do (let ((ps (vec-sample-n *clean-names* 4 rng)))
                            (when (no-substring-group-p ps) (return ps)))))
         (vals (loop do (let ((vs (vec-sample-n vpool 4 rng)))
                          (when (and (no-substring-group-p vs)
                                     (no-substring-group-p (append people vs)))
                            (return vs)))))
         (frames (rf "FRAMES-OF" spec :frames :seen))
         (pf (remove-if-not #'person-first-p frames))
         (vf (remove-if #'person-first-p frames))
         (qext (rf "FRAMES-OF" spec :q-extract :seen))
         (qrev (rf "FRAMES-OF" spec :q-reverse :seen))
         (sents nil) (qa nil) (meta nil))
    (loop for p in people for v in vals do
      (if (and vf (zerop (random 2 rng)))
          (let* ((sf (qf "PICK" vf rng))
                 (qf-str (qf "PICK" qext rng))
                 (sent (qf "FILL-FRAME" sf :p p :v v))
                 (q (qf "FILL-FRAME" qf-str :p p)))
            (push sent sents)
            (push (cons q v) qa)
            (push (list :dir "extract" :attr (string-downcase (symbol-name (car ty)))
                        :sframe sf :qframe qf-str :p p :v v :qraw q) meta))
          (let* ((sf (qf "PICK" pf rng))
                 (qf-str (qf "PICK" qrev rng))
                 (sent (qf "FILL-FRAME" sf :p p :v v))
                 (q (qf "FILL-FRAME" qf-str :v v)))
            (push sent sents)
            (push (cons q p) qa)
            (push (list :dir "reverse" :attr (string-downcase (symbol-name (car ty)))
                        :sframe sf :qframe qf-str :p p :v v :qraw q) meta))))
    (setf sents (nreverse sents) qa (nreverse qa) meta (nreverse meta))
    (multiple-value-bind (aug-sents aug-qa)
        (rf "AUGMENTED" sents qa people (car ty) (append people vals) rng people ty)
      ;; Verify answer-before-entity ordering holds even after augmentation in every sentence.
      (loop for as in aug-sents for m in meta
            do (let ((ip (whole-word-pos (getf m :p) as))
                     (iv (whole-word-pos (getf m :v) as)))
                 (unless (and ip iv (if (string= (getf m :dir) "reverse") (< ip iv) (< iv ip)))
                   (error "Order invariant violated: dir=~a s=~s p=~s v=~s" (getf m :dir) as (getf m :p) (getf m :v)))))
      (let* ((perm-s (qf "SHUFFLE" aug-sents rng))
             (passage (format nil "~{~a~^ ~}" perm-s))
             (idx-qa (loop for x in aug-qa for m in meta collect (list x m)))
             (shuf-qa (qf "SHUFFLE" idx-qa rng)))
        (values passage shuf-qa people vals ty
                (lambda (ans) (if (member ans people :test #'string=) people vals))
                (lambda (ans)
                  (if (member ans people :test #'string=)
                      (lambda () (vec-pick *clean-names* rng))
                      (lambda () (vec-pick vpool rng)))))))))

(defun build-seq (rng bpe &key seen-4fact seen-seq)
  "Build one packed 4-person answer-before sequence, retrying on ctx/options/clean/duplicate failure."
  (loop for attempt from 0 do
    (multiple-value-bind (passage shuf-qa people vals ty cands padder)
        (answer-before-fact-set rng)
      (let* ((pairs (sort (mapcar (lambda (e) (let ((m (second e))) (format nil "~a:~a" (getf m :p) (getf m :v)))) shuf-qa) #'string<))
             (fact-sig (format nil "~a|~{~a~^|~}" (car ty) pairs))
             (ids (cons 0 (asem-bpe:bpe-encode bpe (format nil "Text: ~a~%" passage))))
             (rows nil) (targets nil) (texts (list passage)) (built-qs nil) (ok t))
        (dolist (entry shuf-qa)
          (let* ((x (first entry)) (m (second entry))
                 (ans (cdr x))
                 (opts (rf "OPTIONS-FOR" ans (funcall cands ans) (funcall padder ans) rng)))
            (unless opts
              (setf ok nil)
              (return))
            (let* ((qtoks (asem-bpe:bpe-encode bpe (format nil "Q: ~a~%~@[~a~]The answer is" (car x) (rf "OPTIONS-BLOCK" opts))))
                   (atoks (asem-bpe:bpe-encode bpe (format nil " ~a" ans)))
                   (tail (asem-bpe:bpe-encode bpe (format nil ".~%"))))
              (when (> (+ (length ids) (length qtoks) (length atoks) (length tail)) +ctx+)
                (return))
              (setf ids (append ids qtoks))
              (loop for tk in atoks for k from 0 do (push (+ (length ids) k -1) rows) (push tk targets))
              (setf ids (append ids atoks tail))
              (push (car x) texts) (push ans texts)
              (dolist (o opts) (push o texts))
              (push (list :question (car x) :answer ans :options opts :meta m) built-qs))))
        (when (and ok rows (clean-texts-p texts)
                   (not (and seen-4fact (gethash fact-sig seen-4fact)))
                   (not (and seen-seq (gethash (cons passage (getf (car (last built-qs)) :question)) seen-seq))))
          (setf built-qs (nreverse built-qs))
          (return (list :ids ids :rows (nreverse rows) :targets (nreverse targets)
                        :passage passage :qs built-qs :attr (car ty) :people (sort (copy-list people) #'string<)
                        :vals vals :fact-sig fact-sig :attempts attempt)))))))

(defun save-sexp (path x)
  (with-open-file (s path :direction :output :if-exists :error :if-does-not-exist :create)
    (with-standard-io-syntax (write x :stream s :readably t))))
(defun read-sexp (path)
  (with-open-file (s path) (let ((*read-eval* nil)) (read s))))
(defun write-json (path x)
  (with-open-file (s path :direction :output :if-exists :error :if-does-not-exist :create :external-format :utf-8)
    (asem-json:write-json x s) (terpri s)))
(defun write-compact-json (value stream)
  (cond ((eq value :true) (write-string "true" stream))
        ((eq value :false) (write-string "false" stream))
        ((eq value :null) (write-string "null" stream))
        ((stringp value) (write-string (asem-util:json-string value) stream))
        ((integerp value) (format stream "~d" value))
        ((floatp value) (let ((*read-default-float-format* 'double-float)) (format stream "~a" (coerce value 'double-float))))
        ((and (consp value) (eq (car value) :obj))
         (write-char #\{ stream)
         (loop for ((k . v) . rest) on (sort (copy-list (cdr value)) #'string< :key #'car)
               do (write-string (asem-util:json-string k) stream)
                  (write-char #\: stream)
                  (write-compact-json v stream)
                  (when rest (write-char #\, stream)))
         (write-char #\} stream))
        ((vectorp value)
         (write-char #\[ stream)
         (dotimes (i (length value))
           (when (plusp i) (write-char #\, stream))
           (write-compact-json (aref value i) stream))
         (write-char #\] stream))
        (t (error "Unsupported JSON value ~s" value))))

(defun write-jsonl (path rows)
  (with-open-file (s path :direction :output :if-exists :error :if-does-not-exist :create :external-format :utf-8)
    (dolist (r rows) (write-compact-json r s) (terpri s))))

(defun probe-json-item (id passage qentry &optional train-step)
  (let* ((q (getf qentry :question)) (ans (getf qentry :answer))
         (opts (getf qentry :options)) (m (getf qentry :meta))
         (ai (or (position ans opts :test #'string=) (error "Gold missing from options")))
         (cat (getf m :dir))
         (sub (format nil "~a-~a" (getf m :attr) cat)))
    (apply #'obj
           (append (list "id" id "split" "dev" "category" cat "subtype" sub
                         "passage" passage "question" q "options" (coerce opts 'vector)
                         "answer" ai "answer_letter" (string (char "ABCD" ai))
                         "cf_question" "" "cf_answer" 0 "qframe" (getf m :qframe)
                         "sframe" (getf m :sframe) "query" "()" "facts" "()")
                   (when train-step (list "train_step" train-step))))))

(defun ht-to-obj (ht)
  (cons :obj (sort (loop for k being the hash-keys of ht using (hash-value v) collect (cons k v))
                   #'string< :key #'car)))

(defun preflight (bpe)
  (let* ((n-1000 (* +preflight-steps+ +batch+))
         (seen-seq (make-hash-table :test 'equal))
         (seen-pq0 (make-hash-table :test 'equal))
         (seen-4fact (make-hash-table :test 'equal))
         (seen-4p (make-hash-table :test 'equal))
         (seen-pv (make-hash-table :test 'equal))
         (seen-sq (make-hash-table :test 'equal))
         (sframe-counts (make-hash-table :test 'equal))
         (qframe-counts (make-hash-table :test 'equal))
         (dir-counts (make-hash-table :test 'equal))
         (attr-counts (make-hash-table :test 'equal))
         (seq-dups-500 0) (pq0-dups-500 0) (fact4-dups-500 0) (p4-dups-500 0) (pv-dups-500 0) (sq-dups-500 0)
         (seq-dups-1000 0) (pq0-dups-1000 0) (fact4-dups-1000 0) (p4-dups-1000 0) (pv-dups-1000 0) (sq-dups-1000 0)
         (total-qs-500 0) (total-qs-1000 0) (total-toks-1000 0) (redraws 0))
    (dotimes (i n-1000)
      (let* ((rng (rng-for i 0 0))
             (rec (build-seq rng bpe))
             (ids-key (format nil "~{~d~^,~}" (getf rec :ids)))
             (q0 (first (getf rec :qs)))
             (pq0-key (format nil "~a||~a" (getf rec :passage) (getf q0 :question)))
             (p4-key (format nil "~{~a~^|~}" (getf rec :people))))
        (incf redraws (getf rec :attempts))
        (incf total-toks-1000 (length (getf rec :targets)))
        (incf total-qs-1000 (length (getf rec :qs)))
        (when (< i +train-n+) (incf total-qs-500 (length (getf rec :qs))))
        (if (gethash ids-key seen-seq) (progn (incf seq-dups-1000) (when (< i +train-n+) (incf seq-dups-500))) (setf (gethash ids-key seen-seq) t))
        (if (gethash pq0-key seen-pq0) (progn (incf pq0-dups-1000) (when (< i +train-n+) (incf pq0-dups-500))) (setf (gethash pq0-key seen-pq0) t))
        (if (gethash (getf rec :fact-sig) seen-4fact) (progn (incf fact4-dups-1000) (when (< i +train-n+) (incf fact4-dups-500))) (setf (gethash (getf rec :fact-sig) seen-4fact) t))
        (if (gethash p4-key seen-4p) (progn (incf p4-dups-1000) (when (< i +train-n+) (incf p4-dups-500))) (setf (gethash p4-key seen-4p) t))
        (dolist (qe (getf rec :qs))
          (let* ((m (getf qe :meta))
                 (pv-key (format nil "~a|~a|~a" (getf m :attr) (getf m :p) (getf m :v)))
                 (sq-key (format nil "~a|~a|~a" (getf m :sframe) (getf m :p) (getf m :v))))
            (incf (gethash (getf m :sframe) sframe-counts 0))
            (incf (gethash (getf m :qframe) qframe-counts 0))
            (incf (gethash (getf m :dir) dir-counts 0))
            (incf (gethash (getf m :attr) attr-counts 0))
            (if (gethash pv-key seen-pv) (progn (incf pv-dups-1000) (when (< i +train-n+) (incf pv-dups-500))) (setf (gethash pv-key seen-pv) t))
            (if (gethash sq-key seen-sq) (progn (incf sq-dups-1000) (when (< i +train-n+) (incf sq-dups-500))) (setf (gethash sq-key seen-sq) t))))))
    (let* ((n-names (length *clean-names*))
           (pool-obj (cons :obj (cons (cons "names" n-names)
                                      (loop for (sym . vec) in *clean-pools*
                                            collect (cons (string-downcase (string-trim "*" (symbol-name sym))) (length vec))))))
           (audit (obj "schema" "asem-pilot3-preflight-stream-1"
                       "seed" +seed+
                       "steps_checked" +preflight-steps+
                       "sequences_checked" n-1000
                       "excluded_count" (hash-table-count *excluded*)
                       "clean_pools" pool-obj
                       "redraws" redraws
                       "questions_500_steps" total-qs-500
                       "questions_1000_steps" total-qs-1000
                       "answer_tokens_1000_steps" total-toks-1000
                       "duplicates_at_500_steps" (obj "rendered_ids" seq-dups-500 "passage_q0" pq0-dups-500 "fact4_tuple" fact4-dups-500 "people4_tuple" p4-dups-500 "fact_pv" pv-dups-500 "sentence_pv" sq-dups-500)
                       "duplicates_at_1000_steps" (obj "rendered_ids" seq-dups-1000 "passage_q0" pq0-dups-1000 "fact4_tuple" fact4-dups-1000 "people4_tuple" p4-dups-1000 "fact_pv" pv-dups-1000 "sentence_pv" sq-dups-1000)
                       "dir_counts_1000_steps" (ht-to-obj dir-counts)
                       "attr_counts_1000_steps" (ht-to-obj attr-counts)
                       "sentence_frame_counts_1000_steps" (ht-to-obj sframe-counts)
                       "question_frame_counts_1000_steps" (ht-to-obj qframe-counts))))
      (ensure-directories-exist (format nil "~a/" +bundle+))
      (write-json (format nil "~a/preflight-stream.json" +bundle+) audit)
      (format t "Preflight stream 1000 steps (~d seqs, ~d qs): seq_dups=~d, fact4_dups=~d, p4_dups=~d, pv_dups=~d~%"
              n-1000 total-qs-1000 seq-dups-1000 fact4-dups-1000 p4-dups-1000 pv-dups-1000)
      (format t "Distinct sentence frames hit=~d, question frames hit=~d~%"
              (hash-table-count sframe-counts) (hash-table-count qframe-counts)))))

(defun prepare (bpe)
  (let* ((train-recs (make-array +train-n+))
         (seen-4fact (make-hash-table :test 'equal))
         (seen-seq (make-hash-table :test 'equal))
         (train-pv (make-hash-table :test 'equal))
         (total-qs 0) (total-toks 0) (redraws 0)
         (dir-counts (make-hash-table :test 'equal)))
    (dotimes (i +train-n+)
      (let ((rec (build-seq (rng-for i 0 0) bpe :seen-4fact seen-4fact :seen-seq seen-seq)))
        (setf (gethash (getf rec :fact-sig) seen-4fact) t)
        (setf (gethash (cons (getf rec :passage) (getf (first (getf rec :qs)) :question)) seen-seq) t)
        (incf redraws (getf rec :attempts))
        (incf total-qs (length (getf rec :qs)))
        (incf total-toks (length (getf rec :targets)))
        (dolist (qe (getf rec :qs))
          (let ((m (getf qe :meta)))
            (incf (gethash (getf m :dir) dir-counts 0))
            (setf (gethash (format nil "~a|~a|~a" (getf m :attr) (getf m :p) (getf m :v)) train-pv) t)))
        (setf (aref train-recs i) rec)))
    ;; Exact epoch permutation used by sft32: sample 1 sequence per optimizer step (steps 1..500).
    (let* ((perm (asem-sft32::epoch-perm +train-n+ +seed+ 0))
           (seen-items nil)
           (fresh-items nil)
           (fresh-pv (make-hash-table :test 'equal))
           (fresh-4fact (make-hash-table :test 'equal))
           (fresh-seq (make-hash-table :test 'equal)))
      (dotimes (step +steps+)
        (let* ((idx (aref perm (* step +batch+)))
               (rec (aref train-recs idx)))
          (push (probe-json-item (format nil "p3-seen-~3,'0d" step) (getf rec :passage) (first (getf rec :qs)) (1+ step))
                seen-items)))
      (setf seen-items (nreverse seen-items))
      (loop for i from 0 while (< (length fresh-items) +probe-n+)
            do (let* ((rec (build-seq (rng-for i 0 2) bpe :seen-4fact seen-4fact :seen-seq seen-seq))
                      (q0 (first (getf rec :qs)))
                      (m (getf q0 :meta))
                      (pv-key (format nil "~a|~a|~a" (getf m :attr) (getf m :p) (getf m :v))))
                 (unless (or (gethash pv-key train-pv)
                             (gethash (getf rec :fact-sig) fresh-4fact)
                             (gethash (cons (getf rec :passage) (getf q0 :question)) fresh-seq)
                             (gethash pv-key fresh-pv))
                   (setf (gethash (getf rec :fact-sig) fresh-4fact) t
                         (gethash (cons (getf rec :passage) (getf q0 :question)) fresh-seq) t
                         (gethash pv-key fresh-pv) t)
                   (push (probe-json-item (format nil "p3-fresh-~3,'0d" (length fresh-items)) (getf rec :passage) q0)
                         fresh-items))))
      (setf fresh-items (nreverse fresh-items))
      (ensure-directories-exist (format nil "~a/" +run+))
      (ensure-directories-exist (format nil "~a/" +bundle+))
      (let ((train-data (loop for i below +train-n+ for r = (aref train-recs i) collect (list (getf r :ids) (getf r :rows) (getf r :targets))))
            (train-path (format nil "~a/data-train.sexp" +run+))
            (seen-path (format nil "~a/probe-seen-500.jsonl" +bundle+))
            (fresh-path (format nil "~a/probe-fresh-500.jsonl" +bundle+)))
        (save-sexp train-path train-data)
        (write-jsonl seen-path seen-items)
        (write-jsonl fresh-path fresh-items)
        (write-json (format nil "~a/data-audit.json" +bundle+)
                    (obj "schema" "asem-pilot3-data-1"
                         "seed" +seed+
                         "steps" +steps+
                         "batch" +batch+
                         "train_sequences" +train-n+
                         "copy_sequences" 0
                         "train_questions" total-qs
                         "train_answer_tokens" total-toks
                         "redraws" redraws
                         "excluded_entities" (hash-table-count *excluded*)
                         "dir_counts" (ht-to-obj dir-counts)
                         "sha256" (obj "data-train.sexp" (asem-sha256:sha256-file-hex train-path)
                                       "probe-seen-500.jsonl" (asem-sha256:sha256-file-hex seen-path)
                                       "probe-fresh-500.jsonl" (asem-sha256:sha256-file-hex fresh-path)
                                       "excluded-extra.txt" (asem-sha256:sha256-file-hex (format nil "~a/excluded-extra.txt" +bundle+))
                                       "pilot3.lisp" (asem-sha256:sha256-file-hex "lisp/experimental/pilot3/pilot3.lisp")
                                       "retrieval.lisp" (asem-sha256:sha256-file-hex "lisp/src/retrieval.lisp")
                                       "qagen.lisp" (asem-sha256:sha256-file-hex "lisp/src/qagen.lisp")
                                       "sft.lisp" (asem-sha256:sha256-file-hex "lisp/src/sft.lisp"))))
        (format t "Prepared ~d train seqs (~d qs, ~d tokens), ~d seen probe, ~d fresh probe.~%"
                +train-n+ total-qs total-toks (length seen-items) (length fresh-items))))))

(defun train (arm bpe)
  (let* ((lr (cond ((string= arm "5e-4") 5f-4)
                   ((string= arm "1e-3") 1f-3)
                   (t (error "arm=5e-4|1e-3 required"))))
         (out (format nil "~a/arm-~a" +run+ arm))
         (audit-text (with-open-file (s (format nil "~a/data-audit.json" +bundle+))
                       (let ((text (make-string (file-length s)))) (subseq text 0 (read-sequence text s)))))
         (audit (asem-json:parse-json audit-text))
         (hashes (asem-json:json-get audit "sha256"))
         (data-path (format nil "~a/data-train.sexp" +run+))
         (proto-path (format nil "~a/protocol.md" +bundle+))
         (fresh-path (format nil "~a/probe-fresh-500.jsonl" +bundle+)))
    (when (probe-file (format nil "~a/" out))
      (error "Refusing to overwrite existing run ~a" out))
    (unless (probe-file proto-path)
      (error "protocol.md must be written and pre-registered before training"))
    (unless (equal (asem-json:json-get hashes "data-train.sexp") (asem-sha256:sha256-file-hex data-path))
      (error "data-train.sexp hash mismatch"))
    (unless (equal (asem-json:json-get hashes "probe-fresh-500.jsonl") (asem-sha256:sha256-file-hex fresh-path))
      (error "probe-fresh-500.jsonl hash mismatch"))
    (unless (equal (asem-json:json-get hashes "pilot3.lisp") (asem-sha256:sha256-file-hex "lisp/experimental/pilot3/pilot3.lisp"))
      (error "pilot3.lisp hash mismatch"))
    (let* ((model (asem-pretrain32:load-checkpoint +init+))
           (train (coerce (loop for (ids rows targets) in (read-sexp data-path) for i from 0
                                collect (asem-sft32:multi-ex (format nil "p3r~d" i) ids rows targets))
                          'vector))
           (fresh-rows (asem-qa-analysis:read-development fresh-path "lisp/eval/qa/test.lock"))
           (dev (coerce (loop for it in fresh-rows
                              for opts = (getf it :options)
                              for ans = (nth (getf it :answer) opts)
                              collect (asem-sft32:generation-ex (getf it :id) (getf it :category) (getf it :subtype)
                                                                (asem-retrieval:retrieval-prompt (getf it :passage) (getf it :question) :options opts)
                                                                ans bpe +ctx+))
                        'vector)))
      (asem-sft32:sft out train dev '(316 367 338 443)
        :init-model model :steps +steps+ :batch +batch+ :accum 1 :workers 8
        :lr lr :min-lr-frac 0.1d0 :warmup 50 :clip 1d0 :wd 0d0 :seed +seed+
        :eval-every 250 :save-every 250 :log-every 50 :train-probe 500
        :header (list :mission "pilot3-learnability-control" :arm arm :lr lr :init +init+ :init-sha256 +reference+
                      :protocol-sha256 (asem-sha256:sha256-file-hex proto-path)
                      :data-sha256 (asem-sha256:sha256-file-hex data-path)
                      :fresh-probe-sha256 (asem-sha256:sha256-file-hex fresh-path)
                      :driver-sha256 (asem-sha256:sha256-file-hex "lisp/experimental/pilot3/pilot3.lisp"))))))

(let* ((mode (or (opt "mode") (error "mode=preflight|prepare|train required")))
       (bpe (asem-bpe:load-bpe "data/fineweb/stage1/tokenizer.bpe")))
  (unless (equal +reference+ (asem-sha256:sha256-file-hex +init+))
    (error "Reference R7 checkpoint hash mismatch"))
  (set-recipe bpe)
  (build-exclusions)
  (cond ((equal mode "preflight") (preflight bpe))
        ((equal mode "prepare") (prepare bpe))
        ((equal mode "train") (let ((arm (opt "arm"))) (unless arm (error "arm=5e-4|1e-3 required")) (train arm bpe)))
        (t (error "Unknown mode ~a" mode)))
  (unless (equal +reference+ (asem-sha256:sha256-file-hex +init+))
    (error "Reference R7 checkpoint changed during execution")))
