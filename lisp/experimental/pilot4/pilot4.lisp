;;;; Pilot 4 (Retention-Aware & Copy-Grounded 2x2 Factorial Retrieval)
;;;; Approved protocol & binding gates:
;;;;   docs/results/stage2/mission-20261111/pilot4/protocol.md
;;;;   docs/results/stage2/mission-20261111/pilot4/eval-spec.md
;;;; Usage:
;;;;   sbcl --dynamic-space-size 6GB --script lisp/experimental/pilot4/pilot4.lisp mode=prepare
;;;;   TLM_BLAS=1 VECLIB_MAXIMUM_THREADS=1 sbcl --dynamic-space-size 6GB --script lisp/experimental/pilot4/pilot4.lisp mode=train arm=a|b|c|d

(let ((src (merge-pathnames "../../src/" (directory-namestring *load-truename*))))
  (require :sb-posix)
  (dolist (f '("util" "sha256" "json" "bpe" "data" "qagen" "retrieval" "tf32" "train32" "pretrain32" "sft32" "qa-analysis"))
    (load (merge-pathnames (format nil "~a.lisp" f) src))))

(defpackage :pilot4
  (:use :cl))
(in-package :pilot4)

(defparameter +seed+ 111404)
(defparameter +batch+ 32)
(defparameter +ctx+ 128)
(defparameter +bundle+ "docs/results/stage2/mission-20261111/pilot4")
(defparameter +run+ "data/runs/retrieval/p4-retention")
(defparameter +init+ "data/runs/retrieval/r7-L123-aug-opts-rev-rsn/last.ckpt")
(defparameter +reference+ "33a5c24521dfb1b28b456b8344bfd0869b84fe56aa622191b8f6bfa71cc42aa1")

(defparameter +arm-specs+
  '(("a" :steps 190 :copy nil :replay nil)
    ("b" :steps 270 :copy t   :replay nil)
    ("c" :steps 420 :copy nil :replay t)
    ("d" :steps 500 :copy t   :replay t)))

(defun opt (key)
  (let ((p (concatenate 'string key "=")))
    (let ((a (find-if (lambda (a) (and (>= (length a) (length p)) (string= p a :end2 (length p))))
                      (cdr sb-ext:*posix-argv*))))
      (and a (subseq a (length p))))))

(defun obj (&rest x) (apply #'asem-qa-analysis::obj x))
(defun qsym (name) (find-symbol name :asem-qagen))
(defun qf (name &rest args) (apply (symbol-function (find-symbol name :asem-qagen)) args))
(defun rf (name &rest args) (apply (symbol-function (find-symbol name :asem-retrieval)) args))
(defun rng-for (i attempt stream)
  (sb-ext:seed-random-state (+ (* +seed+ 1000003) (* i 7919) (* attempt 104729) (* stream 131071))))

(defun set-recipe (bpe)
  (setf asem-retrieval:*augment* t
        asem-retrieval:*reverse* t
        asem-retrieval:*reasoning* t
        asem-retrieval:*broad-train* t
        asem-retrieval:*vocab-words* (asem-retrieval:vocab-words-of bpe)))

(defun person-first-p (frame)
  (< (search "{P}" frame) (or (search "{V}" frame) (search "{aV}" frame))))

(defun slurp (path)
  (with-open-file (s path :external-format :utf-8)
    (let ((text (make-string (file-length s))))
      (subseq text 0 (read-sequence text s)))))

(defun words-of (text)
  (let ((out nil) (start nil))
    (loop for i from 0 to (length text)
          do (if (and (< i (length text)) (alpha-char-p (char text i)))
                 (unless start (setf start i))
                 (when start (push (subseq text start i) out) (setf start nil))))
    out))

(defun whole-word-pos (w s)
  (let ((len (length w)) (slen (length s)))
    (loop for i = (search w s) then (search w s :start2 (1+ i))
          while i
          when (and (or (zerop i) (not (alpha-char-p (char s (1- i)))))
                    (or (= (+ i len) slen) (not (alpha-char-p (char s (+ i len))))))
            do (return i))))

(defvar *assets* nil)
(defvar *excluded* nil)
(defvar *forbid-entities* nil)
(defvar *eval-heldout-id-ht* nil)
(defvar *single-tok-forbid-ht* nil)
(defvar *allowed-induction-ids* nil)
(defvar *clean-names* nil)
(defvar *clean-towns* nil)
(defvar *clean-vocab* nil)
(defvar *clean-semantic-pools* nil)
(defvar *clean-mixed-pools* nil)
(defvar *clean-places-sem* nil)
(defvar *clean-places-mix* nil)
(defvar *fw-2tok* nil)
(defvar *fw-3tok* nil)
(defvar *train-copy-lists* nil)

(defun build-exclusions (bpe)
  (let* ((assets (asem-json:parse-json (slurp (format nil "~a/pilot4-assets.json" +run+))))
         (ex (make-hash-table :test 'equalp))
         (forbid-strict (make-hash-table :test 'equalp))
         (eh-ht (make-hash-table :test 'eql))
         (st-ht (make-hash-table :test 'eql)))
    (setf *assets* assets)
    (maphash (lambda (k v) (declare (ignore v)) (setf (gethash k ex) t (gethash k forbid-strict) t))
             (asem-retrieval::heldout-strings))
    (loop for w across (asem-json:json-get assets "forbid_exact")
          do (setf (gethash w ex) t (gethash w forbid-strict) t))
    (loop for w across (asem-json:json-get assets "forbid_lower")
          do (setf (gethash w ex) t (gethash w forbid-strict) t))
    (setf *excluded* ex
          *forbid-entities* forbid-strict)
    ;; Exclude template/augmentation vocabulary from candidate entity sampling only (not in forbid-strict)
    (let ((aug-words (make-hash-table :test 'equalp)))
      (dolist (s (append asem-retrieval::*modifiers* asem-retrieval::*leads* asem-retrieval::*generic-questions*))
        (dolist (w (words-of s)) (setf (gethash w aug-words) t)))
      (dolist (ty (symbol-value (qsym "*ATTR-TYPES*")))
        (dolist (fr (rf "FRAMES-OF" (cdr ty) :frames :seen))
          (dolist (w (words-of fr))
            (unless (member w '("P" "V" "aV") :test #'string=)
              (setf (gethash w aug-words) t)))))
      (labels ((ok-ent (x) (and (not (gethash x ex)) (not (gethash x aug-words)))))
        (setf *clean-names* (coerce (remove-if-not #'ok-ent (asem-retrieval::broad-pool :names)) 'vector)
              *clean-towns* (coerce (remove-if-not #'ok-ent (asem-retrieval::broad-pool :towns)) 'vector)
              *clean-vocab* (remove-if-not #'ok-ent (asem-retrieval:vocab-words-of bpe)))
        (let ((pl-sem (remove-if-not #'ok-ent (qf "SPLIT-POOL" (symbol-value (qsym "*PLACES*")) :train))))
          (setf *clean-places-sem* (coerce pl-sem 'vector)
                *clean-places-mix* (coerce (append pl-sem *clean-vocab*) 'vector)))
        (setf *clean-semantic-pools* nil
              *clean-mixed-pools* nil)
        (dolist (sym-name '("*TOWNS*" "*JOBS*" "*PETS*" "*COLORS*" "*INSTRUMENTS*"))
          (let* ((sym (qsym sym-name))
                 (sem (if (string= sym-name "*TOWNS*")
                          (coerce *clean-towns* 'list)
                          (remove-if-not #'ok-ent (qf "SPLIT-POOL" (symbol-value sym) :train))))
                 (mix (if (string= sym-name "*TOWNS*")
                          sem
                          (append sem *clean-vocab*))))
            (push (cons sym (coerce sem 'vector)) *clean-semantic-pools*)
            (push (cons sym (coerce mix 'vector)) *clean-mixed-pools*)))))
    ;; Forbidden token IDs: eval_heldout (845) + any single-token BPE ID decoding to a forbidden entity
    (loop for id across (asem-json:json-get assets "eval_heldout_ids")
          do (setf (gethash id eh-ht) t))
    (loop for id from 1 below (asem-bpe:bpe-vocab-size bpe)
          for dec = (string-trim '(#\Space #\Tab #\Return #\Newline) (asem-bpe:bpe-decode bpe (list id)))
          when (and (plusp (length dec))
                    (every #'alpha-char-p dec)
                    (gethash dec forbid-strict))
            do (setf (gethash id st-ht) t))
    (setf *eval-heldout-id-ht* eh-ht
          *single-tok-forbid-ht* st-ht
          *allowed-induction-ids*
            (coerce (loop for id from 1 below (asem-bpe:bpe-vocab-size bpe)
                          unless (or (gethash id eh-ht) (gethash id st-ht))
                            collect id)
                    'vector))
    ;; Clean FineWeb words & train_copy token categories
    (setf *fw-2tok* (coerce (loop for w across (asem-json:json-get assets "fw_tr_2tok")
                                  unless (gethash w ex) collect w) 'vector)
          *fw-3tok* (coerce (loop for w across (asem-json:json-get assets "fw_tr_3tok")
                                  unless (gethash w ex) collect w) 'vector))
    (let ((tc (asem-json:json-get assets "train_copy")))
      (setf *train-copy-lists*
            (loop for cat in '("space_title_alpha" "bare_lower_alpha" "space_lower_alpha" "bare_title_alpha")
                  collect (cons cat (loop for id across (asem-json:json-get tc cat)
                                          when (and (not (gethash id eh-ht)) (not (gethash id st-ht)))
                                            collect id)))))
    (format t "Pools clean: names=~d towns=~d vocab=~d fw2=~d fw3=~d allowed_ind=~d forbid_single=~d~%"
            (length *clean-names*) (length *clean-towns*) (length *clean-vocab*)
            (length *fw-2tok*) (length *fw-3tok*) (length *allowed-induction-ids*)
            (hash-table-count *single-tok-forbid-ht*))))

(defun vec-pick (vec rng) (aref vec (random (length vec) rng)))

(defun vec-sample-n (vec n rng)
  (let ((len (length vec)) (out nil))
    (loop while (< (length out) n)
          do (let ((x (aref vec (random len rng))))
               (unless (member x out :test #'string-equal) (push x out))))
    (nreverse out)))

(defun no-substring-group-p (xs)
  (loop for tail on xs
        for a = (car tail)
        always (loop for b in (cdr tail)
                     never (or (search a b :test #'char-equal)
                               (search b a :test #'char-equal)))))

(defun clean-texts-p (texts)
  (notany (lambda (text) (some (lambda (w) (gethash w *excluded*)) (words-of text))) texts))

(defun pick-pool (sym rng &optional (force-sem nil))
  (if (or force-sem (zerop (random 2 rng)))
      (cdr (assoc sym *clean-semantic-pools*))
      (cdr (assoc sym *clean-mixed-pools*))))

(defun pick-places (rng)
  (if (zerop (random 2 rng)) *clean-places-sem* *clean-places-mix*))

(defun encode-multi-qa (passage qa-entries bpe &key (with-options t))
  "Pack PASSAGE and QA-ENTRIES into (:multi ids rows targets). Checks exact BPE concat and context <= +ctx+."
  (let ((ids (cons 0 (asem-bpe:bpe-encode bpe (format nil "Text: ~a~%" passage))))
        (rows nil) (targets nil) (built-qs nil) (ok t))
    (dolist (entry qa-entries)
      (let* ((q (getf entry :question))
             (ans (getf entry :answer))
             (opts (getf entry :options))
             (qstr (if with-options
                       (format nil "Q: ~a~%~aThe answer is" q (rf "OPTIONS-BLOCK" opts))
                       (format nil "Q: ~a~%The answer is" q)))
             (qtoks (asem-bpe:bpe-encode bpe qstr))
             (atoks (asem-bpe:bpe-encode bpe (format nil " ~a" ans)))
             (tail (asem-bpe:bpe-encode bpe (format nil ".~%"))))
        (unless (equal (asem-bpe:bpe-encode bpe (format nil "~a ~a" qstr ans))
                       (append qtoks atoks))
          (setf ok nil)
          (return))
        (when (> (+ (length ids) (length qtoks) (length atoks) (length tail)) +ctx+)
          (return))
        (setf ids (append ids qtoks))
        (loop for tk in atoks for k from 0
              do (push (+ (length ids) k -1) rows)
                 (push tk targets))
        (setf ids (append ids atoks tail))
        (push entry built-qs)))
    (when (and ok rows (<= (length ids) +ctx+))
      (list :kind :multi :ids ids :rows (nreverse rows) :targets (nreverse targets)
            :qs (nreverse built-qs) :passage passage))))

;;; ------------------------------------------------------------------ Component 1: Answer-Before Retrieval (6,080 shared)
(defun build-ans-before-one (i bpe seen-fact seen-seq)
  (loop for attempt from 0 do
    (when (> attempt 500) (error "build-ans-before-one hung at i=~d" i))
    (let* ((rng (rng-for i attempt 1))
           (level (if (zerop (random 4 rng)) 2 3))
           (n (ecase level (2 2) (3 4)))
           (mode (if (< (random 4 rng) 3) :pf-rev :vf-ext))
           (ty (if (eq mode :pf-rev)
                   (qf "PICK" (symbol-value (qsym "*ATTR-TYPES*")) rng)
                   (qf "PICK" (remove-if-not (lambda (x) (member (car x) '(:town :instrument)))
                                             (symbol-value (qsym "*ATTR-TYPES*")))
                       rng)))
           (spec (cdr ty))
           (pool-sym (getf spec :pool))
           (vpool (pick-pool pool-sym rng nil))
           (people (loop do (let ((ps (vec-sample-n *clean-names* n rng)))
                              (when (no-substring-group-p ps) (return ps)))))
           (vals (loop do (let ((vs (vec-sample-n vpool n rng)))
                            (when (and (no-substring-group-p vs)
                                       (no-substring-group-p (append people vs)))
                              (return vs)))))
           (frames (rf "FRAMES-OF" spec :frames :seen))
           (sframes (if (eq mode :pf-rev)
                        (remove-if-not #'person-first-p frames)
                        (remove-if #'person-first-p frames)))
           (qext (rf "FRAMES-OF" spec :q-extract :seen))
           (qrev (rf "FRAMES-OF" spec :q-reverse :seen))
           (sents nil) (qa nil) (pairs nil))
      (loop for p in people for v in vals
            for sf = (qf "PICK" sframes rng)
            for qf-str = (qf "PICK" (if (eq mode :pf-rev) qrev qext) rng)
            for sent = (qf "FILL-FRAME" sf :p p :v v)
            for q = (if (eq mode :pf-rev) (qf "FILL-FRAME" qf-str :v v) (qf "FILL-FRAME" qf-str :p p))
            for ans = (if (eq mode :pf-rev) p v)
            do (push sent sents)
               (push (cons q ans) qa)
               (push (list :p p :v v :sf sf :qf qf-str) pairs))
      (setf sents (nreverse sents) qa (nreverse qa) pairs (nreverse pairs))
      (multiple-value-bind (aug-sents aug-qa)
          (rf "AUGMENTED" sents qa people (car ty) (append people vals) rng people ty)
        (when (loop for as in aug-sents for pr in pairs
                    always (let ((ip (whole-word-pos (getf pr :p) as))
                                 (iv (whole-word-pos (getf pr :v) as)))
                             (and ip iv (if (eq mode :pf-rev) (< ip iv) (< iv ip)))))
          (let* ((perm-s (qf "SHUFFLE" aug-sents rng))
                 (passage (format nil "~{~a~^ ~}" perm-s))
                 (shuf-qa (qf "SHUFFLE" aug-qa rng))
                 (entries nil) (opt-ok t) (texts (list passage)))
            (dolist (x shuf-qa)
              (let* ((ans (cdr x))
                     (cands (if (eq mode :pf-rev) people vals))
                     (padder (if (eq mode :pf-rev)
                                 (lambda () (vec-pick *clean-names* rng))
                                 (lambda () (vec-pick vpool rng))))
                     (opts (rf "OPTIONS-FOR" ans cands padder rng)))
                (unless opts (setf opt-ok nil) (return))
                (push (car x) texts) (push ans texts) (dolist (o opts) (push o texts))
                (push (list :question (car x) :answer ans :options opts
                            :subtype (format nil "~a-~a" (string-downcase (symbol-name (car ty)))
                                             (if (eq mode :pf-rev) "pf-rev" "vf-ext")))
                      entries)))
            (setf entries (nreverse entries))
            (when (and opt-ok (clean-texts-p texts))
              (let ((enc (encode-multi-qa passage entries bpe :with-options t)))
                (when enc
                  (let* ((sig (format nil "~a|~{~a~^|~}" (car ty)
                                      (sort (mapcar (lambda (x) (format nil "~a:~a" (getf x :p) (getf x :v))) pairs) #'string<)))
                         (seq-key (cons passage (getf (first (getf enc :qs)) :question))))
                    (when (and (not (gethash sig seen-fact))
                               (not (gethash seq-key seen-seq)))
                      (setf (gethash sig seen-fact) t
                            (gethash seq-key seen-seq) t)
                      (return (list :enc enc :mode mode :level level :attr (car ty) :attempts attempt)))))))))))))

(defun build-ans-before-seqs (n bpe)
  (let ((seen-fact (make-hash-table :test 'equal))
        (seen-seq (make-hash-table :test 'equal))
        (recs (make-array n))
        (stats (make-hash-table :test 'equal)))
    (dotimes (i n)
      (let* ((res (build-ans-before-one i bpe seen-fact seen-seq))
             (enc (getf res :enc)))
        (setf (aref recs i) enc)
        (incf (gethash (format nil "~a|L~d" (getf res :mode) (getf res :level)) stats 0))
        (incf (gethash "qs" stats 0) (length (getf enc :qs)))
        (incf (gethash "toks" stats 0) (length (getf enc :targets)))))
    (values recs stats seen-fact)))

;;; ------------------------------------------------------------------ Component 2: Contextual Entity/Span Copy (2,560 shared by B & D)
(defun make-fw-copy-seqs (bpe)
  "1,000 FineWeb real-word prose copy sequences (no options): 608 fw_tr_2tok + 166 fw_tr_3tok."
  (let* ((pool (append (loop for w across *fw-2tok* collect w)
                       (loop for w across *fw-3tok* collect w)))
         (targets-list nil)
         (rng0 (rng-for 0 0 2)))
    ;; Guarantee every one of 774 fw_tr words appears at least once, plus 226 balanced extras -> 1,000
    (setf targets-list (append pool (loop repeat (- 1000 (length pool)) collect (nth (random (length pool) rng0) pool))))
    (setf targets-list (qf "SHUFFLE" targets-list rng0))
    (let ((out (make-array 1000)))
      (loop for e-primary in targets-list for idx from 0 do
        (setf (aref out idx)
              (loop for attempt from 0 do
                (when (> attempt 500) (error "make-fw-copy-seqs hung at idx=~d e=~s" idx e-primary))
                (let* ((rng (rng-for idx attempt 20))
                       (nsents (cond ((< (mod idx 10) 6) 1) ((< (mod idx 10) 8) 2) (t 3)))
                       (words (cons e-primary
                                    (loop repeat (1- nsents) collect (nth (random (length pool) rng) pool))))
                       (sents nil) (qlist nil) (used nil) (role-list nil))
                  (when (= (length (remove-duplicates words :test #'string-equal)) nsents)
                    (loop for ew in words for s-idx from 0 do
                      (let* ((as-person (zerop (random 2 rng)))
                             (vf (zerop (random 2 rng)))
                             (partner (loop do (let ((c (if as-person
                                                            (vec-pick *clean-towns* rng)
                                                            (vec-pick *clean-names* rng))))
                                                 (unless (member c used :test #'string-equal) (return c))))))
                        (push ew used) (push partner used)
                        (push (list :e ew :partner partner :as-person as-person :vf vf) role-list)
                        (let* ((sf (cond ((and as-person (not vf)) "{E} lives in {P}.")
                                         ((and as-person vf) "In {P} lives {E}.")
                                         ((and (not as-person) (not vf)) "{P} lives in {E}.")
                                         (t "In {E} lives {P}.")))
                               (qf (if as-person "Who lives in {P}?" "Where does {P} live?")))
                          (push (qf "REPLACE-ALL" (qf "REPLACE-ALL" sf "{E}" ew) "{P}" partner) sents)
                          (push (list :question (qf "REPLACE-ALL" qf "{P}" partner)
                                      :answer ew :options nil)
                                qlist))))
                    (when (clean-texts-p sents)
                      (let* ((perm-s (qf "SHUFFLE" (nreverse sents) rng))
                             (passage (format nil "~{~a~^ ~}" perm-s))
                             (qset (let ((rev-q (nreverse qlist)))
                                     (if (= nsents 1) rev-q (subseq rev-q 0 2))))
                             (enc (encode-multi-qa passage (qf "SHUFFLE" qset rng) bpe :with-options nil)))
                        (when (and enc (every (lambda (qe) (= 1 (qf "WORD-BOUNDARY-COUNT" (getf qe :answer) passage))) (getf enc :qs)))
                          (return enc)))))))))
      out)))

(defun compose-clean-word (bpe onset-ids tail-ids rng ntoks &key (offset 0))
  "Compose a 2- or 3-token BPE-roundtrip-exact word targeting the least-used onset/tail IDs."
  (loop for try from 0 below 160 do
    (let* ((t0 (nth (mod (+ offset (floor try 20)) (length onset-ids)) onset-ids))
           (ts (list t0))
           (pool1 (car tail-ids))
           (pool2 (or (cdr tail-ids) pool1)))
      (dotimes (k (1- ntoks))
        (let* ((pl (if (and (= k 0) pool2) pool2 pool1))
               (lim (min 12 (length pl))))
          (push (nth (mod (+ offset (random lim rng)) (length pl)) pl) ts)))
      (setf ts (nreverse ts))
      (let* ((raw (asem-bpe:bpe-decode bpe ts))
             (w (and (plusp (length raw)) (char= (char raw 0) #\Space) (subseq raw 1))))
        (when (and w (>= (length w) 4) (every #'alpha-char-p w)
                   (not (gethash w *excluded*))
                   (equal (asem-bpe:bpe-encode bpe raw) ts))
          (return (values w ts)))))))

(defun make-subword-copy-seqs (bpe)
  "960 sequences (96 1-sent/1Q, 144 2-sent/2Q, 720 3-sent/3Q = 2,544 words) covering >=2x every train_copy token."
  (let* ((st (cdr (assoc "space_title_alpha" *train-copy-lists* :test #'string=)))
         (bl (cdr (assoc "bare_lower_alpha"  *train-copy-lists* :test #'string=)))
         (sl (cdr (assoc "space_lower_alpha" *train-copy-lists* :test #'string=)))
         (bt (cdr (assoc "bare_title_alpha"  *train-copy-lists* :test #'string=)))
         (counts (make-hash-table :test 'eql))
         (out (make-array 960)))
    (dolist (lst (list st bl sl bt)) (dolist (id lst) (setf (gethash id counts 0) 0)))
    (labels ((sorted-ids (lst)
               (sort (copy-list lst) #'< :key (lambda (id) (gethash id counts 0))))
             (min-cnt (lst)
               (loop for id in lst minimize (gethash id counts 0)))
             (bump-ids (ids)
               (dolist (id ids) (incf (gethash id counts 0))))
             (make-word (rng kind offset)
               (let* ((ntoks (if (< (random 10 rng) 8) 3 2))
                      (st-s (sorted-ids st))
                      (sl-s (sorted-ids sl))
                      (bl-s (sorted-ids bl))
                      (bt-s (sorted-ids bt)))
                 (multiple-value-bind (w tids)
                     (ecase kind
                       (:title-bt (compose-clean-word bpe st-s (cons bl-s bt-s) rng ntoks :offset offset))
                       (:title    (compose-clean-word bpe st-s (cons bl-s bl-s) rng ntoks :offset offset))
                       (:lower    (compose-clean-word bpe sl-s (cons bl-s bl-s) rng ntoks :offset offset)))
                   (when w
                     (values w tids (not (eq kind :lower))))))))
      (dotimes (idx 960)
        (let ((nsents (cond ((< idx 96) 1) ((< idx 240) 2) (t 3))))
          (setf (aref out idx)
                (loop for attempt from 0 do
                  (when (> attempt 500) (error "make-subword-copy-seqs hung at idx=~d nsents=~d" idx nsents))
                  (let* ((rng (rng-for idx attempt 21))
                         (sents nil) (qlist nil) (used nil) (all-tids nil) (ok t))
                    (dotimes (s-idx nsents)
                      (let* ((need-bt (< (min-cnt bt) 2))
                             (need-st (< (min-cnt st) 2))
                             (need-sl (< (min-cnt sl) 2))
                             (kind (cond (need-bt :title-bt)
                                         ((and need-sl (not need-st)) :lower)
                                         ((and need-st (not need-sl)) :title)
                                         ((< (min-cnt sl) (min-cnt st)) :lower)
                                         ((> (min-cnt sl) (min-cnt st)) :title)
                                         ((= (mod (+ idx s-idx attempt) 2) 0) :title)
                                         (t :lower))))
                        (multiple-value-bind (w tids titlep) (make-word rng kind s-idx)
                            (when (or (null w) (member w used :test #'string-equal))
                              (setf ok nil) (return))
                            (push w used) (push tids all-tids)
                            (let* ((vf (zerop (random 2 rng)))
                                   (partner (loop do (let ((c (if titlep
                                                                  (vec-pick *clean-towns* rng)
                                                                  (vec-pick *clean-names* rng))))
                                                       (unless (member c used :test #'string-equal) (return c))))))
                              (push partner used)
                              (cond
                                (titlep
                                 (let ((sf (if vf "In {T} lives {P}." "{P} lives in {T}."))
                                       (qf "Who lives in {T}?"))
                                   (push (qf "FILL-FRAME" sf :p w :t partner) sents)
                                   (push (list :question (qf "FILL-FRAME" qf :t partner) :answer w :options nil) qlist)))
                                (t
                                 (let ((attr-choice (random 3 rng)))
                                   (ecase attr-choice
                                     (0 (push (qf "FILL-FRAME" "{P} works as {aV}." :p partner :v w) sents)
                                        (push (list :question (qf "FILL-FRAME" "What is {P}'s job?" :p partner) :answer w :options nil) qlist))
                                     (1 (push (qf "FILL-FRAME" "{P} likes the color {V} best." :p partner :v w) sents)
                                        (push (list :question (qf "FILL-FRAME" "What color does {P} prefer?" :p partner) :answer w :options nil) qlist))
                                     (2 (let ((sf (if vf "The {V} is the instrument {P} plays." "{P} plays the {V}.")))
                                          (push (qf "FILL-FRAME" sf :p partner :v w) sents)
                                          (push (list :question (qf "FILL-FRAME" "What instrument does {P} play?" :p partner) :answer w :options nil) qlist)))))))))))
                      (when (and ok (clean-texts-p sents) (no-substring-group-p used))
                        (let* ((passage (format nil "~{~a~^ ~}" (qf "SHUFFLE" sents rng)))
                               (enc (encode-multi-qa passage (qf "SHUFFLE" qlist rng) bpe :with-options nil)))
                          (when (and enc (= (length (getf enc :qs)) nsents)
                                     (every (lambda (qe) (= 1 (qf "WORD-BOUNDARY-COUNT" (getf qe :answer) passage))) (getf enc :qs)))
                            (dolist (tids all-tids) (bump-ids tids))
                            (return enc)))))))))
      ;; Assert >=2 coverage across every allowed token of all 4 train_copy classes
      (let ((min-cov (make-hash-table :test 'equal)) (uncovered nil))
        (dolist (pair *train-copy-lists*)
          (let ((cat (car pair)) (mn most-positive-fixnum))
            (dolist (id (cdr pair))
              (let ((c (gethash id counts 0)))
                (setf mn (min mn c))
                (when (< c 2) (push (list cat id c) uncovered))))
            (setf (gethash cat min-cov) mn)))
        (format t "train_copy min coverage per class: ~{~a=~d~^, ~}~%"
                (loop for p in *train-copy-lists* append (list (car p) (gethash (car p) min-cov))))
        (when uncovered
          (error "train_copy tokens with <2 target coverage: ~d (e.g. ~s)" (length uncovered) (subseq uncovered 0 (min 5 (length uncovered))))))
      out)))

(defun make-guard-copy-seqs ()
  "600 random-token induction guard sequences strictly from *allowed-induction-ids* (k in [12, 48])."
  (let ((n-allowed (length *allowed-induction-ids*))
        (out (make-array 600)))
    (dotimes (i 600)
      (let* ((rng (rng-for i 0 22))
             (k (+ 12 (random 37 rng))) ; 12..48 -> seq len 25..97 <= 128
             (s (loop repeat k collect (aref *allowed-induction-ids* (random n-allowed rng)))))
        (setf (aref out i) (list :kind :copy :ids (append (list 0) s (list (first s)))
                                 :rows nil :targets (rest s) :passage ""))))
    out))

(defun build-copy-seqs (bpe)
  (let* ((fw (make-fw-copy-seqs bpe))
         (sc (make-subword-copy-seqs bpe))
         (gd (make-guard-copy-seqs))
         (all (make-array 2560)))
    (replace all fw :start1 0)
    (replace all sc :start1 1000)
    (replace all gd :start1 1960)
    all))

;;; ------------------------------------------------------------------ Component 3: Multi-Task & Format Replay (7,360 shared by C & D)
(defun sample-level (rng)
  (let ((r (random 10 rng)))
    (cond ((< r 2) 1) ((< r 5) 2) (t 3))))

(defun clean-distractors (people exclude-ty rng k)
  (loop repeat k
        collect (let* ((ty (qf "PICK" (remove exclude-ty (symbol-value (qsym "*ATTR-TYPES*"))) rng))
                       (spec (cdr ty))
                       (vpool (pick-pool (getf spec :pool) rng nil)))
                  (qf "FILL-FRAME" (qf "PICK" (rf "FRAMES-OF" spec :frames :seen) rng)
                      :p (qf "PICK" people rng) :v (vec-pick vpool rng)))))

(defun build-replay-one (i kind bpe)
  (loop for attempt from 0 do
    (when (> attempt 500) (error "build-replay-one hung at i=~d kind=~a" i kind))
    (let ((rng (rng-for i attempt 3))
          (level (sample-level (rng-for i attempt 30))))
      (multiple-value-bind (passage entries)
          (ecase kind
            (:ext-attr
             (let* ((ty (qf "PICK" (symbol-value (qsym "*ATTR-TYPES*")) rng))
                    (spec (cdr ty)) (n (ecase level (1 1) (2 2) (3 4)))
                    (vpool (pick-pool (getf spec :pool) rng nil))
                    (people (loop do (let ((ps (vec-sample-n *clean-names* n rng))) (when (no-substring-group-p ps) (return ps)))))
                    (vals (loop do (let ((vs (vec-sample-n vpool n rng)))
                                     (when (and (no-substring-group-p vs) (no-substring-group-p (append people vs))) (return vs)))))
                    (pf (remove-if-not #'person-first-p (rf "FRAMES-OF" spec :frames :seen)))
                    (qext (rf "FRAMES-OF" spec :q-extract :seen))
                    (sents (loop for p in people for v in vals collect (qf "FILL-FRAME" (qf "PICK" pf rng) :p p :v v)))
                    (qa (loop for p in people for v in vals collect (cons (qf "FILL-FRAME" (qf "PICK" qext rng) :p p) v))))
               (multiple-value-bind (as aq) (rf "AUGMENTED" sents qa people (car ty) (append people vals) rng people ty)
                 (let* ((extra (when (and (= level 3) (< (random 10 rng) 3)) (clean-distractors people ty rng 1)))
                        (psg (format nil "~{~a~^ ~}" (qf "SHUFFLE" (append as extra) rng)))
                        (es (loop for x in (qf "SHUFFLE" aq rng)
                                  for opts = (rf "OPTIONS-FOR" (cdr x) vals (lambda () (vec-pick vpool rng)) rng)
                                  when opts collect (list :question (car x) :answer (cdr x) :options opts))))
                   (when (= (length es) (length aq)) (values psg es))))))
            (:ext-num
             (let* ((ty (qf "PICK" (symbol-value (qsym "*NUM-TYPES*")) rng))
                    (spec (cdr ty)) (n (ecase level (1 1) (2 2) (3 4)))
                    (people (loop do (let ((ps (vec-sample-n *clean-names* n rng))) (when (no-substring-group-p ps) (return ps)))))
                    (vals (destructuring-bind (lo hi) (getf spec :range) (qf "DISTINCT-NUMBERS" lo hi n rng)))
                    (vstrs (mapcar #'princ-to-string vals))
                    (sents (loop for p in people for v in vals collect (qf "FILL-FRAME" (qf "PICK" (rf "FRAMES-OF" spec :frames :seen) rng) :p p :n v :v v)))
                    (qa (loop for p in people for vs in vstrs collect (cons (qf "FILL-FRAME" (qf "PICK" (rf "FRAMES-OF" spec :q-extract :seen) rng) :p p) vs))))
               (multiple-value-bind (as aq) (rf "AUGMENTED" sents qa people (car ty) (append people vstrs) rng people ty)
                 (let* ((psg (format nil "~{~a~^ ~}" (qf "SHUFFLE" as rng)))
                        (padder (lambda () (destructuring-bind (lo hi) (getf spec :range) (princ-to-string (+ lo (random (1+ (- hi lo)) rng))))))
                        (es (loop for x in (qf "SHUFFLE" aq rng)
                                  for opts = (rf "OPTIONS-FOR" (cdr x) vstrs padder rng)
                                  when opts collect (list :question (car x) :answer (cdr x) :options opts))))
                   (when (= (length es) (length aq)) (values psg es))))))
            (:vf-rev
             (let* ((ty (qf "PICK" (remove-if-not (lambda (x) (member (car x) '(:town :instrument)))
                                                  (symbol-value (qsym "*ATTR-TYPES*")))
                            rng))
                    (spec (cdr ty)) (n (ecase level (1 1) (2 2) (3 4)))
                    (vpool (pick-pool (getf spec :pool) rng t)) ; semantic towns/instruments
                    (people (loop do (let ((ps (vec-sample-n *clean-names* n rng))) (when (no-substring-group-p ps) (return ps)))))
                    (vals (loop do (let ((vs (vec-sample-n vpool n rng)))
                                     (when (and (no-substring-group-p vs) (no-substring-group-p (append people vs))) (return vs)))))
                    (vf (remove-if #'person-first-p (rf "FRAMES-OF" spec :frames :seen)))
                    (qrev (rf "FRAMES-OF" spec :q-reverse :seen))
                    (sents (loop for p in people for v in vals collect (qf "FILL-FRAME" (qf "PICK" vf rng) :p p :v v)))
                    (qa (loop for p in people for v in vals collect (cons (qf "FILL-FRAME" (qf "PICK" qrev rng) :v v) p))))
               (multiple-value-bind (as aq) (rf "AUGMENTED" sents qa people (car ty) (append people vals) rng people ty)
                 (let* ((psg (format nil "~{~a~^ ~}" (qf "SHUFFLE" as rng)))
                        (es (loop for x in (qf "SHUFFLE" aq rng)
                                  for opts = (rf "OPTIONS-FOR" (cdr x) people (lambda () (vec-pick *clean-names* rng)) rng)
                                  when opts collect (list :question (car x) :answer (cdr x) :options opts))))
                   (when (= (length es) (length aq)) (values psg es))))))
            (:rel
             (let* ((rel (qf "PICK" (symbol-value (qsym "*RELATIONS*")) rng))
                    (spec (cdr rel))
                    (people (loop do (let ((ps (vec-sample-n *clean-names* (ecase level (1 2) (2 4) (3 4)) rng)))
                                       (when (no-substring-group-p ps) (return ps)))))
                    (pairs (ecase level
                             (1 (list (list (first people) (second people))))
                             (2 (list (list (first people) (second people)) (list (third people) (fourth people))))
                             (3 (list (list (first people) (second people)) (list (second people) (third people)) (list (third people) (fourth people))))))
                    (sents (mapcar (lambda (pr) (qf "FILL-FRAME" (qf "PICK" (rf "FRAMES-OF" spec :frames :seen) rng) :a (first pr) :b (second pr))) pairs))
                    (qa (mapcar (lambda (pr) (if (zerop (random 2 rng))
                                                 (cons (qf "FILL-FRAME" (qf "PICK" (rf "FRAMES-OF" spec :q-subj :seen) rng) :b (second pr)) (first pr))
                                                 (cons (qf "FILL-FRAME" (qf "PICK" (rf "FRAMES-OF" spec :q-obj :seen) rng) :a (first pr)) (second pr))))
                                pairs)))
               (multiple-value-bind (as aq) (rf "AUGMENTED" sents qa nil nil people rng people rel)
                 (let* ((psg (format nil "~{~a~^ ~}" (qf "SHUFFLE" as rng)))
                        (es (loop for x in (qf "SHUFFLE" aq rng)
                                  for opts = (rf "OPTIONS-FOR" (cdr x) people (lambda () (vec-pick *clean-names* rng)) rng)
                                  when opts collect (list :question (car x) :answer (cdr x) :options opts))))
                   (when (= (length es) (length aq)) (values psg es))))))
            (:cmp
             (let* ((ty (qf "PICK" (symbol-value (qsym "*NUM-TYPES*")) rng))
                    (spec (cdr ty)) (n (ecase level (1 2) (2 3) (3 4)))
                    (people (loop do (let ((ps (vec-sample-n *clean-names* n rng))) (when (no-substring-group-p ps) (return ps)))))
                    (vals (destructuring-bind (lo hi) (getf spec :range) (qf "DISTINCT-NUMBERS" lo hi n rng)))
                    (sents (loop for p in people for v in vals collect (qf "FILL-FRAME" (qf "PICK" (rf "FRAMES-OF" spec :frames :seen) rng) :p p :n v :v v)))
                    (best (lambda (fn) (nth (position (reduce fn vals) vals) people)))
                    (qa (list (cons (qf "FILL-FRAME" (qf "PICK" (rf "FRAMES-OF" spec :q-max :seen) rng)) (funcall best #'max))
                              (cons (qf "FILL-FRAME" (qf "PICK" (rf "FRAMES-OF" spec :q-min :seen) rng)) (funcall best #'min)))))
               (multiple-value-bind (as aq) (rf "AUGMENTED" sents qa nil nil (append people (mapcar #'princ-to-string vals)) rng people ty)
                 (let* ((psg (format nil "~{~a~^ ~}" (qf "SHUFFLE" as rng)))
                        (es (loop for x in (qf "SHUFFLE" aq rng)
                                  for opts = (rf "OPTIONS-FOR" (cdr x) people (lambda () (vec-pick *clean-names* rng)) rng)
                                  when opts collect (list :question (car x) :answer (cdr x) :options opts))))
                   (when (= (length es) (length aq)) (values psg es))))))
            (:tmp
             (let* ((tm (symbol-value (qsym "*TEMPORAL*"))) (k (ecase level (1 2) (2 3) (3 4)))
                    (ppool (pick-places rng))
                    (p (vec-pick *clean-names* rng))
                    (places (loop do (let ((pls (vec-sample-n ppool k rng)))
                                       (when (no-substring-group-p (cons p pls)) (return pls)))))
                    (sents (loop for x in places for j from 0
                                 collect (qf "FILL-FRAME" (qf "PICK" (rf "FRAMES-OF" tm (cond ((= j 0) :first) ((= j (1- k)) :last) (t :middle)) :seen) rng) :p p :x x)))
                    (qa (append (list (cons (qf "FILL-FRAME" (qf "PICK" (rf "FRAMES-OF" tm :q-first :seen) rng) :p p) (first places))
                                      (cons (qf "FILL-FRAME" (qf "PICK" (rf "FRAMES-OF" tm :q-last :seen) rng) :p p) (car (last places))))
                                (loop for j from 0 below (1- k)
                                      collect (if (zerop (random 2 rng))
                                                  (cons (qf "FILL-FRAME" (qf "PICK" (rf "FRAMES-OF" tm :q-after :seen) rng) :p p :x (nth j places)) (nth (1+ j) places))
                                                  (cons (qf "FILL-FRAME" (qf "PICK" (rf "FRAMES-OF" tm :q-before :seen) rng) :p p :x (nth j places)) (nth j places)))))))
               (multiple-value-bind (as aq) (rf "AUGMENTED" sents qa nil nil (cons p places) rng (list p) :temporal)
                 ;; Keep narrative order strictly unshuffled for temporal!
                 (let* ((psg (format nil "~{~a~^ ~}" as))
                        (es (loop for x in (qf "SHUFFLE" aq rng)
                                  for opts = (rf "OPTIONS-FOR" (cdr x) places (lambda () (vec-pick ppool rng)) rng)
                                  when opts collect (list :question (car x) :answer (cdr x) :options opts))))
                   (when (= (length es) (length aq)) (values psg es)))))))
        (when (and passage entries)
          (let ((texts (cons passage (loop for e in entries append (cons (getf e :question) (cons (getf e :answer) (getf e :options)))))))
            (when (clean-texts-p texts)
              (let ((enc (encode-multi-qa passage entries bpe :with-options t)))
                (when enc (return (list :enc enc :level level)))))))))))

(defun build-replay-seqs (bpe)
  "7,360 sequences: 1840 ext-attr, 1251 ext-num, 1089 vf-rev, 1170 rel, 1001 cmp, 1009 tmp."
  (let* ((plan '((:ext-attr . 1840) (:ext-num . 1251) (:vf-rev . 1089)
                 (:rel . 1170) (:cmp . 1001) (:tmp . 1009)))
         (kinds (make-array 7360)) (k 0))
    (dolist (pair plan)
      (dotimes (j (cdr pair))
        (setf (aref kinds k) (car pair))
        (incf k)))
    ;; Interleave cleanly via deterministic shuffle on stream 30
    (let ((shuf (coerce (qf "SHUFFLE" (coerce kinds 'list) (rng-for 0 0 31)) 'vector))
          (out (make-array 7360))
          (stats (make-hash-table :test 'equal)))
      (dotimes (i 7360)
        (let* ((kd (aref shuf i))
               (res (build-replay-one i kd bpe))
               (enc (getf res :enc)))
          (setf (aref out i) enc)
          (incf (gethash (string-downcase (symbol-name kd)) stats 0))
          (incf (gethash (format nil "L~d" (getf res :level)) stats 0))))
      (values out stats))))

(defun build-internal-dev (bpe)
  "200 non-probe, non-D1 internal sanity items for sft logging only."
  (let ((items nil) (seen-fact (make-hash-table :test 'equal)) (seen-seq (make-hash-table :test 'equal)))
    (dotimes (i 200)
      (let* ((rec (build-ans-before-one (+ 100000 i) bpe seen-fact seen-seq))
             (enc (getf rec :enc))
             (q0 (first (getf enc :qs)))
             (opts (getf q0 :options))
             (ai (position (getf q0 :answer) opts :test #'string=)))
        (push (list :id (format nil "p4-idev-~3,'0d" i) :category "ans_before" :subtype (getf q0 :subtype)
                    :qframe "" :passage (getf enc :passage) :question (getf q0 :question)
                    :options opts :answer ai)
              items)))
    (nreverse items)))

;;; ------------------------------------------------------------------ Strict Zero-Leakage Verifier
(defun verify-zero-leakage (vecs label bpe)
  "Verify zero eval_heldout token IDs, zero forbidden entity words in decoded text, zero probe/D1 IDs in guard."
  (let ((eh-hits 0) (guard-forbid-hits 0) (word-hits 0) (sample-leaks nil))
    (dolist (pair vecs)
      (destructuring-bind (name . vec) pair
        (dotimes (i (length vec))
          (let* ((rec (aref vec i))
                 (ids (getf rec :ids))
                 (tgts (getf rec :targets))
                 (kind (getf rec :kind)))
            (dolist (tk ids)
              (when (gethash tk *eval-heldout-id-ht*) (incf eh-hits))
              (when (and (eq kind :copy) (gethash tk *single-tok-forbid-ht*)) (incf guard-forbid-hits)))
            (dolist (tk tgts)
              (when (gethash tk *eval-heldout-id-ht*) (incf eh-hits))
              (when (and (eq kind :copy) (gethash tk *single-tok-forbid-ht*)) (incf guard-forbid-hits)))
            (unless (eq kind :copy)
              (let ((txt (asem-bpe:bpe-decode bpe ids)))
                (dolist (w (words-of txt))
                  (when (gethash w *forbid-entities*)
                    (incf word-hits)
                    (when (< (length sample-leaks) 10)
                      (push (list name i w) sample-leaks))))))))))
    (format t "[~a] leakage audit: eval_heldout_ids=~d guard_forbid_ids=~d forbid_entity_words=~d~%"
            label eh-hits guard-forbid-hits word-hits)
    (when (or (plusp eh-hits) (plusp guard-forbid-hits) (plusp word-hits))
      (error "ZERO-LEAKAGE FAILED (~a): eh=~d guard=~d words=~d samples=~s"
             label eh-hits guard-forbid-hits word-hits (nreverse sample-leaks)))
    t))

(defun save-sexp (path x)
  (with-open-file (s path :direction :output :if-exists :supersede :if-does-not-exist :create)
    (with-standard-io-syntax (write x :stream s :readably t))))
(defun read-sexp (path)
  (with-open-file (s path) (let ((*read-eval* nil)) (read s))))
(defun write-json (path x)
  (with-open-file (s path :direction :output :if-exists :supersede :if-does-not-exist :create :external-format :utf-8)
    (asem-json:write-json x s) (terpri s)))
(defun ht-to-obj (ht)
  (cons :obj (sort (loop for k being the hash-keys of ht using (hash-value v) collect (cons k v))
                   #'string< :key #'car)))

(defun combine-shuffled (vecs stream)
  (let* ((items (loop for v in vecs append (coerce v 'list)))
         (shuf (qf "SHUFFLE" items (rng-for 0 0 stream))))
    (mapcar (lambda (r) (list (getf r :kind) (getf r :ids) (getf r :rows) (getf r :targets)))
            shuf)))

(defun prepare (bpe)
  (ensure-directories-exist (format nil "~a/" +run+))
  (set-recipe bpe)
  (build-exclusions bpe) (finish-output)
  (format t "Step 1: building 6,080 ans_before seqs...~%") (finish-output)
  (multiple-value-bind (ab-vec ab-stats) (build-ans-before-seqs 6080 bpe)
    (format t "Step 2: building 2,560 copy seqs...~%") (finish-output)
    (let ((cp-vec (build-copy-seqs bpe)))
      (format t "Step 3: building 7,360 replay seqs...~%") (finish-output)
      (multiple-value-bind (rp-vec rp-stats) (build-replay-seqs bpe)
        (format t "Step 4: verifying zero leakage...~%") (finish-output)
        (verify-zero-leakage (list (cons "ans_before" ab-vec)
                                   (cons "copy" cp-vec)
                                   (cons "replay" rp-vec))
                             "ALL-COMPONENTS" bpe)
        (let* ((dev-items (build-internal-dev bpe))
               (dev-word-hits (loop for it in dev-items
                                    sum (count-if (lambda (w) (gethash w *forbid-entities*))
                                                  (append (words-of (getf it :passage))
                                                          (words-of (getf it :question))
                                                          (loop for o in (getf it :options) append (words-of o))))))
               (data-a (combine-shuffled (list ab-vec) 101))
               (data-b (combine-shuffled (list ab-vec cp-vec) 102))
               (data-c (combine-shuffled (list ab-vec rp-vec) 103))
               (data-d (combine-shuffled (list ab-vec cp-vec rp-vec) 104))
               (paths (list (cons "a" (format nil "~a/data-train-a.sexp" +run+))
                            (cons "b" (format nil "~a/data-train-b.sexp" +run+))
                            (cons "c" (format nil "~a/data-train-c.sexp" +run+))
                            (cons "d" (format nil "~a/data-train-d.sexp" +run+))))
               (dev-path (format nil "~a/internal-dev-200.sexp" +run+)))
          (when (plusp dev-word-hits) (error "Internal dev leakage: ~d" dev-word-hits))
          (save-sexp (cdr (assoc "a" paths :test #'string=)) data-a)
          (save-sexp (cdr (assoc "b" paths :test #'string=)) data-b)
          (save-sexp (cdr (assoc "c" paths :test #'string=)) data-c)
          (save-sexp (cdr (assoc "d" paths :test #'string=)) data-d)
          (save-sexp dev-path dev-items)
          (unless (and (= (length data-a) 6080) (= (length data-b) 8640)
                       (= (length data-c) 13440) (= (length data-d) 16000))
            (error "Unexpected arm sizes"))
          (let ((audit
                  (obj "schema" "asem-pilot4-data-1"
                       "seed" +seed+
                       "batch" +batch+
                       "arm_counts" (obj "a" 6080 "b" 8640 "c" 13440 "d" 16000)
                       "arm_steps"  (obj "a" 190  "b" 270  "c" 420   "d" 500)
                       "ans_before_stats" (ht-to-obj ab-stats)
                       "replay_stats" (ht-to-obj rp-stats)
                       "leakage" (obj "eval_heldout_ids" 0 "guard_forbid_ids" 0 "forbid_entity_words" 0 "internal_dev_leaks" 0)
                       "sha256"
                       (obj "init_ckpt" (asem-sha256:sha256-file-hex +init+)
                            "pilot4-assets.json" (asem-sha256:sha256-file-hex (format nil "~a/pilot4-assets.json" +run+))
                            "data-train-a.sexp" (asem-sha256:sha256-file-hex (cdr (assoc "a" paths :test #'string=)))
                            "data-train-b.sexp" (asem-sha256:sha256-file-hex (cdr (assoc "b" paths :test #'string=)))
                            "data-train-c.sexp" (asem-sha256:sha256-file-hex (cdr (assoc "c" paths :test #'string=)))
                            "data-train-d.sexp" (asem-sha256:sha256-file-hex (cdr (assoc "d" paths :test #'string=)))
                            "internal-dev-200.sexp" (asem-sha256:sha256-file-hex dev-path)
                            "pilot4.lisp" (asem-sha256:sha256-file-hex "lisp/experimental/pilot4/pilot4.lisp")
                            "protocol.md" (asem-sha256:sha256-file-hex (format nil "~a/protocol.md" +bundle+))
                            "eval-spec.md" (asem-sha256:sha256-file-hex (format nil "~a/eval-spec.md" +bundle+))
                            "sft.lisp" (asem-sha256:sha256-file-hex "lisp/src/sft.lisp")))))
            (write-json (format nil "~a/data-audit.json" +run+) audit)
            (format t "Pilot 4 prepared cleanly: A=6080, B=8640, C=13440, D=16000, internal_dev=200 (0 leaks).~%")))))))

(defun load-train-exs (path arm)
  (coerce
   (loop for (kind ids rows targets) in (read-sexp path) for i from 0
         collect (ecase kind
                   (:multi (asem-sft32:multi-ex (format nil "p4~a-~d" arm i) ids rows targets :normalization :token))
                   (:copy  (asem-sft32:make-ex :id (format nil "p4~a-g-~d" arm i)
                                               :category "copy" :subtype "guard" :qframe ""
                                               :mode :copy :answer 0 :target 0
                                               :ids (asem-sft32::ivec-of ids)
                                               :tgt (asem-sft32::ivec-of targets)
                                               :opts nil))))
   'vector))

(defun train (arm bpe)
  (let* ((spec (cdr (assoc arm +arm-specs+ :test #'string=)))
         (_ (unless spec (error "arm=a|b|c|d required, got ~s" arm)))
         (steps (getf spec :steps))
         (out (format nil "~a/arm-~a" +run+ arm))
         (audit (asem-json:parse-json (slurp (format nil "~a/data-audit.json" +run+))))
         (hashes (asem-json:json-get audit "sha256"))
         (data-path (format nil "~a/data-train-~a.sexp" +run+ arm))
         (dev-path (format nil "~a/internal-dev-200.sexp" +run+)))
    (declare (ignore _))
    (when (probe-file (format nil "~a/" out))
      (error "Refusing to overwrite existing run ~a" out))
    (unless (string= (asem-sha256:sha256-file-hex +init+) +reference+)
      (error "R7 init checkpoint hash mismatch"))
    (dolist (pair (list (cons (format nil "data-train-~a.sexp" arm) data-path)
                        (cons "internal-dev-200.sexp" dev-path)
                        (cons "pilot4.lisp" "lisp/experimental/pilot4/pilot4.lisp")
                        (cons "protocol.md" (format nil "~a/protocol.md" +bundle+))
                        (cons "eval-spec.md" (format nil "~a/eval-spec.md" +bundle+))))
      (unless (equal (asem-json:json-get hashes (car pair)) (asem-sha256:sha256-file-hex (cdr pair)))
        (error "Hash mismatch for ~a (re-run mode=prepare?)" (cdr pair))))
    (let* ((model (asem-pretrain32:load-checkpoint +init+))
           (train-exs (load-train-exs data-path arm))
           (dev-items (read-sexp dev-path))
           (dev-exs (asem-sft32:encode-items dev-items bpe +ctx+ :prompt-fn #'asem-qagen:item-prompt :mode :text))
           (letters (asem-sft32:letter-token-ids bpe)))
      (format t "Starting Pilot 4 Arm ~a: steps=~d train_n=~d dev_n=~d lr=5e-4 warmup=50~%"
              (string-upcase arm) steps (length train-exs) (length dev-exs))
      (asem-sft32:sft out train-exs dev-exs letters
        :init-model model :steps steps :batch +batch+ :accum 1 :workers 8
        :lr 5f-4 :min-lr-frac 0.1d0 :warmup 50 :clip 1d0 :wd 0d0 :seed +seed+
        :eval-every 50 :save-every 250 :log-every 10 :aux-lm 0
        :header (list :experiment "pilot4" :arm arm :steps steps :init_sha256 +reference+)))))

(defun main ()
  (let ((mode (opt "mode"))
        (arm (opt "arm"))
        (bpe (asem-bpe:load-bpe "data/fineweb/stage1/tokenizer.bpe")))
    (cond ((string= mode "prepare") (prepare bpe))
          ((string= mode "train")   (train arm bpe))
          (t (error "Usage: sbcl --script pilot4.lisp mode=prepare | mode=train arm=a|b|c|d")))))

(main)
