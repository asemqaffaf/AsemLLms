;;;; Entity-retrieval curriculum (src/retrieval.lisp): answers come from the passage, probes use unseen entities,
;;;; counterfactual questions change the answer, dense training targets are exactly the answer tokens.
(let ((here (directory-namestring *load-truename*)))
  (require :sb-posix)
  (dolist (f '("util" "sha256" "json" "bpe" "data" "qagen" "retrieval" "tf" "train" "pretrain" "sft"))
    (load (merge-pathnames (format nil "../src/~a.lisp" f) here)))
  (load (merge-pathnames "harness.lisp" here)))
(in-package :harness)

(defun words (s) (asem-util:split-on (asem-data::normalize s) #\Space))

(deftest probe-answers-come-from-the-passage
  (dolist (level asem-retrieval:+levels+)
    (dolist (ent '(:dev-real :new))
      (let ((items (asem-retrieval:probe-items level ent :seen 60 (+ level 10))))
        (check-equal (length items) 60)
        (check (every (lambda (it) (search (getf it :answer) (getf it :passage))) items) (format nil "L~d ~a: answer in passage" level ent))
        (when (> level 1)
          (check (every (lambda (it) (and (getf it :cf-answer) (string/= (getf it :cf-answer) (getf it :answer)))) items)
                 (format nil "L~d ~a: counterfactual answer differs" level ent)))))))

(deftest probe-entities-never-occur-in-training
  (let* ((b (asem-bpe:train-bpe (list "a b c") 300))
         (train-names (asem-qagen:synthetic-pool 'asem-qagen:*names*))
         (train-real (asem-qagen:split-pool asem-qagen:*names* :train))
         (new (asem-retrieval::new-pool :names)) (dev (asem-qagen:split-pool asem-qagen:*names* :dev))
         (test (asem-qagen:split-pool asem-qagen:*names* :test)))
    (declare (ignore b))
    (check (null (intersection new train-names :test #'string-equal)) "new names vs generated training names")
    (check (null (intersection new (append train-real dev test) :test #'string-equal)) "new names vs every real pool")
    (check (null (intersection dev train-names :test #'string-equal)) "dev names vs generated training names")
    ;; and no probe ever uses a QA test-pool entity
    (let ((test-words (make-hash-table :test 'equal)))
      (dolist (pool (list asem-qagen:*names* asem-qagen::*towns* asem-qagen::*jobs* asem-qagen::*pets* asem-qagen::*colors* asem-qagen::*instruments*))
        (dolist (x (asem-qagen:split-pool pool :test)) (setf (gethash (string-downcase x) test-words) t)))
      (dolist (ent '(:dev-real :new))
        (check (notany (lambda (it) (some (lambda (w) (gethash w test-words)) (words (getf it :passage))))
                       (asem-retrieval:probe-items 4 ent :unseen 100 3))
               (format nil "~a probes contain no QA test entity" ent))))))

(deftest training-targets-are-exactly-the-answers
  (let* ((b (asem-bpe:train-bpe (mapcar #'asem-qagen:item-prompt (asem-qagen:generate-split :train 60 11)) 1500))
         (seqs (asem-retrieval:train-sequences 50 '(1 2 3 4) 4 b 256)))
    (check (= 50 (length seqs)))
    (dolist (s seqs)
      (destructuring-bind (ids rows targets) s
        (check (every (lambda (r tk) (= (nth (1+ r) ids) tk)) rows targets) "target = the token after each row")
        (check (search "The answer is" (asem-bpe:bpe-decode b (subseq ids 0 (1+ (first rows))))) "first target follows \"The answer is\"")))))

(deftest multi-examples-train-and-score
  (let* ((b (asem-bpe:train-bpe (mapcar #'asem-qagen:item-prompt (asem-qagen:generate-split :train 60 11)) 1500))
         (seqs (asem-retrieval:train-sequences 8 '(1) 5 b 256))
         (exs (coerce (loop for (ids rows targets) in seqs for i from 0 collect (asem-sft:multi-ex (format nil "m~d" i) ids rows targets)) 'vector))
         (m (asem-tf:init-model (asem-tf:make-config :vocab (asem-bpe:bpe-vocab-size b) :ctx 256 :dim 32 :heads 2 :layers 2 :ff 64) 3))
         (dir (format nil "/tmp/asem-test-retrieval-~d" (sb-posix:getpid)))
         (st (asem-sft:sft dir exs exs '(1 2 3 4) :init-model m :steps 200 :batch 8 :workers 2 :lr 3d-3 :warmup 10 :eval-every 100
                           :log-every 0 :train-probe 8 :target-acc 0.99d0)))
    (check (>= (getf st :best-acc) 0.99l0) (format nil "8 memorised retrieval sequences, exact-match accuracy ~a" (getf st :best-acc)))
    (sb-ext:delete-directory dir :recursive t)))

(deftest augmentation-keeps-answers-and-entities-intact
  (let ((asem-retrieval:*augment* t) (rng (sb-ext:seed-random-state 3)))
    (dotimes (k 200)
      (multiple-value-bind (passage qa) (asem-retrieval:make-fact-set (1+ (mod k 4)) :train :seen rng)
        (dolist (x qa)
          (check (search (cdr x) passage) "answer still in the passage"))))
    ;; probes are never augmented
    (let ((asem-retrieval:*augment* nil))
      (check (equal (asem-retrieval:probe-items 2 :new :seen 20 5) (asem-retrieval:probe-items 2 :new :seen 20 5))))))

(deftest reverse-lookups-ask-for-the-person
  (let ((asem-retrieval:*reverse* t) (persons 0) (n 0))
    (dolist (it (asem-retrieval:probe-items 3 :dev-real :seen 200 21 :options t))
      (incf n)
      (check (member (getf it :answer) (getf it :options) :test #'string=) "answer among the options")
      (when (find (getf it :answer) (asem-qagen:split-pool asem-qagen:*names* :dev) :test #'string=)
        (incf persons)
        (when (equal (getf it :kind) "attr")
          (check (every (lambda (o) (find o (asem-qagen:split-pool asem-qagen:*names* :dev) :test #'string=)) (getf it :options))
                 "a reverse lookup offers people as options"))))
    (check (< (* 0.2 n) persons) (format nil "person answers ~d of ~d" persons n))))

(deftest comparison-and-temporal-answers-are-correct
  (let ((asem-retrieval:*reasoning* t) (cmp 0) (tmp 0))
    (dolist (it (asem-retrieval:probe-items 3 :dev-real :seen 300 31 :options t))
      (let ((p (getf it :passage)) (q (getf it :question)) (a (getf it :answer)))
        (check (member a (getf it :options) :test #'string=))
        (cond ((equal (getf it :kind) "cmp")
               (incf cmp)
               ;; the answer's number is the max (or min) of all numbers in the passage
               (let* ((nums (loop for w in (asem-util:split-on (substitute #\Space #\. p) #\Space) when (and (plusp (length w)) (every #'digit-char-p w)) collect (parse-integer w)))
                      (s (search a p)) (mine (loop for w in (asem-util:split-on (substitute #\Space #\. (subseq p s (position #\. p :start s))) #\Space)
                                                   when (and (plusp (length w)) (every #'digit-char-p w)) return (parse-integer w)))
                      (maxq (some (lambda (k) (search k q)) '("oldest" "highest" "most" "biggest" "tallest" "greatest"))))
                 (check (and mine (= mine (if maxq (reduce #'max nums) (reduce #'min nums)))) (format nil "comparison: ~a / ~a -> ~a" p q a))))
              ((equal (getf it :kind) "tmp") (incf tmp) (check (search a p))))))
    (check (and (> cmp 20) (> tmp 20)) (format nil "kinds present: cmp ~d tmp ~d" cmp tmp))))

(defun test-ngrams (k xs)
  (loop for i from 0 to (max -1 (- (length xs) k)) collect (subseq xs i (+ i k))))

(deftest predicate-paraphrase-frames-avoid-dev-overlap-and-duplicates
  (let* ((frames (asem-retrieval:all-predicate-paraphrase-frames))
         (devs (asem-qagen:all-frames :dev))
         (dev4 (mapcan (lambda (f) (test-ngrams 4 (words f))) devs))
         (seen (make-hash-table :test 'equalp)))
    (check (> (length frames) 100) "non-empty paraphrase pool")
    (dolist (f frames)
      (let ((filled (reduce (lambda (acc kv) (asem-qagen::replace-all acc (car kv) (cdr kv)))
                            '(("{A}" . "Alex") ("{B}" . "Blake") ("{P}" . "Pat") ("{N}" . "42") ("{V}" . "42") ("{X}" . "bakery"))
                            :initial-value f)))
        (check (and (not (find #\{ filled)) (not (find #\} filled))) (format nil "all slots filled: ~s" f)))
      (let ((norm (string-trim '(#\Space) (string-downcase f))))
        (check (not (gethash norm seen)) (format nil "no duplicate paraphrase frame: ~s" f))
        (setf (gethash norm seen) t))
      (check (not (member f devs :test #'string-equal)) (format nil "no exact dev match: ~s" f))
      (dolist (g (test-ngrams 4 (words f)))
        (check (not (member g dev4 :test #'equal)) (format nil "no dev 4-gram overlap ~s in ~s" g f))))))

(deftest predicate-paraphrase-preserves-attr-num-reverse-and-probes
  (let* ((b (asem-bpe:train-bpe (append (mapcar #'asem-qagen:item-prompt (asem-qagen:generate-split :train 60 11))
                                        (asem-retrieval:all-predicate-paraphrase-frames)
                                        (list "Text: Q: The answer is . A) B) C) D)"))
                                1500))
         (ctrl-seq (let ((asem-retrieval:*augment* t) (asem-retrieval:*reverse* t) (asem-retrieval:*reasoning* t) (asem-retrieval:*predicate-paraphrase* nil))
                     (asem-retrieval:train-sequences 20 '(1 2 3) 17 b 256 :options t)))
         (again-seq (let ((asem-retrieval:*augment* t) (asem-retrieval:*reverse* t) (asem-retrieval:*reasoning* t) (asem-retrieval:*predicate-paraphrase* nil))
                      (asem-retrieval:train-sequences 20 '(1 2 3) 17 b 256 :options t)))
         (orig-mfs (symbol-function 'asem-retrieval:make-fact-set))
         (c-kinds nil) (t-kinds nil))
    (check-equal ctrl-seq again-seq)
    (let* ((collect-seqs
             (lambda (para)
               (let ((ks nil) (out nil))
                 (setf (symbol-function 'asem-retrieval:make-fact-set)
                       (lambda (&rest args)
                         (multiple-value-bind (p qa k c pd) (apply orig-mfs args)
                           (push k ks)
                           (values p qa k c pd))))
                 (unwind-protect
                      (setf out (let ((asem-retrieval:*augment* t) (asem-retrieval:*reverse* t)
                                      (asem-retrieval:*reasoning* t) (asem-retrieval:*predicate-paraphrase* para))
                                  (asem-retrieval:train-sequences 120 '(1 2 3) 17 b 128 :options t)))
                   (setf (symbol-function 'asem-retrieval:make-fact-set) orig-mfs))
                 (values out (nreverse ks)))))
           (c-seqs (multiple-value-bind (s k) (funcall collect-seqs nil) (setf c-kinds k) s))
           (t-seqs (multiple-value-bind (s k) (funcall collect-seqs t) (setf t-kinds k) s)))
      (check-equal c-kinds t-kinds)
      (loop for cs in c-seqs for ts in t-seqs for k in c-kinds
            when (member k '(:attr :num))
              do (check (equal cs ts) (format nil "ctrl-aligned train-sequences ~a byte-identical" k))))
    (dotimes (k 200)
      (let ((lv (1+ (mod k 3))))
        (multiple-value-bind (p0 qa0 k0)
            (let ((asem-retrieval:*augment* t) (asem-retrieval:*reverse* t) (asem-retrieval:*reasoning* t) (asem-retrieval:*predicate-paraphrase* nil))
              (asem-retrieval:make-fact-set lv :train :seen (sb-ext:seed-random-state (+ 100 k))))
          (multiple-value-bind (p1 qa1 k1)
              (let ((asem-retrieval:*augment* t) (asem-retrieval:*reverse* t) (asem-retrieval:*reasoning* t) (asem-retrieval:*predicate-paraphrase* t)
                    (asem-retrieval:*paraphrase-rng* (sb-ext:seed-random-state (+ 5000 k))))
                (asem-retrieval:make-fact-set lv :train :seen (sb-ext:seed-random-state (+ 100 k))))
            (check (eq k0 k1) "kind allocation matches Control")
            (check (equal (mapcar #'cdr qa0) (mapcar #'cdr qa1)) "answer sequence matches Control")
            (when (member k0 '(:attr :num))
              (check (equal p0 p1) "attr/num passage untouched")
              (check (equal qa0 qa1) "attr/num/reverse QA untouched")))))))
  (let ((p-off (let ((asem-retrieval:*reasoning* t) (asem-retrieval:*reverse* t) (asem-retrieval:*predicate-paraphrase* nil))
                 (asem-retrieval:probe-items 3 :new :seen 30 91 :options t)))
        (p-on (let ((asem-retrieval:*reasoning* t) (asem-retrieval:*reverse* t) (asem-retrieval:*predicate-paraphrase* t))
                (asem-retrieval:probe-items 3 :new :seen 30 91 :options t))))
    (check-equal p-off p-on)))

(deftest predicate-paraphrase-semantics-and-targets-hold
  (let ((seen-cmp 0) (seen-tmp 0) (seen-rel 0))
    (let ((asem-retrieval:*augment* nil) (asem-retrieval:*reverse* t) (asem-retrieval:*reasoning* t)
          (asem-retrieval:*predicate-paraphrase* t) (asem-retrieval:*paraphrase-rng* (sb-ext:seed-random-state 77))
          (rng (sb-ext:seed-random-state 78)))
      (dotimes (k 300)
        (multiple-value-bind (passage qa kind) (asem-retrieval:make-fact-set (1+ (mod k 3)) :train :seen rng)
          (check (and (not (find #\{ passage)) (not (find #\} passage))) "no unexpanded brace in passage")
          (dolist (x qa)
            (check (and (not (find #\{ (car x))) (not (find #\} (car x)))) "no unexpanded brace in question")
            (check (search (cdr x) passage) (format nil "answer ~s in passage ~s" (cdr x) passage)))
          (ecase kind
            ((:attr :num) nil)
            (:rel (incf seen-rel))
            (:cmp
             (incf seen-cmp)
             (let* ((sents (asem-util:split-on passage #\.))
                    (pairs (loop for s in sents
                                 for ws = (asem-util:split-on (substitute #\Space #\, (string-trim '(#\Space) s)) #\Space)
                                 for n = (loop for w in ws when (and (plusp (length w)) (every #'digit-char-p w)) return (parse-integer w))
                                 when n collect (cons s n)))
                    (hi (reduce #'max (mapcar #'cdr pairs)))
                    (lo (reduce #'min (mapcar #'cdr pairs))))
               (dolist (x qa)
                 (let* ((ql (string-downcase (car x)))
                        (maxp (some (lambda (kw) (search kw ql)) '("most" "oldest" "tops" "top" "tallest" "maximum" "highest" "biggest" "greatest")))
                        (minp (some (lambda (kw) (search kw ql)) '("fewest" "youngest" "trails" "bottom" "shortest" "minimum" "lowest" "smallest" "least")))
                        (ans-entry (find-if (lambda (pr) (search (cdr x) (car pr))) pairs)))
                   (check (not (and maxp minp)) (format nil "unambiguous cmp polarity: ~s" (car x)))
                   (check (or maxp minp) (format nil "recognized cmp polarity: ~s" (car x)))
                   (check ans-entry "answer person has number in passage")
                   (check (= (cdr ans-entry) (if maxp hi lo)) (format nil "cmp semantic answer: ~s -> ~s" (car x) (cdr x)))))))
            (:tmp
             (incf seen-tmp)
             (let* ((sents (remove-if (lambda (s) (zerop (length (string-trim '(#\Space) s)))) (asem-util:split-on passage #\.)))
                    (place-of (lambda (s)
                                (let ((pos (search " the " s :from-end t)))
                                  (and pos (string-trim '(#\Space) (subseq s (+ pos 5)))))))
                    (stops (mapcar place-of sents)))
               (dolist (x qa)
                 (let* ((ql (string-downcase (car x))) (ans (cdr x)) (idx (position ans stops :test #'string=)))
                   (check idx (format nil "temporal answer ~s in stops ~s" ans stops))
                   (cond ((or (search "first" ql) (search "begin" ql) (search "start" ql) (search "kick off" ql))
                          (check (= idx 0) (format nil "first stop: ~s" (car x))))
                         ((or (search "last" ql) (search "end" ql) (search "wrap up" ql) (search "final" ql))
                          (check (= idx (1- (length stops))) (format nil "last stop: ~s" (car x))))
                         ((or (search "after" ql) (search "following" ql))
                          (check (and (> idx 0) (search (nth (1- idx) stops) (car x))) (format nil "after stop: ~s -> ~s" (car x) ans)))
                         ((or (search "before" ql) (search "ahead" ql))
                          (check (and (< idx (1- (length stops))) (search (nth (1+ idx) stops) (car x))) (format nil "before stop: ~s -> ~s" (car x) ans)))
                         (t (check nil (format nil "unrecognized temporal question ~s" (car x)))))))))))))
    (check (and (> seen-cmp 30) (> seen-tmp 30) (> seen-rel 30)) "paraphrased kinds covered"))
  (let* ((b (asem-bpe:train-bpe (append (mapcar #'asem-qagen:item-prompt (asem-qagen:generate-split :train 60 11))
                                        (asem-retrieval:all-predicate-paraphrase-frames)
                                        (list "Text: Q: The answer is . A) B) C) D)"))
                                1500))
         (seqs (let ((asem-retrieval:*augment* t) (asem-retrieval:*reverse* t) (asem-retrieval:*reasoning* t)
                     (asem-retrieval:*predicate-paraphrase* t))
                 (asem-retrieval:train-sequences 60 '(1 2 3) 44 b 128 :options t))))
    (check (= 60 (length seqs)))
    (dolist (s seqs)
      (destructuring-bind (ids rows targets) s
        (check (<= (length ids) 128) "fits within ctx 128")
        (check (every (lambda (r tk) (= (nth (1+ r) ids) tk)) rows targets) "target tokens aligned")
        (let ((txt (asem-bpe:bpe-decode b ids)))
          (check (and (not (find #\{ txt)) (not (find #\} txt))) "no unexpanded braces in decoded train seq"))))))

(run-all)
