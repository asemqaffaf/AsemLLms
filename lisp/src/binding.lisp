;;;; Evaluation-only counterfactual fact assignment. No training or locked-QA reader.
(defpackage :asem-binding
  (:use :cl)
  (:shadow #:fill)
  (:export #:families #:generate-pairs #:validate-pair #:fixture-json #:family-json
           #:parse-world #:solve-world #:flatten-worlds #:joint-hit-p))
(in-package :asem-binding)
(define-condition ineligible (error)
  ((reason :initarg :reason :reader ineligible-reason))
  (:report (lambda (c s) (write-string (ineligible-reason c) s))))

;; Frozen before inference. Slots A/B always denote agent/patient, including passive frames.
;; These families are NOT added to qagen or any training inventory.
(defparameter *relations*
  '((:teach "{A} provided {B} with lessons." "Which individual provided lessons for {B}?" "Who received lessons from {A}?")
    (:teach "The person teaching {B} was {A}." "Whose pupil was {B}?" "Who was the pupil of {A}?")
    (:teach "{B} received instruction from {A}." "From which person did {B} receive instruction?" "To which person did {A} give instruction?")
    (:teach "Lessons for {B} were given by {A}." "Identify the person giving {B} lessons." "Identify the person to whom {A} gave lessons.")
    (:hire "{A} signed {B} on as an employee." "Who signed {B} on as an employee?" "Which individual did {A} sign on as an employee?")
    (:hire "The person who hired {B} was {A}." "Identify the individual responsible for hiring {B}." "Identify the individual whom {A} hired.")
    (:hire "{B} was taken on as an employee by {A}." "By which individual was {B} taken on as an employee?" "Which employee was taken on by {A}?")
    (:hire "{A} took {B} on as a new worker." "Who took {B} on as a new worker?" "Which new worker did {A} take on?")
    (:call "{A} placed a phone call to {B}." "Who placed the phone call to {B}?" "To whom did {A} place a phone call?")
    (:call "{B} received a telephone call placed by {A}." "Who placed the telephone call that {B} received?" "Who received the telephone call placed by {A}?")
    (:call "The person telephoning {B} was {A}." "Identify the individual who telephoned {B}." "Identify the individual whom {A} telephoned.")
    (:thank "{A} conveyed thanks to {B}." "Who conveyed thanks to {B}?" "To whom did {A} convey thanks?")
    (:thank "It was {B} whom {A} thanked." "Identify the individual thanking {B}." "Identify the individual receiving thanks from {A}.")
    (:thank "{B} was the person receiving {A}'s thanks." "Whose thanks did {B} receive?" "Who was the recipient of {A}'s thanks?")
    (:visit "{A} made a visit to {B}." "Who made the visit to {B}?" "To whom did {A} make a visit?")
    (:visit "{B} received a visit made by {A}." "Whose visit did {B} receive?" "Who received the visit made by {A}?")
    (:visit "The visitor who went to see {B} was {A}." "Identify the visitor who went to see {B}." "Identify the individual visited by {A}.")
    (:help "{A} provided assistance to {B}." "Who provided assistance to {B}?" "To whom did {A} provide assistance?")
    (:help "Assistance for {B} came from {A}." "From which individual did assistance for {B} come?" "For whom did assistance come from {A}?")
    (:help "It was {B} whom {A} assisted." "Identify the individual assisting {B}." "Identify the individual whom {A} assisted.")))

(defparameter *attributes*
  '(("The town where {P} resides is {V}." "Name the town in which {P} resides." "Identify the person whose town of residence is {V}.")
    ("{V} is where {P} makes a home." "What town serves as {P}'s place of residence?" "Which individual makes a home in {V}?")
    ("{P} has a home in {V}." "Which town does {P} make a home in?" "Name the individual who has a home in {V}.")
    ("{P} is a resident of {V}." "Give the home town associated with {P}." "Which individual is a resident of {V}?")
    ("{V} is the town of residence for {P}." "Identify the town that is home to {P}." "For which individual is {V} the town of residence?")))

(defparameter *comparisons*
  '(("{P} finished with {N} points." "Whose point total exceeds everyone else's?" "Whose point total is below everyone else's?")
    ("The point total for {P} was {N}." "Which individual accumulated more points than all the others?" "Which individual accumulated fewer points than all the others?")
    ("{N} points were recorded for {P}." "Identify the individual with the greatest point total." "Identify the individual with the smallest point total.")
    ("{P}'s final point tally was {N}." "Whose final point tally ranks above the others?" "Whose final point tally ranks below the others?")
    ("{P} ended with a total of {N} points." "Who ended with more points than anyone else?" "Who ended with fewer points than anyone else?")))

(defparameter *temporals*
  '(("At the outset, {P} visited the {X}." "The next visit by {P} was to the {X}." "{P}'s final visit was to the {X}."
     "Which location was {P}'s opening visit?" "Which location was {P}'s concluding visit?" "What was {P}'s next stop after leaving the {X}?" "What was {P}'s previous stop before reaching the {X}?")
    ("{P}'s route began with the {X}." "{P}'s route continued to the {X}." "{P}'s route concluded with the {X}."
     "Which location began {P}'s route?" "Which location concluded {P}'s route?" "Which location immediately succeeded the {X} on {P}'s route?" "Which location immediately preceded the {X} on {P}'s route?")
    ("The opening stop for {P} was the {X}." "The subsequent stop for {P} was the {X}." "The concluding stop for {P} was the {X}."
     "Name the opening stop made by {P}." "Name the concluding stop made by {P}." "Name the stop {P} made immediately after the {X}." "Name the stop {P} made immediately before the {X}.")
    ("To open the trip, {P} visited the {X}." "Continuing the trip, {P} visited the {X}." "To close the trip, {P} visited the {X}."
     "Where did {P} open the trip?" "Where did {P} close the trip?" "Where did {P} stop directly after departing the {X}?" "Where did {P} stop directly before arriving at the {X}?")
    ("{P} started the outing with the {X}." "{P} continued the outing with the {X}." "{P} finished the outing with the {X}."
     "What was the starting location of {P}'s outing?" "What was the finishing location of {P}'s outing?" "Which stop followed the {X} without an intervening stop for {P}?" "Which stop preceded the {X} without an intervening stop for {P}?")))

(defun families ()
  (append
    (loop for (pred p qs qo) in *relations* for i from 0
          collect (list :id (format nil "relation-~2,'0d" i) :category "relation" :predicate pred
                        :passage (list p) :questions (list (cons :rel-subj qs) (cons :rel-obj qo))))
    (loop for cat in '("extract" "reverse") append
      (loop for (p qe qr) in *attributes* for i from 0
            collect (list :id (format nil "~a-~d" cat i) :category cat :predicate :town :passage (list p)
                          :questions (list (cons (if (equal cat "extract") :extract :reverse) (if (equal cat "extract") qe qr))))))
    (loop for (p hi lo) in *comparisons* for i from 0
          collect (list :id (format nil "compare-~d" i) :category "compare" :predicate :score :passage (list p)
                        :questions (list (cons :max hi) (cons :min lo))))
    (loop for (p0 pm p3 q0 q3 qa qb) in *temporals* for i from 0
          collect (list :id (format nil "temporal-~d" i) :category "temporal" :predicate :temporal
                        :passage (list p0 pm pm p3) :questions (list (cons :first q0) (cons :last q3) (cons :after qa) (cons :before qb))))))

(defun fill (frame &rest args)
  (apply #'asem-qagen::fill-frame frame (loop for (k v) on args by #'cddr when v append (list k v))))
(defun pick (xs rng) (nth (random (length xs) rng) xs))
(defun sample (xs n rng) (asem-qagen::sample-n xs n rng))
(defun swapped (xs i j) (let ((out (copy-list xs))) (rotatef (nth i out) (nth j out)) out))
(defun token-bucket (xs bpe)
  "Use a common token length selected without model predictions; log this eligibility restriction."
  (let ((h (make-hash-table)) (best nil))
    (dolist (s xs) (push s (gethash (length (asem-bpe:bpe-encode bpe (format nil " ~a" s))) h)))
    (maphash (lambda (k v) (declare (ignore k)) (when (> (length v) (length best)) (setf best v))) h)
    (unless (>= (length best) 4) (error "Need four distinct strings of one token length"))
    (sort best #'string<)))

(defun frame-question (family query person)
  (let ((arg (second query)))
    (fill (or (cdr (assoc (first query) (getf family :questions))) (error "Unknown query"))
          :a arg :b arg :p (or person arg) :v arg :x arg)))

(defun relation-world (family people edges query)
  (let* ((sentences (mapcar (lambda (ab) (fill (first (getf family :passage)) :a (first ab) :b (second ab))) edges))
         (facts (list :people people :pairs edges)))
    (list :category "relation" :subtype (format nil "~(~a~)-chain-~a" (getf family :predicate) (if (eq (first query) :rel-subj) "subj" "obj"))
          :sentences sentences :passage (format nil "~{~a~^ ~}" sentences) :question (frame-question family query nil)
          :query query :facts facts :people people :values nil)))

(defun assignment-world (family people vals query)
  (let* ((cat (getf family :category)) (numeric (equal cat "compare"))
         (sentences (loop for p in people for v in vals collect (fill (first (getf family :passage)) :p p :v v :n v)))
         (facts (list :people people (if numeric :numbers :values) vals)))
    (list :category cat :subtype (if numeric (string-downcase (symbol-name (first query))) "town")
          :sentences sentences :passage (format nil "~{~a~^ ~}" sentences) :question (frame-question family query nil)
          :query query :facts facts :people people :values vals)))

(defun temporal-world (family person places query)
  (let* ((sentences (loop for frame in (getf family :passage) for x in places collect (fill frame :p person :x x)))
         (facts (list :person person :order places)))
    (list :category "temporal" :subtype (string-downcase (symbol-name (first query)))
          :sentences sentences :passage (format nil "~{~a~^ ~}" sentences) :question (frame-question family query person)
          :query query :facts facts :people (list person) :values places)))

(defun parse-world (family world)
  "Reconstruct facts and query from rendered strings by exhaustive finite grammar matching.
This does not use the stored query, facts or key to select a match. Ambiguity is an error."
  (let* ((cat (getf world :category)) (people (getf world :people)) (vals (getf world :values))
         (sentences (asem-qagen::sentences-of (getf world :passage))) (records nil))
    (unless (equal sentences (getf world :sentences)) (error "Passage/sentence mismatch"))
    (loop for sentence in sentences for i from 0
          for frame = (nth (if (equal cat "temporal") i 0) (getf family :passage))
          do (let ((hits nil))
               (cond ((equal cat "relation")
                      (dolist (a people) (dolist (b people)
                        (when (and (not (equal a b)) (string= sentence (fill frame :a a :b b))) (push (list a b) hits)))))
                     ((equal cat "temporal")
                      (dolist (x vals) (when (string= sentence (fill frame :p (first people) :x x)) (push x hits))))
                     (t (dolist (p people) (dolist (v vals)
                          (when (string= sentence (fill frame :p p :v v :n v)) (push (list p v) hits))))))
               (unless (= 1 (length hits)) (error "Sentence must have one parse: ~s" sentence))
               (push (first hits) records)))
    (setf records (nreverse records))
    (let* ((facts (cond ((equal cat "relation") (list :people people :pairs records))
                        ((equal cat "temporal") (list :person (first people) :order records))
                        (t (list :people (mapcar #'first records) (if (equal cat "compare") :numbers :values) (mapcar #'second records)))))
           (qs nil))
      (dolist (qf (getf family :questions))
        (dolist (arg (case (car qf) ((:rel-subj :rel-obj :extract) people) ((:reverse :after :before) vals) (otherwise (list nil))))
          (let ((query (if arg (list (car qf) arg) (list (car qf)))))
            (when (string= (getf world :question) (frame-question family query (and (equal cat "temporal") (first people))))
              (push query qs)))))
      (unless (= 1 (length qs)) (error "Question must have one parse: ~s" (getf world :question)))
      (values facts (first qs)))))

(defun solve-world (family world)
  (multiple-value-bind (facts query) (parse-world family world)
    (values (asem-qagen::solve (getf world :category) facts query) facts query)))

(defun word-bag (s)
  (let ((words nil) (start nil))
    (loop for i from 0 to (length s) for c = (and (< i (length s)) (char s i))
          do (if (and c (alphanumericp c)) (unless start (setf start i))
                 (when start (push (string-downcase (subseq s start i)) words) (setf start nil))))
    (sort words #'string<)))

(defun validate-pair (pair bpe &optional (ctx 128))
  (let* ((family (or (find (getf pair :family) (families) :key (lambda (f) (getf f :id)) :test #'equal) (error "Unknown family")))
         (worlds (getf pair :worlds)) (a (first worlds)) (b (second worlds)))
    (unless (= 2 (length worlds)) (error "Exactly two worlds required"))
    (dolist (k '(:category :question :options)) (unless (equal (getf a k) (getf b k)) (error "Changed ~s" k)))
    (unless (equal (getf a :category) (getf family :category)) (error "Family/category mismatch"))
    (unless (and (= 4 (length (getf a :options))) (= 4 (length (remove-duplicates (getf a :options) :test #'equal)))) (error "Four distinct options required"))
    (unless (and (not (equal (getf a :passage) (getf b :passage)))
                 (equal (word-bag (getf a :passage)) (word-bag (getf b :passage)))) (error "Passages must reassign the same words"))
    (dolist (w worlds)
      (unless (equal (getf w :split) "dev") (error "Development only"))
      (multiple-value-bind (answer facts query) (solve-world family w)
        (unless (and answer (equal facts (getf w :facts)) (equal query (getf w :query))
                     (equal answer (nth (getf w :answer) (getf w :options)))) (error "Independent semantic/key validation failed"))))
    (when (= (getf a :answer) (getf b :answer)) (error "Counterfactual must change answer"))
    (let ((exs (handler-case (asem-sft32:encode-items worlds bpe ctx :mode :text)
                 (error (e) (error 'ineligible :reason (princ-to-string e))))))
      (unless (= (length (asem-sft32:ex-ids (aref exs 0))) (length (asem-sft32:ex-ids (aref exs 1)))) (error 'ineligible :reason "Prompt lengths differ"))
      (unless (= (length (asem-sft32::ex-tgt (aref exs 0))) (length (asem-sft32::ex-tgt (aref exs 1)))) (error 'ineligible :reason "Answer lengths differ")))
    t))

(defun candidate-pair (family j ordinal rng names towns places)
  (let* ((cat (getf family :category)) (people (sample names 4 rng)) (worlds nil) (opts nil)
         (role (if (evenp j) :rel-subj :rel-obj)))
    (cond ((equal cat "relation")
           (let* ((edges (asem-qagen::shuffle (loop for a in people for b in (rest people) collect (list a b)) rng))
                  (query (list role (nth (1+ (mod (floor j 2) 2)) people))))
             (setf worlds (list (relation-world family people edges query) (relation-world family people (mapcar #'reverse edges) query)) opts people)))
          ((equal cat "temporal")
           (let* ((vals (sample places 4 rng)) (person (first people)) (q (nth (mod (+ j (parse-integer (getf family :id) :start 9)) 4) '(:first :last :after :before)))
                  (anchor (case q (:after 1) (:before 2)))
                  (target (case q (:first 0) (:last 3) (:after 2) (:before 1)))
                  (other (pick (remove-if (lambda (i) (or (= i target) (eql i anchor))) '(0 1 2 3)) rng))
                  (query (if anchor (list q (nth anchor vals)) (list q))))
             (setf worlds (list (temporal-world family person vals query) (temporal-world family person (swapped vals target other) query)) opts vals)))
          (t (let* ((numeric (equal cat "compare"))
                    (vals (if numeric (sample (loop for n from 10 to 99 collect n) 4 rng) (sample towns 4 rng)))
                    (target (if numeric (position (reduce (if (evenp j) #'max #'min) vals) vals) (random 4 rng)))
                    (other (pick (remove target '(0 1 2 3)) rng))
                    (query (cond (numeric (list (if (evenp j) :max :min)))
                                 ((equal cat "extract") (list :extract (nth target people)))
                                 (t (list :reverse (nth target vals))))))
               (setf worlds (list (assignment-world family people vals query) (assignment-world family people (swapped vals target other) query))
                     opts (if (equal cat "extract") vals people)))))
    ;; World designation independent of query direction; exact 5/5 within each ten-graph family.
    (when (< (mod (+ j (floor ordinal 10)) 10) 5) (setf worlds (reverse worlds)))
    (let* ((answers (mapcar (lambda (w) (asem-qagen::solve cat (getf w :facts) (getf w :query))) worlds))
           (k0 (mod ordinal 4)) (k1 (mod (+ k0 1 (mod (floor ordinal 4) 3)) 4))
           (options (make-list 4)) (others (asem-qagen::shuffle (set-difference opts answers :test #'equal) rng))
           (id (format nil "binding-~a-~2,'0d" (getf family :id) j)))
      (unless (and (every #'identity answers) (not (equal (first answers) (second answers)))) (error "Bad generated answers"))
      (setf (nth k0 options) (first answers) (nth k1 options) (second answers))
      (dotimes (i 4) (unless (nth i options) (setf (nth i options) (pop others))))
      (setf worlds (loop for w in worlds for i from 0
                         collect (list* :id (format nil "~a/w~d" id i) :split "dev"
                                        :options options :answer (if (zerop i) k0 k1) w)))
      (list :id id :family (getf family :id) :category cat :worlds worlds))))

(defun audit-families ()
  (let ((known (append (asem-qagen:all-frames :train) (asem-qagen:all-frames :dev) (asem-phase2-frames:all-predicate-paraphrase-frames))))
    (dolist (f (families))
      (dolist (frame (append (getf f :passage) (mapcar #'cdr (getf f :questions))))
        (when (member frame known :test #'string-equal) (error "Existing training/public-dev frame: ~s" frame))))
    t))

(defun generate-pairs (bpe &key (seed 1101101) (per-family 10))
  (audit-families)
  (let* ((rng (sb-ext:seed-random-state seed))
         (names (token-bucket (asem-retrieval::new-pool :names) bpe))
         (towns (token-bucket (asem-retrieval::new-pool :towns) bpe))
         (places (token-bucket
                   (set-difference '("harbor" "stadium" "gallery" "courthouse" "aquarium" "orchard" "lighthouse" "workshop"
                                     "observatory" "playground" "warehouse" "chapel" "quarry" "marina" "monastery" "greenhouse"
                                     "planetarium" "dockyard" "vineyard" "arboretum")
                                   (append (asem-qagen:split-pool asem-qagen::*places* :train)
                                           (asem-qagen:split-pool asem-qagen::*places* :dev)) :test #'equal) bpe))
         (out nil) (rejections nil) (ordinal 0) (seen (make-hash-table :test 'equal)))
    (dolist (family (families))
      (dotimes (j per-family)
        (loop for attempt from 1 to 2000
              do (let ((pair (candidate-pair family j ordinal rng names towns places)))
                   (let ((problem (handler-case (progn (validate-pair pair bpe) nil) (ineligible (e) (ineligible-reason e)))))
                     (cond (problem (push (list :family (getf family :id) :reason problem) rejections))
                           (t (let ((fingerprint (mapcar (lambda (w) (list (getf w :passage) (getf w :question))) (getf pair :worlds))))
                                (when (gethash fingerprint seen) (error "Duplicate pair"))
                                (setf (gethash fingerprint seen) t))
                              (push pair out) (incf ordinal) (return)))))
              finally (error "Could not generate eligible ~a/~d: ~a" (getf family :id) j (getf (first rejections) :reason)))))
    (values (nreverse out) (nreverse rejections)
            (list :names (length names) :towns (length towns) :places (length places)))))

(defun flatten-worlds (pairs) (loop for pair in pairs append (getf pair :worlds)))
(defun joint-hit-p (predictions keys) (and (= 2 (length predictions) (length keys)) (every #'eql predictions keys)))
(defun obj (&rest xs) (apply #'asem-qa-analysis::obj xs))
(defun arr (xs) (coerce xs 'vector))
(defun data-string (x) (with-standard-io-syntax (let ((*print-readably* t)) (write-to-string x))))
(defun family-json (f)
  (obj "id" (getf f :id) "category" (getf f :category) "predicate" (string-downcase (symbol-name (getf f :predicate)))
       "passage_frames" (arr (getf f :passage)) "question_frames" (cons :obj (loop for (k . v) in (getf f :questions) collect (cons (string-downcase (symbol-name k)) v)))))
(defun world-json (w bpe)
  (obj "id" (getf w :id) "category" (getf w :category) "subtype" (getf w :subtype)
       "people" (arr (getf w :people)) "values" (arr (getf w :values)) "sentences" (arr (getf w :sentences))
       "passage" (getf w :passage) "question" (getf w :question) "options" (arr (getf w :options)) "key" (getf w :answer)
       "facts" (data-string (getf w :facts)) "query" (data-string (getf w :query))
       "prompt_token_ids" (arr (cons 0 (asem-bpe:bpe-encode bpe (asem-qagen:item-prompt w))))
       "option_token_ids" (arr (mapcar (lambda (o) (arr (asem-bpe:bpe-encode bpe (format nil " ~a" o)))) (getf w :options)))))
(defun fixture-json (pairs bpe)
  (arr (loop for p in pairs collect (obj "id" (getf p :id) "family" (getf p :family) "category" (getf p :category)
                                        "worlds" (arr (mapcar (lambda (w) (world-json w bpe)) (getf p :worlds)))))))
