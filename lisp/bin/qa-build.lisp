;;; Build the Stage 2 QA data: locked test set, development set and training set, plus an audit (manifest.json).
;;;   sbcl --dynamic-space-size 4GB --script lisp/bin/qa-build.lisp data=data/fineweb/stage1 out=data/qa/v1
;;;        [train=16000] [dev=500] [test=1000] [ctx=128] [seed-train=1001] [seed-dev=2002] [seed-test=3003]
;;; Order: the test set is generated first, then dev, then train, sharing one exclusion table (no exact duplicate prompt across
;;; splits). Then: every prompt is tokenized with the Stage 1 tokenizer and must fit the context window with the end-of-text token
;;; in front (nothing is ever truncated); each answer letter must encode to exactly one fixed token when appended to its prompt;
;;; near-duplicates (word 5-gram MinHash, as in the corpus pipeline) between training and dev/test passages are removed from the
;;; training set; wording overlap between splits is measured; simple shortcut heuristics are scored on dev and test.
;;; Writes OUT/{train,dev,test}.jsonl and OUT/manifest.json (SHA-256 of each file, counts, positions, lengths, audits).
(let ((here (directory-namestring *load-truename*)))
  (dolist (f '("util" "sha256" "json" "bpe" "data" "qagen")) (load (merge-pathnames (format nil "../src/~a.lisp" f) here))))
(defpackage :qa-build (:use :cl :asem-qagen))
(in-package :qa-build)

(defun opt-arg (name default)
  (let ((p (find-if (lambda (a) (and (> (length a) (length name)) (string= name a :end2 (length name)) (char= (char a (length name)) #\=)))
                    (cdr sb-ext:*posix-argv*))))
    (if p (subseq p (1+ (length name))) default)))
(defun num (name default) (parse-integer (opt-arg name default)))
(defun jobj (&rest plist) (cons :obj (loop for (k v) on plist by #'cddr collect (cons k v))))

(defparameter *stop* '("the" "and" "who" "what" "which" "did" "does" "was" "whom" "whose" "where" "how" "for" "with" "from" "this" "that" "are" "has" "had" "have" "one"))
(defun content-words (s)
  (remove-if (lambda (w) (or (< (length w) 3) (member w *stop* :test #'string=)))
             (asem-util:split-on (asem-data::normalize s) #\Space)))

(defun heuristic-picks (it)
  "Option index chosen by each shortcut rule."
  (let* ((opts (item-get it :options)) (p (string-downcase (item-get it :passage)))
         (first-pos (mapcar (lambda (o) (or (search (string-downcase o) p) 100000)) opts))
         (last-pos (mapcar (lambda (o) (or (search (string-downcase o) p :from-end t) -1)) opts))
         (lens (mapcar #'length opts))
         (qw (content-words (item-get it :question)))
         (ss (asem-qagen::sentences-of (item-get it :passage)))
         (overlap (mapcar (lambda (o) (loop for s in ss when (plusp (asem-qagen::word-boundary-count o s))
                                              maximize (count-if (lambda (w) (find w (content-words s) :test #'string=)) (remove-if (lambda (w) (find w (content-words o) :test #'string=)) qw))))
                          opts)))
    (flet ((argbest (xs fn) (position (reduce fn xs) xs)))
      (list (cons "first_mentioned_option" (argbest first-pos #'min)) (cons "last_mentioned_option" (argbest last-pos #'max))
            (cons "longest_option" (argbest lens #'max)) (cons "shortest_option" (argbest lens #'min))
            (cons "always_A" 0) (cons "always_D" 3)
            (cons "option_in_sentence_sharing_most_question_words" (argbest overlap #'max))))))

(defun baselines (items)
  (let ((tally (make-hash-table :test 'equal)))
    (dolist (it items)
      (loop for (k . pick) in (heuristic-picks it) do (when (= pick (item-get it :answer)) (incf (gethash k tally 0)))))
    (cons :obj (loop for k being the hash-keys of tally using (hash-value v) collect (cons k (/ v (length items) 1d0))))))

(defun duplicate-p-readonly (d text)
  "Like asem-data:duplicate-p but never remembers TEXT (training items are checked against dev+test only)."
  (let* ((norm (asem-data::normalize text)))
    (cond ((gethash (asem-data::hash-key norm) (asem-data::deduper-exact d)) :exact)
          (t (let ((sig (asem-data::minhash-signature norm (asem-data::deduper-a d) (asem-data::deduper-b d))))
               (loop for band below asem-data::*bands*
                     for key = (let ((x 2166136261))
                                 (loop for r below asem-data::*rows* do (setf x (ldb (byte 62 0) (* (logxor x (aref sig (+ (* band asem-data::*rows*) r))) 1099511628211))))
                                 x)
                     when (gethash key (svref (asem-data::deduper-bands d) band)) return :near))))))

(defun write-items (path items)
  (with-open-file (o path :direction :output :if-exists :supersede :external-format :utf-8)
    (dolist (it items) (write-line (item-json-line it) o))))

(defun stats (items lengths)
  (let ((pos (make-array 4 :initial-element 0)) (cats (make-hash-table :test 'equal)) (catpos (make-hash-table :test 'equal)))
    (dolist (it items)
      (incf (aref pos (item-get it :answer))) (incf (gethash (item-get it :category) cats 0))
      (incf (gethash (format nil "~a/~a" (item-get it :category) (nth (item-get it :answer) +letters+)) catpos 0)))
    (jobj "n" (length items) "answer_positions" (jobj "A" (aref pos 0) "B" (aref pos 1) "C" (aref pos 2) "D" (aref pos 3))
          "categories" (cons :obj (loop for k being the hash-keys of cats using (hash-value v) collect (cons k v)))
          "category_by_position" (cons :obj (loop for k being the hash-keys of catpos using (hash-value v) collect (cons k v)))
          "max_input_tokens" (reduce #'max lengths) "mean_input_tokens" (/ (reduce #'+ lengths) (length lengths) 1d0)
          "min_input_tokens" (reduce #'min lengths))))

(let* ((data (or (opt-arg "data" nil) (error "data=DIR (Stage 1 data dir, for its tokenizer) is required")))
       (out (or (opt-arg "out" nil) (error "out=DIR is required")))
       (ctx (num "ctx" "128"))
       (manifest (asem-data:load-manifest data))
       (tok-file (format nil "~a/~a" data (asem-json:json-get (asem-json:json-get manifest "tokenizer") "file")))
       (bpe (asem-bpe:load-bpe tok-file))
       (letter-ids (mapcar (lambda (l) (asem-bpe:bpe-encode bpe (format nil " ~a" l))) +letters+))
       (fits (lambda (prompt) (<= (1+ (length (asem-bpe:bpe-encode bpe prompt))) ctx)))
       (exclude (make-hash-table :test 'equal))
       (report nil))
  (unless (every (lambda (ids) (= 1 (length ids))) letter-ids) (error "answer letters are not single tokens: ~a" letter-ids))
  (ensure-directories-exist (concatenate 'string out "/"))
  (flet ((gen (split n seed)
           (multiple-value-bind (items rejected reasons) (generate-split split n seed :fits fits :exclude exclude)
             (format t "~(~a~): ~d items, ~d candidates rejected~%" split (length items) rejected)
             (push (cons (string-downcase (symbol-name split))
                         (jobj "seed" seed "rejected_candidates" rejected
                               "rejection_reasons" (cons :obj (mapcar (lambda (r) (cons (car r) (cdr r))) reasons))))
                   report)
             items)))
    (let* ((test (gen :test (num "test" "1000") (num "seed-test" "3003")))
           (dev (gen :dev (num "dev" "500") (num "seed-dev" "2002")))
           (train (gen :train (num "train" "16000") (num "seed-train" "1001")))
           (letter-bad 0) (lens (make-hash-table)))
      ;; tokenization audit: lengths, and the answer letter is one fixed token in its real context
      (dolist (it (append test dev train))
        (let* ((p (item-prompt it)) (ids (asem-bpe:bpe-encode bpe p)))
          (push (1+ (length ids)) (gethash (intern (string-upcase (item-get it :split)) :keyword) lens))
          (unless (<= (1+ (length ids)) ctx) (error "item ~a is ~d tokens: does not fit" (item-get it :id) (1+ (length ids))))
          ;; text mode feeds the prompt plus all but the last token of each option
          (dolist (o (item-get it :options))
            (let ((need (+ (length ids) (length (asem-bpe:bpe-encode bpe (format nil " ~a" o))))))
              (unless (<= need ctx) (error "item ~a with option ~s needs ~d positions: does not fit" (item-get it :id) o need))))
          (loop for l in +letters+ for lid in letter-ids
                do (unless (equal (asem-bpe:bpe-encode bpe (format nil "~a ~a" p l)) (append ids lid)) (incf letter-bad)))))
      (format t "answer-letter tokenization mismatches in context: ~d~%" letter-bad)
      (unless (zerop letter-bad) (error "answer letters do not tokenize consistently after the prompt"))
      ;; near-duplicates: index dev+test passages, drop training items whose passage is a (near-)duplicate
      (let ((dd (asem-data:make-deduper :near t)) (dropped nil) (devtest-hits 0))
        (dolist (it test) (asem-data:duplicate-p dd (item-get it :passage)))
        (dolist (it dev) (when (asem-data:duplicate-p dd (item-get it :passage)) (incf devtest-hits)))
        (setf train (remove-if (lambda (it) (let ((d (duplicate-p-readonly dd (item-get it :passage)))) (when d (push (item-get it :id) dropped)) d)) train))
        (format t "near/exact duplicate passages: dev vs test ~d, training items removed ~d~%" devtest-hits (length dropped))
        (push (cons "near_duplicates" (jobj "dev_passages_matching_test" devtest-hits "train_items_removed" (length dropped)
                                            "method" "normalised exact SHA-256 + word 5-gram MinHash LSH (128 permutations, 16 bands x 8 rows), asem-data")) report))
      ;; entity disjointness
      (let ((ents (make-hash-table :test 'equal)) (shared 0))
        (dolist (it train) (dolist (o (item-get it :options)) (setf (gethash (string-downcase o) ents) t)))
        (dolist (it (append dev test))
          (dolist (o (item-get it :options))
            (when (and (gethash (string-downcase o) ents) (notevery #'digit-char-p o)) (incf shared))))
        (format t "non-numeric dev/test options that also occur as training options: ~d~%" shared)
        (push (cons "entity_overlap_non_numeric_options" shared) report))
      ;; wording overlap between split templates
      (flet ((ov (a b n) (let ((hits (frame-ngram-overlap a b n)))
                           (jobj "frames" (length (all-frames a)) "frames_sharing_an_ngram" (length hits)
                                 "examples" (coerce (mapcar (lambda (h) (format nil "~a  [~a]" (car h) (cdr h))) (subseq hits 0 (min 12 (length hits)))) 'vector)))))
        (push (cons "template_overlap" (jobj "test_vs_train_4gram" (ov :test :train 4) "test_vs_train_3gram" (ov :test :train 3)
                                             "dev_vs_train_4gram" (ov :dev :train 4) "dev_vs_train_3gram" (ov :dev :train 3)))
              report))
      (write-items (format nil "~a/test.jsonl" out) test)
      (write-items (format nil "~a/dev.jsonl" out) dev)
      (write-items (format nil "~a/train.jsonl" out) train)
      (let ((m (jobj "format" "asem-qa-1" "ctx" ctx "tokenizer_sha256" (asem-sha256:sha256-file-hex tok-file)
                     "answer_letter_token_ids" (coerce (mapcar #'first letter-ids) 'vector)
                     "prompt_format" "Text: ...\\nQ: ...\\nA. ...\\nB. ...\\nC. ...\\nD. ...\\nThe answer is  -> target \" X\" (letter mode, one token) or \" <option>\" (text mode); lengths above are for this format. Items were selected with the 4-token-longer original format (Passage:/Question:/Answer:), see qagen *prompt-style*"
                     "files" (jobj "test" (jobj "sha256" (asem-sha256:sha256-file-hex (format nil "~a/test.jsonl" out)) "stats" (stats test (gethash :test lens)))
                                   "dev" (jobj "sha256" (asem-sha256:sha256-file-hex (format nil "~a/dev.jsonl" out)) "stats" (stats dev (gethash :dev lens)))
                                   "train" (jobj "sha256" (asem-sha256:sha256-file-hex (format nil "~a/train.jsonl" out)) "stats" (stats train (gethash :train lens))))
                     "shortcut_baselines" (jobj "dev" (baselines dev) "test" (baselines test) "train" (baselines train))
                     "audit" (cons :obj (reverse report)))))
        (with-open-file (o (format nil "~a/manifest.json" out) :direction :output :if-exists :supersede :external-format :utf-8)
          (asem-json:write-json m o) (terpri o))
        (asem-json:write-json (asem-json:json-get m "shortcut_baselines") *standard-output*) (terpri)))))
