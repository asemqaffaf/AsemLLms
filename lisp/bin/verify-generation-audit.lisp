;;;; Independent saved-trace verification; no model or decoder-policy imports.
;;;; sbcl --script lisp/bin/verify-generation-audit.lisp dir=AUDIT-DIR out=NEW.json
(let ((here (directory-namestring *load-truename*)))
  (dolist (f '("util" "sha256" "json" "bpe" "verify-saved")) (load (merge-pathnames (format nil "../src/~a.lisp" f) here))))
(defun opt (key)
  (let ((p (concatenate 'string key "=")))
    (let ((x (find-if (lambda (s) (and (>= (length s) (length p)) (string= p s :end2 (length p)))) (cdr sb-ext:*posix-argv*)))) (and x (subseq x (length p))))))
(defun g (x k) (asem-verify-saved:g x k))
(defun xs (x) (coerce x 'list))
(defun obj (&rest x) (apply #'asem-verify-saved:obj x))
(defun same (a b label) (unless (equalp a b) (error "Mismatch: ~a" label)))
(defun best (scores choices)
  (let ((pairs (loop for id in choices for score across scores collect (cons id score))))
    (car (first (sort pairs (lambda (a b) (or (> (cdr a) (cdr b)) (and (= (cdr a) (cdr b)) (< (car a) (car b))))))))))
(defun starts (seq prefix) (and (>= (length seq) (length prefix)) (equalp (subseq seq 0 (length prefix)) (coerce prefix 'vector))))
(defun whole-word-p (name text)
  (loop with start = 0 for p = (search name text :start2 start) while p
        when (and (or (zerop p) (not (alphanumericp (char text (1- p)))))
                  (or (= (+ p (length name)) (length text)) (not (alphanumericp (char text (+ p (length name))))))) return t
        do (setf start (1+ p))))
(let* ((dir (string-right-trim "/" (or (opt "dir") (error "dir= required")))) (out (or (opt "out") (error "out= required")))
       (plan (asem-verify-saved:read-json (format nil "~a/plan.json" dir)))
       (mechanics (xs (asem-verify-saved:read-json (format nil "~a/mechanics.json" dir))))
       (directions (xs (asem-verify-saved:read-json (format nil "~a/direction-cases.json" dir))))
       (recovery (asem-verify-saved:read-json (format nil "~a/serialization-recovery.json" dir)))
       (data (asem-verify-saved:read-json (format nil "~a/decoding-normalized.json" dir)))
       (cases (xs (g data "cases"))) (bpe (asem-bpe:load-bpe (g plan "tokenizer")))
       (rescued 0) (prefix-match 0) (full-match 0) (rank-match 0) (score-match 0) (outside 0)
       (word-later 0) (trim-rescue 0) (case-rescue 0) (space-rescue 0) (median-masses nil) (gold-ranks nil))
  (when (probe-file out) (error "Refusing to overwrite verification"))
  (same (g recovery "raw_sha256") (asem-sha256:sha256-file-hex (g recovery "raw_file")) "raw preservation")
  (same (g recovery "normalized_sha256") (asem-sha256:sha256-file-hex (g recovery "normalized_file")) "normalized identity")
  (same (g data "plan_sha256") (asem-sha256:sha256-file-hex (format nil "~a/plan.json" dir)) "prepared plan")
  (same (g plan "checkpoint_sha256") (asem-sha256:sha256-file-hex (g plan "checkpoint")) "R7 unchanged")
  (same (g plan "tokenizer_sha256") (asem-sha256:sha256-file-hex (g plan "tokenizer")) "tokenizer")
  (dolist (kv (cdr (g plan "sources_sha256"))) (same (cdr kv) (asem-sha256:sha256-file-hex (car kv)) "frozen source"))
  (dolist (kv (cdr (g plan "prepared_sha256"))) (same (cdr kv) (asem-sha256:sha256-file-hex (format nil "~a/~a" dir (car kv))) "prepared data"))
  (unless (= 77 (length mechanics) (length cases)) (error "Need 77 selected cases"))
  (loop for m in mechanics for c in cases do
    (same (g m "id") (g c "id") "row alignment")
    (let* ((w (g m "world")) (row (g m "saved_prediction")) (key (g w "key"))
           (tails (g w "option_token_ids")) (gold (g m "gold_token_ids"))
           (prefix (g row "generated_token_ids")) (text (asem-bpe:bpe-decode bpe (xs prefix)))
           (name (aref (g w "options") key)) (path nil))
      (same (asem-bpe:bpe-decode bpe (xs gold)) (concatenate 'string " " name) "gold bytes")
      (same (coerce (asem-bpe:bpe-encode bpe (concatenate 'string " " name)) 'vector) gold "canonical gold BPE")
      (same (g row "generated_text") text "stored prefix text")
      (same (g c "unrestricted_text") text "independent greedy text")
      (when (equalp (g c "unrestricted_tokens") prefix) (incf prefix-match))
      (when (eq (g c "full_forward_first_argmax_matches") :true) (incf full-match))
      (let* ((scores (g c "stepwise_candidate_scores")) (old (g row "summed_option_logprob"))
             (delta (loop for a across scores for b across old maximize (abs (- a b)))))
        (when (= (best scores '(0 1 2 3)) key) (incf rank-match))
        (when (<= delta (g plan "score_tolerance")) (incf score-match)))
      (loop for step across (g c "trace") for i from 0 do
        (let* ((allowed (sort (remove-duplicates (loop for tail across tails when (starts tail path) collect (aref tail i))) #'<))
               (chosen (best (g step "allowed_logits") allowed)))
          (same (coerce path 'vector) (g step "prefix_token_ids") "trace prefix")
          (same (coerce allowed 'vector) (g step "allowed_token_ids") "admissible trie branches")
          (same chosen (g step "chosen") "restricted argmax")
          (when (and (zerop i) (not (member (g step "global_best") allowed))) (incf outside))
          (when (zerop i) (push (g step "allowed_probability_mass") median-masses))
          (setf path (append path (list chosen)))))
      (same (coerce path 'vector) (g c "constrained_tokens") "trie completion")
      (let ((choice (position (coerce path 'vector) tails :test #'equalp)))
        (unless choice (error "Completed text is not a candidate"))
        (same choice (g c "constrained_option") "candidate identity")
        (same (if (= choice key) :true :false) (g c "constrained_correct") "constrained correctness")
        (when (= choice key) (incf rescued)))
      (when (equal (string-trim '(#\Space #\Tab #\Newline #\Return) text) name) (incf trim-rescue))
      (when (string-equal (string-trim '(#\Space #\Tab #\Newline #\Return) text) name) (incf case-rescue))
      (when (equal (remove-if (lambda (x) (find x '(#\Space #\Tab #\Newline #\Return))) text)
                   (remove-if (lambda (x) (find x '(#\Space #\Tab #\Newline #\Return))) name)) (incf space-rescue))
      (when (whole-word-p name (g row "bounded_generated_text")) (incf word-later))
      (push (g c "root_gold_token_global_rank") gold-ranks)))
  (dolist (kv (list (cons "constrained_correct" rescued) (cons "saved_prefixes_reproduced" prefix-match)
                   (cons "full_forward_first_argmax_matches" full-match) (cons "stepwise_rankings_match" rank-match)
                   (cons "candidate_scores_within_tolerance" score-match) (cons "root_global_best_outside_candidates" outside)))
    (same (cdr kv) (g (g data "summary") (car kv)) "runner vs independent counts"))
  (unless (= 77 prefix-match full-match rank-match score-match) (error "Mechanics/score reproduction needs investigation"))
  (setf median-masses (sort median-masses #'<) gold-ranks (sort gold-ranks #'<))
  (asem-verify-saved:write-new-json out
    (obj "schema" "asem-generation-verification-1" "selected_worlds" 77 "constrained_correct" rescued "constrained_wrong" (- 77 rescued)
         "saved_prefixes_reproduced" prefix-match "full_forward_first_argmax_matches" full-match "stepwise_rankings_match" rank-match
         "candidate_scores_within_tolerance" score-match "root_global_best_outside_candidates" outside
         "whitespace_rescues" trim-rescue "casefold_rescues" case-rescue "remove_whitespace_rescues" space-rescue
         "gold_as_whole_word_in_bounded_output" word-later
         "median_root_candidate_token_mass" (nth 38 median-masses) "median_root_gold_token_rank" (nth 38 gold-ranks)
         "opposite_direction_cases" (length directions) "unique_role_error_pairs" (length (remove-duplicates (mapcar (lambda (d) (g d "pair_id")) directions) :test #'equal))
         "opposite_error_other_world_correct" (count :true directions :key (lambda (d) (g d "other_world_correct")))
         "opposite_error_in_both_worlds" (count :true directions :key (lambda (d) (g d "both_wrong_direction")))
         "checkpoint_sha256" (g plan "checkpoint_sha256") "decoding_sha256" (asem-sha256:sha256-file-hex (g recovery "normalized_file"))
         "verifier_source_sha256" (asem-sha256:sha256-file-hex "lisp/bin/verify-generation-audit.lisp")
         "model_inference_in_verifier" :false "training_updates" 0 "promotion" "none" "locked_test_accessed" :false))
  (format t "Independent trace verification: ~d/77 constrained correct, all 77 prefixes/scores reproduced.~%" rescued))
