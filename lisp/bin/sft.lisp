;;; Supervised fine-tuning on the Stage 2 QA training set; checkpoints selected on the development set only.
;;;   TLM_BLAS=1 sbcl --dynamic-space-size 12GB --script lisp/bin/sft.lisp data=data/fineweb/stage1 qa=data/qa/v1 out=data/runs/sft/NAME
;;;        [init=data/runs/final/10m/best.ckpt | init=scratch size=10m] [steps=2000] [batch=32] [accum=1] [workers=8] [lr=3e-4]
;;;        [warmup=50] [min-lr-frac=0.1] [clip=1.0] [wd=0] [seed=1] [eval-every=100] [log-every=10] [train-n=all]
;;;        [mode=letter|text] [aux-lm=0] [copy-mix=0] [copy-hi=8000] [copy-min-len=8] [copy-max-len=30] [tie=0] [relpos=0] [shuffle-labels=0] [resume=0] [stop-at=N] [save-every=0] [precision=32|64]
;;; Reads only QA/train.jsonl and QA/dev.jsonl: the locked test set is never opened here.
;;; shuffle-labels=1 is the control: every training answer letter is replaced by a seeded random letter.
(let ((here (directory-namestring *load-truename*)))
  (require :sb-posix)
  (dolist (f '("util" "sha256" "json" "bpe" "data" "qagen")) (load (merge-pathnames (format nil "../src/~a.lisp" f) here)))
  (defparameter cl-user::*here* here))
(defun opt-arg (name default)
  (let ((p (find-if (lambda (a) (and (> (length a) (length name)) (string= name a :end2 (length name)) (char= (char a (length name)) #\=)))
                    (cdr sb-ext:*posix-argv*))))
    (if p (subseq p (1+ (length name))) default)))
(let* ((p32 (not (equal (opt-arg "precision" "32") "64"))) (here cl-user::*here*))
  (dolist (f (if p32 '("tf32" "train32" "pretrain32" "sft32") '("tf" "train" "pretrain" "sft"))) (load (merge-pathnames (format nil "../src/~a.lisp" f) here)))
  (let* ((pkg (if p32 "ASEM-SFT32" "ASEM-SFT")) (ppkg (if p32 "ASEM-PRETRAIN32" "ASEM-PRETRAIN"))
         (fn (lambda (name &optional (p pkg)) (symbol-function (find-symbol name p))))
         (data (or (opt-arg "data" nil) (error "data=DIR is required"))) (qa (or (opt-arg "qa" nil) (error "qa=DIR is required")))
         (out (or (opt-arg "out" nil) (error "out=DIR is required")))
         (num (lambda (name default) (parse-integer (opt-arg name default))))
         (flt (lambda (name default) (float (let ((*read-default-float-format* 'double-float)) (read-from-string (opt-arg name default))) (if p32 1f0 1d0))))
         (manifest (asem-data:load-manifest data))
         (tok-file (format nil "~a/~a" data (asem-json:json-get (asem-json:json-get manifest "tokenizer") "file")))
         (bpe (asem-bpe:load-bpe tok-file))
         (init (opt-arg "init" (namestring (merge-pathnames "../../data/runs/final/10m/best.ckpt" here))))
         (model (if (equal init "scratch")
                    (funcall (find-symbol "INIT-MODEL" (if p32 "ASEM-TF32" "ASEM-TF"))
                             (funcall (funcall fn "PRESET-CONFIG" ppkg) (intern (string-upcase (opt-arg "size" "10m")) :keyword) 8192 128) (funcall num "seed" "1"))
                    (funcall (funcall fn "LOAD-CHECKPOINT" ppkg) init)))
         (model (if (and (equal (opt-arg "tie" "0") "1") (not (funcall (find-symbol "CONFIG-TIE" (if p32 "ASEM-TF32" "ASEM-TF")) (funcall (find-symbol "MODEL-CONFIG" (if p32 "ASEM-TF32" "ASEM-TF")) model))))
                    (funcall (find-symbol "ADD-TIE-GATE" (if p32 "ASEM-TF32" "ASEM-TF")) model) model))
         (model (let ((k (parse-integer (opt-arg "relpos" "0"))))
                  (if (and (plusp k) (not (funcall (find-symbol "CONFIG-RELPOS" (if p32 "ASEM-TF32" "ASEM-TF")) (funcall (find-symbol "MODEL-CONFIG" (if p32 "ASEM-TF32" "ASEM-TF")) model))))
                      (funcall (find-symbol "ADD-RELPOS" (if p32 "ASEM-TF32" "ASEM-TF")) model k) model)))
         (ctx (funcall (find-symbol "CONFIG-CTX" (if p32 "ASEM-TF32" "ASEM-TF")) (funcall (find-symbol "MODEL-CONFIG" (if p32 "ASEM-TF32" "ASEM-TF")) model)))
         (train-file (format nil "~a/train.jsonl" qa)) (dev-file (format nil "~a/dev.jsonl" qa))
         (train-items (asem-qagen:read-items train-file))
         (train-n (let ((s (opt-arg "train-n" "all"))) (if (equal s "all") (length train-items) (parse-integer s))))
         (train-items (subseq train-items 0 (min train-n (length train-items))))
         (letters (funcall (funcall fn "LETTER-TOKEN-IDS") bpe))
         (mode (intern (string-upcase (opt-arg "mode" "letter")) :keyword))
         (train-exs (funcall (funcall fn "ENCODE-ITEMS") train-items bpe ctx :mode mode))
         (train-exs (if (equal (opt-arg "shuffle-labels" "0") "1") (funcall (funcall fn "SHUFFLE-LABEL-TARGETS") train-exs letters 777) train-exs))
         (train-exs (let ((k (funcall num "copy-mix" "0")))
                      (if (plusp k) (concatenate 'vector train-exs (funcall (funcall fn "MAKE-COPY-EXAMPLES") k 99 :hi (funcall num "copy-hi" "8000")
                                                                                 :max-len (funcall num "copy-max-len" "30") :min-len (funcall num "copy-min-len" "8"))) train-exs)))
         (dev-exs (funcall (funcall fn "ENCODE-ITEMS") (asem-qagen:read-items dev-file) bpe ctx :mode mode)))
    (format t "train ~d examples, dev ~d, letters ~a, init ~a~%" (length train-exs) (length dev-exs) letters init)
    (funcall (funcall fn "SFT") out train-exs dev-exs letters :init-model model
             :steps (funcall num "steps" "2000") :batch (funcall num "batch" "32") :accum (funcall num "accum" "1")
             :workers (funcall num "workers" "8") :lr (funcall flt "lr" "3e-4") :warmup (funcall num "warmup" "50")
             :min-lr-frac (funcall flt "min-lr-frac" "0.1") :clip (funcall flt "clip" "1.0") :wd (funcall flt "wd" "0")
             :seed (funcall num "seed" "1") :eval-every (funcall num "eval-every" "100") :log-every (funcall num "log-every" "10")
             :resume (equal (opt-arg "resume" "0") "1") :stop-at (let ((s (opt-arg "stop-at" nil))) (and s (parse-integer s))) :aux-lm (funcall flt "aux-lm" "0") :save-every (funcall num "save-every" "0")
             :header (list :init init :init-sha256 (if (equal init "scratch") "scratch" (asem-sha256:sha256-file-hex init))
                           :size (opt-arg "size" "") :train-file train-file :train-sha256 (asem-sha256:sha256-file-hex train-file)
                           :dev-file dev-file :dev-sha256 (asem-sha256:sha256-file-hex dev-file) :tokenizer-sha256 (asem-sha256:sha256-file-hex tok-file)
                           :mode (opt-arg "mode" "letter") :copy-mix (opt-arg "copy-mix" "0") :tie (opt-arg "tie" "0") :relpos (opt-arg "relpos" "0") :shuffle-labels (opt-arg "shuffle-labels" "0") :train-n-used (length train-exs)
                           :argv (format nil "~{~a~^ ~}" (cdr sb-ext:*posix-argv*))))))
