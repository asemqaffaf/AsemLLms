;;;; Fixed evaluator for frozen mission development sets; no training/decoder overrides.
(let ((here (directory-namestring *load-truename*)))
  (require :sb-posix)
  (dolist (f '("util" "sha256" "json" "bpe" "data" "qagen" "retrieval" "tf32" "train32" "pretrain32" "sft32" "qa-analysis" "mission-data"))
    (load (merge-pathnames (format nil "../src/~a.lisp" f) here))))
(defun opt (key)
  (let ((prefix (concatenate 'string key "=")))
    (let ((a (find-if (lambda (a) (and (>= (length a) (length prefix)) (string= prefix a :end2 (length prefix)))) (cdr sb-ext:*posix-argv*))))
      (and a (subseq a (length prefix))))))
(let* ((bundle "docs/results/stage2/mission-20261111") (dataset (or (opt "dataset") (error "dataset= required")))
       (path (cond ((equal dataset "qa") "lisp/eval/qa/dev.jsonl")
                   ((member dataset '("selection" "confirmation") :test #'equal) (format nil "~a/~a.sexp" bundle dataset))
                   (t (error "Only mission development sets permitted"))))
       (ckpt (or (opt "ckpt") (error "ckpt= required"))) (out (or (opt "out") (error "out= required")))
       (items (if (equal dataset "qa") (asem-qa-analysis:read-development path "lisp/eval/qa/test.lock") (asem-mission-data:read-data path)))
       (bpe (asem-bpe:load-bpe "data/fineweb/stage1/tokenizer.bpe")) (hash (asem-sha256:sha256-file-hex ckpt)))
  (when (probe-file out) (error "Refusing to overwrite predictions"))
  (unless (= 500 (length items)) (error "Expected 500 development items"))
  (unless (equal dataset "qa")
    (let ((manifest (with-open-file (s (format nil "~a/manifest.json" bundle)) (asem-json:parse-json (let ((s1 (make-string (file-length s)))) (subseq s1 0 (read-sequence s1 s)))))))
      (unless (equal (asem-json:json-get (asem-json:json-get manifest "files_sha256") (format nil "~a.sexp" dataset)) (asem-sha256:sha256-file-hex path)) (error "Frozen dataset changed"))))
  (let* ((model (asem-pretrain32:load-checkpoint ckpt))
         (result (asem-qa-analysis:evaluate model bpe items :workers 4 :controls nil :paired nil)))
    (unless (equal hash (asem-sha256:sha256-file-hex ckpt)) (error "Checkpoint changed"))
    (asem-mission-data:write-json out
      (asem-mission-data:obj "schema" "asem-mission-eval-1" "dataset" dataset "items_sha256" (asem-sha256:sha256-file-hex path)
                             "checkpoint" ckpt "checkpoint_sha256" hash "conditions" result "locked_test_accessed" :false)))
  (format t "Saved ~a evaluation.~%" dataset))
