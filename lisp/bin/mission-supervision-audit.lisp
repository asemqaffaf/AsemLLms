;;;; Zero-training comparison of dense/isolated QA and familiar/unfamiliar prompts.
;;;; TLM_BLAS=1 VECLIB_MAXIMUM_THREADS=1 sbcl --script lisp/bin/mission-supervision-audit.lisp bundle=DIR out=NEW.json
(let ((here (directory-namestring *load-truename*)))
  (require :sb-posix)
  (dolist (f '("util" "sha256" "json" "bpe" "data" "qagen" "retrieval" "tf32" "train32" "pretrain32" "sft32" "qa-analysis" "wording" "mission-data"))
    (load (merge-pathnames (format nil "../src/~a.lisp" f) here))))
(defun opt (key)
  (let ((p (concatenate 'string key "=")))
    (let ((x (find-if (lambda (x) (and (>= (length x) (length p)) (string= p x :end2 (length p)))) (cdr sb-ext:*posix-argv*)))) (and x (subseq x (length p))))))
(defun obj (&rest x) (apply #'asem-mission-data:obj x))
(defun score (model ids targets cache)
  (let* ((n (- (length ids) (length targets))) (cfg (asem-tf32:model-config model)) (v (asem-tf32:config-vocab cfg))
         (acts (asem-sft32::acts-for cache cfg (length ids) t)) (rows (asem-sft32::ivec-of (loop for k below (length targets) collect (+ n k -1)))))
    (asem-tf32:forward-rows model (asem-sft32::padded-x (asem-sft32::ivec-of ids) (asem-tf32::acts-tlen acts)) acts rows)
    (let ((hits nil) (nll nil))
      (loop for token in targets for k from 0 do
        (let ((best 0) (offset (* k v)))
          (dotimes (j v) (when (> (aref (asem-tf32::acts-logits acts) (+ offset j)) (aref (asem-tf32::acts-logits acts) (+ offset best))) (setf best j)))
          (push (= best token) hits)
          (push (- (log (max 1d-300 (coerce (aref (asem-tf32::acts-probs acts) (+ offset token)) 'double-float)))) nll)))
      (list :first-hit (car (last hits)) :all-hit (every #'identity hits) :first-nll (car (last nll))
            :later-nll (if (> (length nll) 1) (/ (reduce #'+ (butlast nll)) (1- (length nll))) 0d0)))))
(defun summary (rs)
  (obj "n" (length rs) "first_correct" (count-if (lambda (r) (getf r :first-hit)) rs) "prefix_correct" (count-if (lambda (r) (getf r :all-hit)) rs)
       "mean_first_nll" (/ (reduce #'+ rs :key (lambda (r) (getf r :first-nll))) (max 1 (length rs)))
       "mean_later_nll" (/ (reduce #'+ rs :key (lambda (r) (getf r :later-nll))) (max 1 (length rs)))))
(let* ((bundle (or (opt "bundle") (error "bundle= required"))) (out (or (opt "out") (error "out= required")))
       (bpe (asem-bpe:load-bpe "data/fineweb/stage1/tokenizer.bpe"))
       (ckpt "data/runs/retrieval/r7-L123-aug-opts-rev-rsn/last.ckpt") (hash (asem-sha256:sha256-file-hex ckpt))
       (model (asem-pretrain32:load-checkpoint ckpt)) (cache (make-hash-table))
       (records (asem-mission-data:read-data (format nil "~a/audit-training.sexp" bundle)))
       (dense (asem-mission-data:question-examples records bpe)) (clean (asem-mission-data:question-examples records bpe :clean t))
       (selection (asem-mission-data:read-data (format nil "~a/selection.sexp" bundle)))
       (groups nil) (dense-r nil) (clean-r nil) (details nil))
  (when (probe-file out) (error "Refusing to overwrite audit"))
  (loop for d in dense for c in clean do
    (unless (equal (getf d :targets) (getf c :targets)) (error "Changed answer supervision"))
    (when (zerop (getf d :ordinal)) (unless (equal (getf d :ids) (getf c :ids)) (error "First QA differs")))
    (let ((a (score model (getf d :ids) (getf d :targets) cache)) (b (score model (getf c :ids) (getf c :targets) cache)))
      (push (list :ordinal (getf d :ordinal) :kind (getf d :kind) :score a) dense-r)
      (push (list :ordinal (getf d :ordinal) :kind (getf d :kind) :score b) clean-r)))
  (dolist (ordinal '("first" "later"))
    (let* ((firstp (equal ordinal "first")) (pred (lambda (r) (eq (zerop (getf r :ordinal)) firstp)))
           (a (mapcar (lambda (r) (getf r :score)) (remove-if-not pred dense-r)))
           (b (mapcar (lambda (r) (getf r :score)) (remove-if-not pred clean-r))))
      (push (cons ordinal (obj "dense" (summary a) "isolated" (summary b)
                              "first_token_gained_isolating" (loop for x in a for y in b count (and (not (getf x :first-hit)) (getf y :first-hit)))
                              "first_token_lost_isolating" (loop for x in a for y in b count (and (getf x :first-hit) (not (getf y :first-hit)))))) groups)))
  (dolist (category asem-qagen:+categories+)
    (let* ((its (subseq (remove-if-not (lambda (it) (equal category (getf it :category))) selection) 0 40)) (cells nil))
      (dolist (wording '(:unfamiliar :familiar))
        (let ((rs nil))
          (dolist (it its)
            (let* ((x (if (eq wording :familiar) (asem-wording:cell-item it '(:f :f) :policy :seeded) it))
                   (e (aref (asem-sft32:encode-items (list x) bpe 128 :mode :text) 0)))
              (push (score model (append (coerce (asem-sft32:ex-ids e) 'list) (coerce (asem-sft32::ex-tgt e) 'list))
                           (coerce (asem-sft32::ex-tgt e) 'list) cache) rs)))
          (push (cons (string-downcase (symbol-name wording)) (summary rs)) cells)))
      (push (cons category (cons :obj (nreverse cells))) details)))
  (unless (equal hash (asem-sha256:sha256-file-hex ckpt)) (error "R7 changed"))
  (asem-mission-data:write-json out (obj "schema" "asem-mission-supervision-audit-1" "training_updates" 0 "checkpoint_sha256" hash
                                        "training_prompt_contexts" (cons :obj (nreverse groups)) "paired_selection_wording" (cons :obj (nreverse details))
                                        "note" "Teacher-forced all-token argmax equals gold-prefix correctness if every decision matches. No candidate restriction. Training trace is canonical R7 distribution; selection has held-out entities. Confirmation predictions remain unopened."))
  (format t "Saved zero-training supervision audit.~%"))
