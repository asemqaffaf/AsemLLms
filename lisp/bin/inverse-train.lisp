;;;; Isolated matched pilot. Sequential invocations arm=control and arm=treatment.
(let ((here (directory-namestring *load-truename*)))
  (require :sb-posix)
  (dolist (f '("util" "sha256" "json" "bpe" "data" "qagen" "retrieval" "tf32" "train32" "pretrain32" "sft32" "qa-analysis" "mission-data" "verify-saved"))
    (load (merge-pathnames (format nil "../src/~a.lisp" f) here)))
  (funcall (find-symbol "LOAD-DERIVED" :asem-derive) (merge-pathnames "../experimental/inverse-contrastive/objective.lisp" here)))
(defun opt (key)
  (let ((p (concatenate 'string key "=")))
    (let ((a (find-if (lambda (a) (and (>= (length a) (length p)) (string= p a :end2 (length p)))) (cdr sb-ext:*posix-argv*)))) (and a (subseq a (length p))))))
(defun g (x k) (asem-json:json-get x k))
(let* ((bundle (or (opt "bundle") (error "bundle= required"))) (arm (or (opt "arm") (error "arm= required")))
       (out (or (opt "out") (error "out=NEW-DIR required")))
       (audit (asem-verify-saved:read-json (format nil "~a/data-audit.json" bundle)))
       (protocol (asem-verify-saved:read-json (format nil "~a/protocol.json" bundle)))
       (seed (g audit "seed")) (coefficient (cond ((equal arm "control") 0l0) ((equal arm "treatment") 1l0) (t (error "Unknown arm"))))
       (init "data/runs/retrieval/r7-L123-aug-opts-rev-rsn/last.ckpt")
       (reference "33a5c24521dfb1b28b456b8344bfd0869b84fe56aa622191b8f6bfa71cc42aa1")
       (bpe (asem-bpe:load-bpe "data/fineweb/stage1/tokenizer.bpe"))
       (annotations (make-hash-table :test 'equal)))
  (when (probe-file (format nil "~a/" out)) (error "Refusing to overwrite training output"))
  (unless (and (= 300 (g protocol "steps")) (= 15000 (g audit "dense_sequences")) (= 3000 (g audit "copy_sequences"))) (error "Unexpected pilot configuration"))
  (unless (equal reference (asem-sha256:sha256-file-hex init)) (error "Reference checkpoint changed"))
  (loop for (file . hash) in (cdr (g audit "source_sha256")) do (unless (equal hash (asem-sha256:sha256-file-hex file)) (error "Source changed: ~a" file)))
  (loop for (file . hash) in (cdr (g audit "sha256")) do (unless (equal hash (asem-sha256:sha256-file-hex (format nil "~a/~a" bundle file))) (error "Data changed: ~a" file)))
  (dolist (a (asem-mission-data:read-data (format nil "~a/annotations.sexp" bundle))) (setf (gethash (car a) annotations) (cdr a)))
  (asem-sft32::install-inverse-objective coefficient annotations)
  (let* ((triples (asem-mission-data:read-data (format nil "~a/data.sexp" bundle)))
         (train (concatenate 'vector
                  (loop for (ids rows targets) in triples for i from 0 collect (asem-sft32:multi-ex (format nil "r~d" i) ids rows targets))
                  (asem-sft32:make-copy-examples 3000 77 :lo 1 :hi 8192 :min-len 10 :max-len 40)))
         (dev (asem-sft32:encode-items (asem-mission-data:read-data "docs/results/stage2/mission-20261111/selection.sexp") bpe 128 :mode :text))
         (model (asem-pretrain32:load-checkpoint init)))
    (asem-sft32:sft out train dev (asem-sft32:letter-token-ids bpe) :init-model model
      :steps 300 :batch 32 :workers 4 :lr 1f-4 :warmup 30 :min-lr-frac 0.1f0 :clip 1f0 :wd 0f0
      :seed seed :eval-every 300 :log-every 20 :train-probe 32
      :header (list :mission "inverse-contrastive" :arm arm :coefficient coefficient :init init :init-sha256 reference
                    :protocol-sha256 (asem-sha256:sha256-file-hex (format nil "~a/protocol.json" bundle))
                    :protocol-notes-sha256 (asem-sha256:sha256-file-hex "docs/results/stage2/mission-20261111/pilot-protocol.md")
                    :data-audit-sha256 (asem-sha256:sha256-file-hex (format nil "~a/data-audit.json" bundle))
                    :driver-sha256 (asem-sha256:sha256-file-hex "lisp/bin/inverse-train.lisp"))))
  (unless (equal reference (asem-sha256:sha256-file-hex init)) (error "Reference changed during training")))
