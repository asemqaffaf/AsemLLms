;;; Per-kind L3 held-out retrieval diagnostics; no QA test entities/templates are used.
;;; TLM_BLAS=1 sbcl --dynamic-space-size 4GB --script lisp/bin/retrieval-kind-eval.lisp
;;;   data=data/fineweb/stage1 ckpt=CKPT out=NEW.json [n=600] [workers=4]
;;; Seen/unseen cells are independent deterministic draws, identical across checkpoints.
(let ((here (directory-namestring *load-truename*)))
  (require :sb-posix)
  (dolist (f '("util" "sha256" "json" "bpe" "data" "qagen" "retrieval" "tf32" "train32" "pretrain32" "sft32" "qa-analysis"))
    (load (merge-pathnames (format nil "../src/~a.lisp" f) here)))
  (defparameter cl-user::*kind-source* *load-truename*)
  (defparameter cl-user::*kind-here* here))
(defpackage :retrieval-kind-cli (:use :cl))
(in-package :retrieval-kind-cli)
(defun opt (name default)
  (let ((prefix (concatenate 'string name "=")))
    (let ((a (find-if (lambda (a) (and (<= (length prefix) (length a)) (string= prefix a :end2 (length prefix)))) (cdr sb-ext:*posix-argv*))))
      (if a (subseq a (length prefix)) default))))
(defun obj (&rest kvs) (apply #'asem-qa-analysis::obj kvs))
(defun arr (xs) (coerce xs 'vector))
(defun jb (b) (if b :true :false))
(defun acc (rows field &optional (bool nil))
  (let* ((n (length rows)) (k (count-if (lambda (r) (if bool (getf r field) (= (getf r field) (getf r :key)))) rows))
         (ci (asem-sft32:wilson k n)))
    (obj "n" n "correct" k "accuracy" (/ k (max 1 n) 1d0) "ci95_low" (first ci) "ci95_high" (second ci))))
(defun summary (rows)
  (let ((reasoning (remove-if-not (lambda (r) (member (getf r :kind) '("cmp" "tmp") :test #'equal)) rows)))
    (obj "exact_prefix" (acc rows :prefix t) "summed_option_likelihood" (acc rows :sum)
         "mean_token_option_likelihood" (acc rows :mean) "letter_A_to_D" (acc rows :letter)
         "no_question_exact_prefix" (acc reasoning :no-q t) "counterfactual_exact_prefix" (acc reasoning :cf t))))
(defun dataset-item (it)
  (obj "id" (getf it :id) "kind" (getf it :kind) "passage" (getf it :passage) "question" (getf it :question)
       "answer" (getf it :answer) "options" (arr (getf it :options)) "cf_question" (getf it :cf-question) "cf_answer" (getf it :cf-answer)))
(defun generation (it bpe ctx &optional (variant :real))
  (asem-sft32:generation-ex (getf it :id) (getf it :kind) ""
                           (asem-retrieval:retrieval-prompt
                            (getf it :passage) (if (eq variant :cf) (getf it :cf-question) (getf it :question))
                            :question-p (not (eq variant :no-q)) :options (getf it :options))
                           (if (eq variant :cf) (getf it :cf-answer) (getf it :answer)) bpe ctx))
(defun evaluate-cell (model bpe items workers)
  ;; All tokenizer memoization happens sequentially, before any parallel model inference.
  (let* ((ctx (asem-tf32:config-ctx (asem-tf32:model-config model)))
         (letters (asem-sft32:letter-token-ids bpe)) (text nil) (letter nil)
         (prefix (arr (mapcar (lambda (it) (generation it bpe ctx)) items)))
         (reasoning (remove-if-not (lambda (it) (member (getf it :kind) '("cmp" "tmp") :test #'equal)) items))
         (no-q (arr (mapcar (lambda (it) (generation it bpe ctx :no-q)) reasoning)))
         (cf (arr (mapcar (lambda (it) (generation it bpe ctx :cf)) reasoning))))
    (dolist (it items)
      (multiple-value-bind (a b) (asem-sft32:choice-exs
                                (getf it :id) (getf it :kind) ""
                                (asem-retrieval:retrieval-prompt (getf it :passage) (getf it :question) :options (getf it :options))
                                (getf it :options) (getf it :answer) bpe ctx)
        (push a text) (push b letter)))
    (let* ((text (arr (nreverse text)))
           (tp (asem-sft32:qa-predict model text letters :workers workers))
           (lp (asem-sft32:qa-predict model (arr (nreverse letter)) letters :workers workers))
           (pp (asem-sft32:qa-predict model prefix letters :workers workers))
           (nqp (asem-sft32:qa-predict model no-q letters :workers workers))
           (cfp (asem-sft32:qa-predict model cf letters :workers workers))
           (controls (make-hash-table :test 'equal)) (rows nil))
      (loop for it in reasoning for a in nqp for b in cfp
            do (setf (gethash (getf it :id) controls) (list (= (first a) 0) (= (first b) 0))))
      (loop for it in items for e across text for a in tp for b in lp for p in pp
            do (multiple-value-bind (sum mean means) (asem-qa-analysis:score-predictions (third a) (mapcar #'length (asem-sft32::ex-opts e)))
                 (let ((c (gethash (getf it :id) controls)))
                   (push (list :id (getf it :id) :kind (getf it :kind) :key (asem-sft32:ex-answer e)
                               :prefix (= (first p) 0) :sum sum :mean mean :letter (first b) :no-q (first c) :cf (second c)
                               :lengths (mapcar #'length (asem-sft32::ex-opts e)) :scores (third a) :means means) rows))))
      (setf rows (nreverse rows))
      (obj "summary" (summary rows)
           "by_kind" (cons :obj (loop for kind in '("attr" "num" "rel" "cmp" "tmp")
                                     collect (cons kind (summary (remove-if-not (lambda (r) (equal (getf r :kind) kind)) rows)))))
           "items" (arr (mapcar (lambda (r)
                                  (obj "id" (getf r :id) "kind" (getf r :kind) "key" (getf r :key)
                                       "exact_prefix" (jb (getf r :prefix)) "summed_option_prediction" (getf r :sum)
                                       "mean_token_option_prediction" (getf r :mean) "letter_prediction" (getf r :letter)
                                       "no_question_exact_prefix" (if (member (getf r :kind) '("cmp" "tmp") :test #'equal) (jb (getf r :no-q)) :null)
                                       "counterfactual_exact_prefix" (if (member (getf r :kind) '("cmp" "tmp") :test #'equal) (jb (getf r :cf)) :null)
                                       "option_token_lengths" (arr (getf r :lengths)) "summed_option_logprob" (arr (getf r :scores))
                                       "mean_token_option_logprob" (arr (getf r :means)))) rows))))))

(let* ((data (opt "data" "data/fineweb/stage1"))
       (ckpt (or (opt "ckpt" nil) (error "ckpt required"))) (out (or (opt "out" nil) (error "out required")))
       (n (parse-integer (opt "n" "600"))) (workers (parse-integer (opt "workers" "4")))
       (manifest (asem-data:load-manifest data))
       (bpe-file (format nil "~a/~a" data (asem-json:json-get (asem-json:json-get manifest "tokenizer") "file")))
       (bpe (asem-bpe:load-bpe bpe-file))
       (model (asem-pretrain32:load-checkpoint ckpt)) (ctx (asem-tf32:config-ctx (asem-tf32:model-config model)))
       (asem-retrieval:*reverse* t) (asem-retrieval:*reasoning* t)
       (fits (lambda (prompt answer) (<= (+ (length (asem-bpe:bpe-encode bpe prompt)) (length (asem-bpe:bpe-encode bpe (format nil " ~a" answer)))) ctx)))
       (cells (list (cons "seen" (asem-retrieval:probe-items 3 :new :seen n 19031 :fits fits :options t))
                    (cons "unseen" (asem-retrieval:probe-items 3 :new :unseen n 19032 :fits fits :options t))))
       (snapshot (obj "level" 3 "entities" "new" "n_per_cell" n "seen_seed" 19031 "unseen_seed" 19032
                      "seen" (arr (mapcar #'dataset-item (cdr (first cells)))) "unseen" (arr (mapcar #'dataset-item (cdr (second cells))))))
       (snapshot-text (with-output-to-string (s) (asem-json:write-json snapshot s) (terpri s)))
       (dataset-path (merge-pathnames (format nil "kind-probes-n~d.json" n) (pathname out)))
       (start (get-internal-real-time)) (results nil))
  (when (probe-file out) (error "Refusing to overwrite ~a" out))
  (ensure-directories-exist out)
  (if (probe-file dataset-path)
      (with-open-file (in dataset-path)
        (let ((old (make-string (file-length in))))
          (read-sequence old in) (unless (string= old snapshot-text) (error "Shared kind-probe dataset differs"))))
      (with-open-file (s dataset-path :direction :output :if-exists :error :if-does-not-exist :create) (write-string snapshot-text s)))
  (dolist (cell cells)
    (push (cons (car cell) (evaluate-cell model bpe (cdr cell) workers)) results)
    (format *error-output* "Kind eval ~a: ~d items finished~%" (car cell) n))
  (with-open-file (s out :direction :output :if-exists :error :if-does-not-exist :create)
    (asem-json:write-json
     (obj "schema" "asem-retrieval-kind-1" "checkpoint" ckpt "checkpoint_sha256" (asem-sha256:sha256-file-hex ckpt)
          "dataset" (namestring dataset-path) "dataset_sha256" (asem-sha256:sha256-file-hex dataset-path)
          "tokenizer_sha256" (asem-sha256:sha256-file-hex bpe-file)
          "source_sha256" (asem-sha256:sha256-file-hex cl-user::*kind-source*)
          "retrieval_source_sha256" (asem-sha256:sha256-file-hex (merge-pathnames "../src/retrieval.lisp" cl-user::*kind-here*))
          "sft_source_sha256" (asem-sha256:sha256-file-hex (merge-pathnames "../src/sft.lisp" cl-user::*kind-here*))
          "n_per_cell" n "workers" workers "level" 3 "entities" "new" "locked_test" :false
          "seconds" (/ (- (get-internal-real-time) start) internal-time-units-per-second 1d0)
          "note" "Exact-prefix counts target-token argmax agreement, equivalent to a correct greedy prefix of gold length; termination is not scored. Cells use independent seeds and both passage/question wording change. Same saved items are used across checkpoints. Controls cover cmp/tmp only."
          "cells" (cons :obj (nreverse results))) s)
    (terpri s)))
