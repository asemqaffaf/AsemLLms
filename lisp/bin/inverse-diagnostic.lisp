;;;; Posthoc training-distribution diagnostic, never a development selection metric.
(let ((here (directory-namestring *load-truename*)))
  (require :sb-posix)
  (dolist (f '("util" "sha256" "json" "bpe" "data" "qagen" "retrieval" "tf32" "train32" "pretrain32" "sft32" "qa-analysis" "mission-data"))
    (load (merge-pathnames (format nil "../src/~a.lisp" f) here))))
(defun opt (key)
  (let ((p (concatenate 'string key "=")))
    (let ((a (find-if (lambda (a) (and (>= (length a) (length p)) (string= p a :end2 (length p)))) (cdr sb-ext:*posix-argv*)))) (and a (subseq a (length p))))))
(defun obj (&rest x) (apply #'asem-mission-data:obj x))
(let* ((bundle (or (opt "bundle") (error "bundle= required"))) (ckpt (or (opt "ckpt") (error "ckpt= required")))
       (out (or (opt "out") (error "out= required")))
       (all (apply #'append (mapcar #'cdr (asem-mission-data:read-data (format nil "~a/annotations.sexp" bundle)))))
       (model (asem-pretrain32:load-checkpoint ckpt)) (cache (make-hash-table)) (groups nil))
  (when (probe-file out) (error "Refusing to overwrite diagnostic"))
  (dolist (reason '(:opposite-role :other-bound-person))
    (let* ((pairs (subseq (remove-if-not (lambda (p) (eq (getf p :reason) reason)) all) 0 100)) (rows nil))
      (dolist (p pairs)
        (let* ((e (asem-sft32::make-ex :ids (asem-sft32::ivec-of (getf p :prompt)) :tgt (asem-sft32::ivec-of (getf p :gold)) :mode :copy :answer 0))
               (gold (asem-sft32::score-continuation model e (asem-sft32::ivec-of (getf p :gold)) cache))
               (wrong (asem-sft32::score-continuation model e (asem-sft32::ivec-of (getf p :wrong)) cache))
               (margin (- gold wrong)))
          (multiple-value-bind (loss pred) (asem-sft32::run-example model e cache nil)
            (declare (ignore loss))
            (push (obj "question" (getf p :question) "gold" (getf p :answer) "wrong" (getf p :negative)
                       "margin" margin "gold_logprob" gold "prefix_exact" (if (zerop pred) :true :false)) rows))))
      (setf rows (nreverse rows))
      (push (cons (string-downcase (symbol-name reason))
              (obj "n" 100 "gold_above_wrong" (count-if (lambda (r) (> (asem-json:json-get r "margin") 0)) rows)
                   "prefix_correct" (count :true rows :key (lambda (r) (asem-json:json-get r "prefix_exact")))
                   "mean_margin" (/ (reduce #'+ rows :key (lambda (r) (asem-json:json-get r "margin"))) 100d0)
                   "items" (coerce rows 'vector))) groups)))
  (asem-mission-data:write-json out (obj "schema" "asem-inverse-training-diagnostic-1" "checkpoint_sha256" (asem-sha256:sha256-file-hex ckpt)
    "selection_rule" "First 100 annotations per negative reason, source order; no prediction-dependent sampling. Training distribution only. Posthoc diagnostic, not fresh generalization evidence."
    "annotations_sha256" (asem-sha256:sha256-file-hex (format nil "~a/annotations.sexp" bundle)) "groups" (cons :obj (nreverse groups)))))
