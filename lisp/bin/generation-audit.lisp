;;;; R7-only decoding diagnostic. Prepare uses saved data only; run traces 77 selected prompts.
;;;; sbcl --script lisp/bin/generation-audit.lisp mode=prepare bundle=DIR out=NEW-DIR
;;;; TLM_BLAS=1 VECLIB_MAXIMUM_THREADS=1 sbcl --dynamic-space-size 4GB --script lisp/bin/generation-audit.lisp mode=run out=PREPARED-DIR
(let ((here (directory-namestring *load-truename*)))
  (require :sb-posix)
  (dolist (f '("util" "sha256" "json" "bpe" "data" "qagen" "tf32" "train32" "pretrain32" "sft32" "verify-saved" "candidate-decode"))
    (load (merge-pathnames (format nil "../src/~a.lisp" f) here))))
(defun opt (key default)
  (let* ((prefix (concatenate 'string key "="))
         (s (find-if (lambda (x) (and (>= (length x) (length prefix)) (string= prefix x :end2 (length prefix)))) (cdr sb-ext:*posix-argv*))))
    (if s (subseq s (length prefix)) default)))
(defun g (x k) (asem-verify-saved:g x k))
(defun obj (&rest kvs) (apply #'asem-verify-saved:obj kvs))
(defun jb (b) (if b :true :false))
(defun arr (x) (coerce x 'vector))
(defun xs (x) (coerce x 'list))
(defun readj (p) (asem-verify-saved:read-json p))
(defun writej (p x) (asem-verify-saved:write-new-json p x))
(defun trim-space (s) (string-trim '(#\Space #\Tab #\Newline #\Return) s))
(defun remove-space (s) (remove-if (lambda (c) (find c '(#\Space #\Tab #\Newline #\Return))) s))
(defun token-pieces (bpe ids)
  (arr (loop for id across ids collect (obj "id" id "decoded_piece" (asem-bpe:bpe-decode bpe (list id))
                                           "bytes" (copy-seq (aref (asem-bpe::bpe-bytes bpe) id))))))
(defparameter *checkpoint* "data/runs/retrieval/r7-L123-aug-opts-rev-rsn/last.ckpt")
(defparameter *checkpoint-hash* "33a5c24521dfb1b28b456b8344bfd0869b84fe56aa622191b8f6bfa71cc42aa1")
(defparameter *tokenizer* "data/fineweb/stage1/tokenizer.bpe")
(defparameter *sources* '("lisp/bin/generation-audit.lisp" "lisp/src/candidate-decode.lisp" "lisp/src/bpe.lisp" "lisp/src/tf.lisp" "lisp/src/tf32.lisp"
                         "lisp/src/sft.lisp" "lisp/src/sft32.lisp" "lisp/src/derive.lisp" "lisp/src/verify-saved.lisp"))

(defun mechanics (bpe world row)
  (let* ((key (g world "key")) (gold (aref (g world "options") key)) (gold-ids (aref (g world "option_token_ids") key))
         (ids (g row "generated_token_ids")) (bounded (g row "bounded_generated_token_ids"))
         (text (asem-bpe:bpe-decode bpe (xs ids))) (gold-text (format nil " ~a" gold))
         (prompt (asem-qagen:format-prompt (g world "passage") (g world "question") (xs (g world "options"))))
         (pids (asem-bpe:bpe-encode bpe prompt)))
    (obj "id" (g world "id") "world" world "saved_prediction" row
         "gold_token_ids" gold-ids "gold_token_pieces" (token-pieces bpe gold-ids)
         "generated_token_pieces" (token-pieces bpe ids) "bounded_token_pieces" (token-pieces bpe bounded)
         "decoded_prefix" text "decoded_gold_continuation" (asem-bpe:bpe-decode bpe (xs gold-ids))
         "gold_byte_roundtrip" (jb (equal gold-text (asem-bpe:bpe-decode bpe (xs gold-ids))))
         "gold_canonical_bpe" (jb (equal (xs gold-ids) (asem-bpe:bpe-encode bpe gold-text)))
         "prompt_ids_match" (jb (equal (cons 0 pids) (xs (g world "prompt_token_ids"))))
         "prompt_answer_boundary_matches" (jb (equal (asem-bpe:bpe-encode bpe (concatenate 'string prompt gold-text)) (append pids (xs gold-ids))))
         "saved_prefix_text_matches_decode" (jb (equal text (g row "generated_text")))
         "prefix_matches_saved_bounded_start" (jb (equalp ids (subseq bounded 0 (min (length ids) (length bounded)))))
         "whitespace_trim_rescues" (jb (equal (trim-space text) gold))
         "casefold_trim_rescues" (jb (string-equal (trim-space text) gold))
         "remove_all_whitespace_rescues" (jb (equal (remove-space text) (remove-space gold)))
         "full_bounded_text_is_gold" (jb (equal (trim-space (g row "bounded_generated_text")) gold))
         "gold_occurs_in_full_bounded_text" (jb (search gold (g row "bounded_generated_text")))
         "early_prefix_shortening" (jb (< (length ids) (length gold-ids)))
         "prefix_contains_eot" (jb (find 0 ids)))))

(defun prepare (bundle out)
  (when (probe-file (format nil "~a/" out)) (error "Refusing to reuse output directory"))
  (asem-verify-saved:verify-binding bundle)
  (let* ((pairs (xs (readj (format nil "~a/pairs.json" bundle))))
         (result (readj (format nil "~a/r7.json" bundle)))
         (rows (xs (g (g (g result "conditions") "real") "items")))
         (index (make-hash-table :test 'equal)) (selected nil) (direction nil)
         (bpe (asem-bpe:load-bpe *tokenizer*)))
    (dolist (r rows) (setf (gethash (g r "id") index) r))
    (dolist (pair pairs)
      (when (equal (g pair "category") "relation")
        (let* ((worlds (xs (g pair "worlds"))) (preds (mapcar (lambda (w) (gethash (g w "id") index)) worlds)))
          (loop for w in worlds for r in preds for other in (reverse worlds) for other-row in (reverse preds) do
            (when (and (= (g r "summed_option_prediction") (g w "key")) (eq (g r "gold_length_greedy_prefix_exact") :false))
              (push (mechanics bpe w r) selected))
            (when (= (g r "summed_option_prediction") (g other "key"))
              (push (obj "id" (g w "id") "pair_id" (g pair "id") "family" (g pair "family")
                         "world" w "prediction" r "reversed_world" other "reversed_prediction" other-row
                         "other_world_correct" (jb (= (g other-row "summed_option_prediction") (g other "key")))
                         "both_wrong_direction" (jb (= (g other-row "summed_option_prediction") (g w "key")))) direction))))))
    (setf selected (nreverse selected) direction (nreverse direction))
    (unless (= 77 (length selected)) (error "Expected exactly 77 ranking-correct prefix failures"))
    (unless (= 104 (length direction)) (error "Expected exactly 104 direction errors"))
    (dolist (case selected)
      (dolist (k '("gold_byte_roundtrip" "gold_canonical_bpe" "prompt_ids_match" "prompt_answer_boundary_matches" "saved_prefix_text_matches_decode" "prefix_matches_saved_bounded_start"))
        (unless (eq (g case k) :true) (error "Mechanics mismatch ~a: ~a" (g case "id") k))))
    (ensure-directories-exist (format nil "~a/" out))
    (writej (format nil "~a/mechanics.json" out) (arr selected))
    (writej (format nil "~a/direction-cases.json" out) (arr direction))
    (writej (format nil "~a/plan.json" out)
      (obj "schema" "asem-generation-audit-plan-1" "bundle" bundle "selected_worlds" 77 "direction_error_worlds" 104
           "selection" "R7 relationship ranking correct and saved greedy gold-length prefix incorrect; fixed before new inference."
           "reference" "r7" "checkpoint" *checkpoint* "checkpoint_sha256" *checkpoint-hash*
           "tokenizer" *tokenizer* "tokenizer_sha256" (asem-sha256:sha256-file-hex *tokenizer*)
           "sources_sha256" (cons :obj (loop for p in *sources* collect (cons p (asem-sha256:sha256-file-hex p))))
           "inputs_sha256" (cons :obj (loop for p in '("pairs.json" "r7.json" "verification.json") collect (cons p (asem-sha256:sha256-file-hex (format nil "~a/~a" bundle p)))))
           "prepared_sha256" (obj "mechanics.json" (asem-sha256:sha256-file-hex (format nil "~a/mechanics.json" out))
                                  "direction-cases.json" (asem-sha256:sha256-file-hex (format nil "~a/direction-cases.json" out)))
           "decoding" "Unrestricted argmax and token-wise candidate-trie argmax, lowest-token-ID ties. Trie has no gold input; stops at the equal-length candidate boundary."
           "mechanics_reference" "Independent unpadded last-row logits; full-forward first-step reference; stepwise teacher-forced candidate log probabilities compared with saved summed scores."
           "score_tolerance" .0001d0 "training_updates" 0 "promotion" "none"
           "interpretation" "Selected subset only. Whole-candidate summed likelihood is correct by selection and is not a new outcome. Constraint rescue is not unconstrained generation, improved weights, or learned termination."))
    (format t "Prepared 77 generation failures and 104 separate role-error records; no new inference.~%")))

(defun distribution (model ids cache)
  (let* ((cfg (asem-tf32:model-config model)) (n (length ids)) (v (asem-tf32:config-vocab cfg))
         (acts (or (gethash n cache) (setf (gethash n cache) (asem-tf32:make-acts cfg n 1)))))
    (when (> n (asem-tf32:config-ctx cfg)) (error "Context overflow"))
    (asem-tf32:forward-rows model (asem-sft32::ivec-of ids) acts (asem-sft32::ivec-of (list (1- n))))
    (list (subseq (asem-tf32::acts-logits acts) 0 v) (subseq (asem-tf32::acts-probs acts) 0 v))))
(defun global-rank (logits id)
  (1+ (loop for x across logits for i from 0 count (or (> x (aref logits id)) (and (= x (aref logits id)) (< i id))))))
(defun run-case (model bpe case acts-cache)
  (let* ((w (g case "world")) (row (g case "saved_prediction")) (ids (xs (g w "prompt_token_ids")))
         (tails (xs (g w "option_token_ids"))) (gold (g case "gold_token_ids")) (memo (make-hash-table :test 'equal))
         (calls 0))
    (labels ((dist (prefix) (or (gethash prefix memo)
                                (setf (gethash (copy-list prefix) memo)
                                      (progn (incf calls) (distribution model (append ids prefix) acts-cache)))))
             (logits (prefix) (first (dist prefix))))
      (let* ((free (asem-candidate-decode:greedy-unrestricted (length gold) #'logits))
             (root (logits nil)) (v (length root)) (full (asem-tf32:make-acts (asem-tf32:model-config model) (length ids)))
             (full-best nil) (full-max-diff 0d0) (scores nil))
        (asem-tf32:forward model (asem-sft32::ivec-of ids) full)
        (let ((last (subseq (asem-tf32::acts-logits full) (* (1- (length ids)) v) (* (length ids) v))))
          (setf full-best (asem-candidate-decode:argmax last))
          (dotimes (i v) (setf full-max-diff (max full-max-diff (abs (- (aref root i) (aref last i)))))))
        (dolist (tail tails)
          (let ((prefix nil) (score 0d0))
            (loop for tk across tail do (incf score (log (max 1d-300 (coerce (aref (second (dist prefix)) tk) 'double-float))))
                                      (setf prefix (append prefix (list tk))))
            (push score scores)))
        (setf scores (nreverse scores))
        (multiple-value-bind (constrained choice trace) (asem-candidate-decode:greedy-candidate tails #'logits)
          (obj "id" (g w "id") "gold" (g row "gold_text") "key" (g w "key")
               "unrestricted_tokens" (arr free) "unrestricted_text" (asem-bpe:bpe-decode bpe free)
               "saved_prefix_reproduced" (jb (equal free (xs (g row "generated_token_ids"))))
               "full_forward_first_argmax_matches" (jb (= full-best (first free))) "full_forward_max_logit_difference" full-max-diff
               "stepwise_candidate_scores" (arr scores) "saved_candidate_scores" (g row "summed_option_logprob")
               "max_candidate_score_difference" (reduce #'max (mapcar (lambda (a b) (abs (- a b))) scores (xs (g row "summed_option_logprob"))))
               "stepwise_ranking_matches" (jb (= (asem-candidate-decode:argmax (arr scores)) (g row "summed_option_prediction")))
               "constrained_tokens" (arr constrained) "constrained_token_pieces" (token-pieces bpe (arr constrained))
               "constrained_text" (asem-bpe:bpe-decode bpe constrained) "constrained_option" choice
               "constrained_correct" (jb (= choice (g w "key"))) "network_contexts_evaluated" calls
               "root_global_best" (asem-candidate-decode:argmax root) "root_gold_token" (aref gold 0)
               "root_gold_token_global_rank" (global-rank root (aref gold 0))
               "trace" (arr (loop for step in trace for i from 0 collect
                 (let* ((prefix (getf step :prefix)) (allowed (getf step :allowed)) (d (dist prefix)) (ll (first d)) (pp (second d)))
                   (obj "step" i "prefix_token_ids" (arr prefix) "allowed_token_ids" (arr allowed)
                        "chosen" (getf step :chosen) "global_best" (getf step :global)
                        "global_best_allowed" (jb (member (getf step :global) allowed))
                        "allowed_probability_mass" (reduce #'+ allowed :key (lambda (tk) (coerce (aref pp tk) 'double-float)))
                        "allowed_logits" (arr (mapcar (lambda (tk) (aref ll tk)) allowed))))))))))))

(defun run-audit (out)
  (let* ((plan (readj (format nil "~a/plan.json" out))) (report-path (format nil "~a/decoding.json" out)))
    (when (probe-file report-path) (error "Refusing to overwrite decoding results"))
    (unless (equal (g plan "schema") "asem-generation-audit-plan-1") (error "Wrong plan"))
    (dolist (kv (cdr (g plan "sources_sha256"))) (assert (equal (cdr kv) (asem-sha256:sha256-file-hex (car kv)))))
    (dolist (kv (cdr (g plan "prepared_sha256"))) (assert (equal (cdr kv) (asem-sha256:sha256-file-hex (format nil "~a/~a" out (car kv))))))
    (dolist (kv (cdr (g plan "inputs_sha256"))) (assert (equal (cdr kv) (asem-sha256:sha256-file-hex (format nil "~a/~a" (g plan "bundle") (car kv))))))
    (assert (equal *checkpoint-hash* (asem-sha256:sha256-file-hex *checkpoint*)))
    (assert (equal (g plan "tokenizer_sha256") (asem-sha256:sha256-file-hex *tokenizer*)))
    (let* ((bpe (asem-bpe:load-bpe *tokenizer*)) (model (asem-pretrain32:load-checkpoint *checkpoint*))
           (cases (xs (readj (format nil "~a/mechanics.json" out)))) (cache (make-hash-table)) (results nil))
      (dolist (c cases) (push (run-case model bpe c cache) results))
      (setf results (nreverse results))
      (assert (equal *checkpoint-hash* (asem-sha256:sha256-file-hex *checkpoint*)))
      (writej report-path
        (obj "schema" "asem-generation-audit-1" "checkpoint_sha256" *checkpoint-hash* "plan_sha256" (asem-sha256:sha256-file-hex (format nil "~a/plan.json" out))
             "selected_worlds" (length results) "training_updates" 0 "promotion" "none" "locked_test_accessed" :false
             "summary" (obj "saved_prefixes_reproduced" (count :true results :key (lambda (r) (g r "saved_prefix_reproduced")))
                            "full_forward_first_argmax_matches" (count :true results :key (lambda (r) (g r "full_forward_first_argmax_matches")))
                            "stepwise_rankings_match" (count :true results :key (lambda (r) (g r "stepwise_ranking_matches")))
                            "candidate_scores_within_tolerance" (count-if (lambda (r) (<= (g r "max_candidate_score_difference") (g plan "score_tolerance"))) results)
                            "constrained_correct" (count :true results :key (lambda (r) (g r "constrained_correct")))
                            "root_global_best_outside_candidates" (count-if (lambda (r) (eq (g (aref (g r "trace") 0) "global_best_allowed") :false)) results))
             "cases" (arr results)))
      (format t "Traced ~d R7 prompts with frozen weights; saved ~a.~%" (length results) report-path))))

(let ((mode (opt "mode" "prepare")) (out (string-right-trim "/" (or (opt "out" nil) (error "out=DIR required")))))
  (cond ((equal mode "prepare") (prepare (string-right-trim "/" (or (opt "bundle" nil) (error "bundle=DIR required"))) out))
        ((equal mode "run") (run-audit out)) (t (error "mode must be prepare or run"))))
