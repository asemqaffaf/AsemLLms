;;;; Model-free independent arithmetic and saved-record validation. No evaluator imports.
;;;; first=RESULT.json second=RESULT.json baseline=R7.json out=NEW.json
(let ((here (directory-namestring *load-truename*)))
  (dolist (f '("util" "sha256" "json" "bpe" "verify-saved")) (load (merge-pathnames (format nil "../src/~a.lisp" f) here))))
(defun opt (key)
  (let ((p (concatenate 'string key "=")))
    (let ((a (find-if (lambda (a) (and (>= (length a) (length p)) (string= p a :end2 (length p)))) (cdr sb-ext:*posix-argv*)))) (and a (subseq a (length p))))))
(defun g (x k) (asem-verify-saved:g x k))
(defun obj (&rest x) (apply #'asem-verify-saved:obj x))
(defun seq-list (x) (coerce x 'list))
(defun items (x) (seq-list (g (g (g x "conditions") "real") "items")))
(defun selected (rows category)
  (cond ((equal category "all") rows)
        ((equal category "inverse") (remove-if-not (lambda (r) (member (g r "category") '("relation" "reverse") :test #'equal)) rows))
        (t (remove-if-not (lambda (r) (equal category (g r "category"))) rows))))
(defparameter *groups* '("all" "inverse" "extract" "relation" "reverse" "compare" "temporal"))
(defparameter *fields* '("summed_option_prediction" "gold_length_greedy_prefix_exact" "bounded_free_generation_exact"))
(defun compare-rows (a b)
  (cons :obj (loop for field in *fields* collect
    (cons field (cons :obj (loop for category in *groups* collect
      (cons category (asem-verify-saved:paired-records (selected a category) (selected b category) field))))))))
(defun independently-validate (data bpe)
  (let ((rows (items data)) (ids (make-hash-table :test 'equal)) (summary (g (g (g data "conditions") "real") "summary")))
    (unless (= 500 (length rows)) (error "Expected 500 saved predictions"))
    (dolist (r rows)
      (when (gethash (g r "id") ids) (error "Duplicate saved ID")) (setf (gethash (g r "id") ids) t)
      (let* ((scores (seq-list (g r "summed_option_logprob"))) (key (g r "key"))
             (gold (asem-bpe:bpe-encode bpe (concatenate 'string " " (g r "gold_text"))))
             (prefix (seq-list (g r "generated_token_ids"))) (pred (position (reduce #'max scores) scores)))
        (unless (and (= 4 (length scores)) (every #'realp scores) (integerp key) (<= 0 key 3)
                     (= pred (g r "summed_option_prediction"))) (error "Invalid saved ranking"))
        (unless (eq (g r "gold_length_greedy_prefix_exact") (if (equal prefix gold) :true :false)) (error "Invalid prefix exact flag"))
        (unless (string= (asem-bpe:bpe-decode bpe prefix) (g r "generated_text")) (error "Saved prefix text/token mismatch"))
        (unless (eq (g r "bounded_free_generation_exact") (if (string= (g r "bounded_generated_text") (g r "gold_text")) :true :false)) (error "Invalid complete-answer exact flag"))))
    (loop for field in *fields* for metric in '("summed_option_likelihood" "gold_length_greedy_prefix_exact" "bounded_free_generation_exact") do
      (dolist (category (remove "inverse" *groups* :test #'equal))
        (let* ((rr (selected rows category)) (ref (if (equal category "all") (g summary metric) (g (g (g summary metric) "by_category") category)))
               (hits (count-if (lambda (r) (if (equal field "summed_option_prediction") (= (g r field) (g r "key")) (eq (g r field) :true))) rr)))
          (unless (and (= (length rr) (g ref "n")) (= hits (g ref "correct")) (< (abs (- (/ hits (length rr) 1d0) (g ref "accuracy"))) 1d-12))
            (error "Saved summary does not recompute: ~a/~a" metric category)))))
    rows))
(let* ((a (asem-verify-saved:read-json (or (opt "first") (error "first= required"))))
       (b (asem-verify-saved:read-json (or (opt "second") (error "second= required"))))
       (r (asem-verify-saved:read-json (or (opt "baseline") (error "baseline= required"))))
       (out (or (opt "out") (error "out= required")))
       (bpe (asem-bpe:load-bpe "data/fineweb/stage1/tokenizer.bpe")))
  (unless (and (equal (g a "items_sha256") (g b "items_sha256")) (equal (g a "items_sha256") (g r "items_sha256"))) (error "Different development inputs"))
  (let* ((aa (independently-validate a bpe)) (bb (independently-validate b bpe)) (rr (independently-validate r bpe))
         (paired (compare-rows aa bb)) (r7a (compare-rows rr aa)) (r7b (compare-rows rr bb))
         (primary (g (g paired "summed_option_prediction") "inverse")))
    (asem-verify-saved:write-new-json out
      (obj "schema" "asem-mission-independent-verification-1" "records_checked" 1500 "items_sha256" (g a "items_sha256")
           "first_checkpoint_sha256" (g a "checkpoint_sha256") "second_checkpoint_sha256" (g b "checkpoint_sha256")
           "paired_treatment_minus_control" paired "paired_control_minus_r7" r7a "paired_treatment_minus_r7" r7b
           "primary_effect_gate" (if (and (>= (g primary "diff") 0.1d0) (< (g primary "mcnemar_exact_two_sided_p") (/ .05d0 3))) :true :false)
           "retention_note" "Observed-score gates only; no statistical noninferiority claim. Inspect all categories and prefix before advancing."
           "language" "Common Lisp; independent saved-result logic; no model/evaluator imports"))))
