;;;; Prepare common training data and semantic annotations. No model is loaded.
(let ((here (directory-namestring *load-truename*)))
  (require :sb-posix)
  (dolist (f '("util" "sha256" "json" "bpe" "data" "qagen" "retrieval" "tf32" "train32" "pretrain32" "sft32" "qa-analysis" "mission-data"))
    (load (merge-pathnames (format nil "../src/~a.lisp" f) here)))
  (load (merge-pathnames "../experimental/inverse-contrastive/data.lisp" here)))
(defun opt (key default)
  (let ((p (concatenate 'string key "=")))
    (let ((a (find-if (lambda (a) (and (>= (length a) (length p)) (string= p a :end2 (length p)))) (cdr sb-ext:*posix-argv*)))) (if a (subseq a (length p)) default))))
(let* ((out (or (opt "out" nil) (error "out=NEW-DIR required"))) (seed (parse-integer (opt "seed" "111201")))
       (n (parse-integer (opt "n" "15000"))) (bpe (asem-bpe:load-bpe "data/fineweb/stage1/tokenizer.bpe"))
       (asem-retrieval:*broad-train* t) (asem-retrieval:*augment* t) (asem-retrieval:*reverse* t) (asem-retrieval:*reasoning* t)
       (asem-retrieval:*vocab-words* (asem-retrieval:vocab-words-of bpe)))
  (when (probe-file (format nil "~a/" out)) (error "Refusing to overwrite data"))
  (multiple-value-bind (records annotations counts) (asem-inverse-data:prepare n seed bpe)
    (let ((stable (asem-retrieval:train-sequences n '(1 2 3) seed bpe 128 :options t))
          (triples (mapcar (lambda (r) (list (getf r :ids) (getf r :rows) (getf r :targets))) records)))
      (unless (equal stable triples) (error "Annotated data changed stable generation"))
      (ensure-directories-exist (format nil "~a/" out))
      (asem-mission-data:save-data (format nil "~a/data.sexp" out) triples)
      (asem-mission-data:save-data (format nil "~a/annotations.sexp" out) annotations)
      (let* ((table (make-hash-table :test 'equal)) (perms (make-hash-table)) (consumed nil) (mass 0) (eligible 0))
        (dolist (a annotations) (setf (gethash (car a) table) (cdr a)))
        (loop for step from 1 to 300 do
          (dolist (idx (asem-sft32::step-examples step 32 (+ n 3000) seed perms))
            (push idx consumed)
            (when (< idx n) (incf mass (length (third (nth idx triples))))
                  (incf eligible (length (gethash (format nil "r~d" idx) table))))))
        (asem-mission-data:save-data (format nil "~a/consumed-indices.sexp" out) (nreverse consumed))
        (asem-mission-data:write-json (format nil "~a/data-audit.json" out)
          (asem-mission-data:obj "schema" "asem-inverse-data-1" "seed" seed "dense_sequences" n "copy_sequences" 3000 "copy_seed" 77
            "exact_stable_data_match" :true "base_dense_answer_tokens_consumed" mass "auxiliary_pairs_consumed" eligible
            "counts" (cons :obj (sort (loop for k being the hash-keys of counts using (hash-value v) collect (cons k v)) #'string< :key #'car))
            "sha256" (cons :obj (loop for f in '("data.sexp" "annotations.sexp" "consumed-indices.sexp") collect (cons f (asem-sha256:sha256-file-hex (format nil "~a/~a" out f)))))
            "source_sha256" (cons :obj (loop for f in '("lisp/src/mission-data.lisp" "lisp/src/retrieval.lisp" "lisp/src/sft.lisp" "lisp/experimental/inverse-contrastive/data.lisp" "lisp/experimental/inverse-contrastive/objective.lisp" "lisp/bin/inverse-prepare.lisp") collect (cons f (asem-sha256:sha256-file-hex f))))))))
    (format t "Prepared ~d unchanged training sequences; ~d annotated sequences.~%" n (length annotations))))
