{application, tinyllm, [
    {description, "A tiny neural language model, trained by parallel Erlang workers"},
    {vsn, "0.1.0"},
    {registered, [tinyllm_sup, tinyllm_worker_sup]},
    {mod, {tinyllm_app, []}},
    {applications, [kernel, stdlib, cowboy]},
    %% mnesia is started by tinyllm_memory (it must pick its directory first), so it is only included
    {included_applications, [mnesia]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, []}
 ]}.
