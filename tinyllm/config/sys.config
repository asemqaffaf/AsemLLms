[
  {tinyllm, [
    {web, true},
    {port, 8080},
    {model_file, "chat_word.bin"},
    %% web search: wikipedia (default, no setup) | searxng (your own instance; queries Google etc.)
    {search_provider, searxng},
    {searxng_url, "http://127.0.0.1:8888"},
    %% local LM Studio server used by the "Let Qwen answer" option
    {lmstudio_url, "http://127.0.0.1:1234"},
    %% which LM Studio model answers (needs to be a chat model; `curl localhost:1234/v1/models` lists them)
    {lmstudio_model, <<"local/qwen3.5-4b-mlx">>}
  ]}
].
