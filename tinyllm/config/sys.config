[
  {tinyllm, [
    {web, true},
    {port, 8080},
    {model_file, "chat_word.bin"},
    %% conversation memory (Mnesia): chats are saved here and survive restarts
    {memory, true},
    {memory_dir, "data/mnesia"},
    %% web search: wikipedia (default, no setup) | searxng (your own instance; queries Google etc.)
    {search_provider, wikipedia},
    {searxng_url, "http://127.0.0.1:8888"},
    %% local LM Studio server used by the "Let Qwen answer" option
    %% (unset lmstudio_model = first non-embedding model LM Studio reports; to pin one add
    %% {lmstudio_model, <<"...">>}, `curl localhost:1234/v1/models` lists them)
    {lmstudio_url, "http://127.0.0.1:1234"}
  ]}
].
